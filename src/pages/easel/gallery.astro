---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Easel gallery · public boards";
const description =
  "Boards people made with Easel and chose to share. Every preview is the live board, rendered exactly as the agent sees it.";
const canonical = "https://truffleagent.com/easel/gallery/";
---
<BaseLayout title={title} description={description} canonical={canonical}>
  <main class="egal-page">
    <header class="egal-head">
      <p class="egal-eyebrow"><a href="/easel/">Easel</a> · gallery</p>
      <h1 class="egal-display">Public boards</h1>
      <p class="egal-lead">
        Boards people made and chose to share. Every preview is the live
        board itself — the same render the agent sees when it looks.
      </p>
    </header>

    <div class="egal-grid" id="egal-grid"></div>

    <p class="egal-empty" id="egal-empty" hidden>
      No public boards yet. <a href="/easel/">Start one</a> and hit Publish.
    </p>

    <div class="egal-more-wrap">
      <button class="egal-more" id="egal-more" type="button" hidden>Load more</button>
    </div>
  </main>

  <style>
    .egal-page {
      max-width: 1240px;
      margin: 0 auto;
      padding: 4rem 1.5rem 5rem;
    }
    .egal-head {
      max-width: 680px;
      margin-bottom: 2.5rem;
    }
    .egal-eyebrow {
      text-transform: uppercase;
      letter-spacing: 0.14em;
      font-size: 0.78rem;
      opacity: 0.65;
      margin-bottom: 0.9rem;
    }
    .egal-eyebrow a {
      color: inherit;
      text-decoration: none;
      border-bottom: 1px solid var(--border);
    }
    .egal-display {
      font-size: clamp(1.9rem, 4vw, 2.8rem);
      line-height: 1.12;
      margin: 0 0 0.9rem;
    }
    .egal-lead {
      font-size: 1.02rem;
      line-height: 1.6;
      opacity: 0.82;
      margin: 0;
    }
    .egal-empty {
      opacity: 0.7;
      margin-top: 1rem;
    }
    .egal-more-wrap {
      text-align: center;
      margin-top: 2.5rem;
    }
  </style>

  <!-- Cards are JS-created: rules must be global (Astro scoped styles
       only match SSR-rendered nodes). -->
  <style is:global>
    .egal-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 1.25rem;
    }
    .egal-card {
      display: block;
      color: inherit;
      text-decoration: none;
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      /* Surface token, not #fff: in dark mode a white card with the page's
         light text rendered light-on-white and unreadable. */
      background: var(--surface-2);
      transition: border-color 150ms ease, transform 150ms ease;
    }
    .egal-card:hover {
      border-color: var(--content-3);
      transform: translateY(-2px);
    }
    .egal-preview {
      position: relative;
      aspect-ratio: 16 / 10;
      overflow: hidden;
      /* Board renders are always light paper, so the preview frame stays light
         in both themes to match what's inside the iframe. */
      background: #fdfbf7;
      border-bottom: 1px solid var(--border);
    }
    .egal-preview iframe {
      position: absolute;
      top: 0;
      left: 0;
      width: 1400px;
      height: 875px;
      border: 0;
      pointer-events: none;
      transform-origin: top left;
    }
    .egal-meta {
      padding: 0.7rem 0.9rem 0.8rem;
    }
    .egal-title {
      font-size: 0.95rem;
      font-weight: 600;
      margin: 0 0 0.15rem;
      color: var(--content);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .egal-sub {
      font-size: 0.78rem;
      color: var(--content-3);
      margin: 0;
    }
    .egal-more {
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 0.55rem 1.4rem;
      font-size: 0.95rem;
      color: inherit;
      cursor: pointer;
      background: transparent;
    }
    .egal-more:hover { background: var(--surface-3); }

    /* Loading skeletons fill the grid during the initial fetch (which mints a
       render token per board server-side) so the page is never a blank slab.
       The shimmer reuses surface tokens, never a hardcoded colour. */
    .egal-skeleton:hover { transform: none; border-color: var(--border); }
    .egal-skeleton-box {
      background: linear-gradient(
        90deg,
        var(--surface-2) 25%,
        var(--surface-3) 37%,
        var(--surface-2) 63%
      );
      background-size: 200% 100%;
      animation: egal-shimmer 1.4s ease-in-out infinite;
    }
    .egal-skeleton .egal-preview {
      border-bottom-color: var(--border);
    }
    .egal-skel-line {
      height: 0.8rem;
      border-radius: 4px;
      margin-bottom: 0.45rem;
    }
    .egal-skel-line-sm { width: 55%; margin-bottom: 0; }
    @keyframes egal-shimmer {
      0% { background-position: 200% 0; }
      100% { background-position: -200% 0; }
    }
    @media (prefers-reduced-motion: reduce) {
      .egal-skeleton-box { animation: none; }
    }
  </style>

  <script>
    const grid = document.getElementById("egal-grid")!;
    const empty = document.getElementById("egal-empty")!;
    const more = document.getElementById("egal-more") as HTMLButtonElement;
    let nextCursor: string | null = null;

    type GalleryBoard = {
      id: string;
      title: string;
      updated_at: string;
      elements: number;
      render_token: string;
    };

    const scalePreviews = () => {
      grid.querySelectorAll<HTMLIFrameElement>(".egal-preview iframe").forEach((f) => {
        const w = f.parentElement!.clientWidth;
        if (w > 0) f.style.transform = `scale(${w / 1400})`;
      });
    };
    window.addEventListener("resize", scalePreviews);

    // Relative time reads "fresh" better than a bare date on a showcase grid.
    // Falls back to an absolute date past a week (with year if not this year);
    // the exact local timestamp rides along as a hover title.
    const relTime = (iso: string): { label: string; exact: string } => {
      const d = new Date(iso.endsWith("Z") ? iso : iso + "Z");
      const exact = d.toLocaleString(undefined, { dateStyle: "medium", timeStyle: "short" });
      const mins = Math.floor((Date.now() - d.getTime()) / 60000);
      let label: string;
      if (mins < 1) label = "just now";
      else if (mins < 60) label = `${mins}m ago`;
      else if (mins < 1440) label = `${Math.floor(mins / 60)}h ago`;
      else if (mins < 10080) label = `${Math.floor(mins / 1440)}d ago`;
      else
        label = d.toLocaleDateString(undefined, {
          month: "short",
          day: "numeric",
          ...(d.getFullYear() !== new Date().getFullYear() ? { year: "numeric" } : {}),
        });
      return { label, exact };
    };

    const card = (b: GalleryBoard): HTMLElement => {
      const a = document.createElement("a");
      a.className = "egal-card";
      a.href = `/easel/?b=${encodeURIComponent(b.id)}`;

      const prev = document.createElement("div");
      prev.className = "egal-preview";
      const frame = document.createElement("iframe");
      frame.loading = "lazy";
      frame.setAttribute("sandbox", "");
      frame.setAttribute("title", `Preview of ${b.title}`);
      frame.setAttribute("aria-hidden", "true");
      frame.tabIndex = -1;
      frame.src = `/easel/render/${encodeURIComponent(b.id)}?token=${encodeURIComponent(b.render_token)}`;
      prev.appendChild(frame);

      const meta = document.createElement("div");
      meta.className = "egal-meta";
      const t = document.createElement("p");
      t.className = "egal-title";
      t.textContent = b.title || "Untitled board";
      const sub = document.createElement("p");
      sub.className = "egal-sub";
      const { label, exact } = relTime(b.updated_at);
      sub.textContent = `${b.elements} element${b.elements === 1 ? "" : "s"} · ${label}`;
      sub.title = exact;
      meta.append(t, sub);

      a.append(prev, meta);
      return a;
    };

    const skeleton = (): HTMLElement => {
      const d = document.createElement("div");
      d.className = "egal-card egal-skeleton";
      d.setAttribute("aria-hidden", "true");
      const prev = document.createElement("div");
      prev.className = "egal-preview egal-skeleton-box";
      const meta = document.createElement("div");
      meta.className = "egal-meta";
      const l1 = document.createElement("div");
      l1.className = "egal-skel-line egal-skeleton-box";
      const l2 = document.createElement("div");
      l2.className = "egal-skel-line egal-skel-line-sm egal-skeleton-box";
      meta.append(l1, l2);
      d.append(prev, meta);
      return d;
    };
    const clearSkeletons = () =>
      grid.querySelectorAll(".egal-skeleton").forEach((n) => n.remove());

    const load = async () => {
      more.disabled = true;
      // First fetch only: paint shimmer placeholders so the grid is not a blank
      // slab while the server mints a render token per board.
      const initial = nextCursor === null && grid.children.length === 0;
      if (initial) for (let i = 0; i < 6; i++) grid.appendChild(skeleton());
      const qs = nextCursor ? `?cursor=${encodeURIComponent(nextCursor)}` : "";
      try {
        const res = await fetch(`/api/easel/gallery${qs}`);
        const body = await res.json();
        if (!body.ok) throw new Error("gallery fetch failed");
        clearSkeletons();
        for (const b of body.boards as GalleryBoard[]) grid.appendChild(card(b));
        nextCursor = body.next_cursor;
        more.hidden = !nextCursor;
        more.textContent = "Load more";
        empty.hidden = grid.children.length > 0;
        scalePreviews();
      } catch {
        clearSkeletons();
        if (grid.children.length === 0) {
          // Initial load failed with nothing on screen: the empty-state slot
          // doubles as the error message.
          empty.hidden = false;
          empty.textContent = "Could not load the gallery right now. Try a refresh.";
        } else {
          // A "Load more" page failed but earlier cards are still visible — don't
          // claim the whole gallery is gone. Keep the grid and turn the button
          // into a retry (nextCursor is unchanged, so a click re-runs this page).
          more.hidden = false;
          more.textContent = "Couldn't load more — retry";
        }
      } finally {
        more.disabled = false;
      }
    };

    more.addEventListener("click", load);
    load();
  </script>
</BaseLayout>
