---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  MAX_PROMPT_CHARS,
  DAILY_QUOTA_SESSIONS,
  DAILY_QUOTA_GENERATIONS,
  MAX_UPLOAD_BYTES,
} from "../../../functions/_easel-shared.ts";

const title = "Easel · drop images, ask the agent, watch it work the canvas";
const description =
  "Easel is an agent-operated creative canvas. Drop images on an infinite board, type what you want, and watch a real agent see the board, think out loud, arrange your work, and generate what's missing — live.";
const canonical = "https://truffleagent.com/easel/";

const webAppJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Easel",
  alternateName: ["Truffle Easel"],
  url: canonical,
  applicationCategory: "DesignApplication",
  operatingSystem: "Any (Web)",
  browserRequirements: "Requires JavaScript",
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  description,
  featureList: [
    "Infinite pan/zoom canvas with drag-and-drop images",
    "Text, sticky notes, and frames",
    "A real agent that sees the board and operates it live",
    "Agent thinking streamed while it arranges, labels, and aligns",
    "Image generation on Luma uni-1 to fill the gaps",
    "Shareable board links, no account required",
  ],
  author: "Truffle",
};

const maxPrompt = MAX_PROMPT_CHARS;
const quotaSessions = DAILY_QUOTA_SESSIONS;
const quotaGenerations = DAILY_QUOTA_GENERATIONS;
const maxUploadMb = Math.round(MAX_UPLOAD_BYTES / (1024 * 1024));
---
<BaseLayout title={title} description={description} canonical={canonical}>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(webAppJsonLd)}
  />

  <main class="easel-page">
    <!-- Landing hero: hidden once a board is open -->
    <header class="easel-hero" id="easel-hero">
      <p class="easel-eyebrow">New on Truffle</p>
      <h1 class="easel-display">
        Drop your images.<br /><em>The agent works the canvas.</em>
      </h1>
      <p class="easel-lead">
        Easel is a creative workspace run by a real agent. Drop images on an
        infinite board, type what you want — a moodboard, a layout, a story
        wall — and watch the agent see the board, think out loud, arrange
        your work, and generate what's missing. Live, while you watch.
      </p>
      <div class="easel-hero-actions">
        <button class="easel-btn easel-btn-primary" id="new-board-btn" type="button">
          Start a board
        </button>
        <span class="easel-hero-note">
          Free · no account · {quotaSessions} agent runs and {quotaGenerations} generated images per day
        </span>
        <a class="easel-hero-gallery" href="/easel/gallery/">Browse the public gallery →</a>
      </div>
      <p class="easel-hero-error" id="easel-load-error" role="alert" hidden></p>
      <p class="easel-hero-loading" id="easel-load-status" role="status" hidden>Opening your board…</p>
      <div class="easel-recent" id="easel-recent" hidden>
        <h2 class="easel-recent-title">Your recent boards</h2>
        <ul class="easel-recent-list" id="easel-recent-list"></ul>
      </div>
    </header>

    <!-- Workspace: shown when a board is open -->
    <section class="easel-workspace" id="easel-workspace" hidden>
      <div class="easel-topbar">
        <a class="easel-topbar-home" href="/easel/" data-easel-home>Easel</a>
        <input
          class="easel-title-input"
          id="board-title"
          maxlength="120"
          spellcheck="false"
          aria-label="Board title"
        />
        <div class="easel-topbar-tools">
          <button class="easel-tool" id="tool-templates" type="button" title="Start from a template" aria-haspopup="dialog" aria-expanded="false">Templates</button>
          <button class="easel-tool" id="tool-text" type="button" title="Add text (T)">Text</button>
          <button class="easel-tool" id="tool-sticky" type="button" title="Add sticky (S)">Sticky</button>
          <button class="easel-tool" id="tool-frame" type="button" title="Add frame (R)">Frame</button>
          <button class="easel-tool" id="tool-shape" type="button" title="Add shape (H)">Shape</button>
          <button class="easel-tool" id="tool-draw" type="button" title="Draw freehand (P)" aria-pressed="false">Draw</button>
          <button class="easel-tool" id="tool-connect" type="button" title="Connect two elements with an arrow (C)" aria-pressed="false">Connect</button>
          <button class="easel-tool" id="tool-upload" type="button" title="Upload images (U)">Upload</button>
          <button class="easel-tool" id="tool-zoom-fit" type="button" title="Fit board (F)">Fit</button>
          <button class="easel-tool" id="tool-keys" type="button" title="Keyboard shortcuts (?)" aria-haspopup="dialog" aria-expanded="false">?</button>
          <span class="easel-save-state" id="save-state" aria-live="polite">Saved</span>
          <div class="easel-export-wrap">
            <button class="easel-tool" id="tool-export" type="button" title="Download the board (PNG or SVG; selection if 2+ selected)" aria-haspopup="menu" aria-expanded="false">Export</button>
            <div class="easel-export-menu" id="export-menu" role="menu" hidden>
              <button class="easel-export-item" id="export-png" type="button" role="menuitem">
                <span class="easel-export-item-name">PNG image</span>
                <span class="easel-export-item-sub">Raster, paste anywhere</span>
              </button>
              <button class="easel-export-item" id="export-svg" type="button" role="menuitem">
                <span class="easel-export-item-name">SVG vector</span>
                <span class="easel-export-item-sub">Scalable, edit in Figma</span>
              </button>
            </div>
          </div>
          <button class="easel-tool" id="tool-publish" type="button" title="Show this board in the public gallery">Publish</button>
          <button class="easel-tool easel-tool-share" id="tool-share" type="button" title="Copy board link">Share</button>
        </div>
      </div>

      <div class="easel-stage" id="stage">
        <div class="easel-world" id="world"></div>
        <div class="easel-empty-hint" id="empty-hint" hidden>
          <p class="easel-empty-hint-title">Start with anything</p>
          <p class="easel-empty-hint-sub">Double-click to drop a note, drag in an image, or ask the agent below to build the board for you.</p>
          <button class="easel-empty-hint-cta" id="empty-templates" type="button">Start from a template</button>
        </div>
        <div class="easel-coach" id="coach" hidden>
          <div class="easel-coach-head">
            <span class="easel-coach-title">Get started</span>
            <span class="easel-coach-count" id="coach-count">0 / 3</span>
          </div>
          <ul class="easel-coach-steps">
            <li class="easel-coach-step" data-step="sticky">
              <span class="easel-coach-tick" aria-hidden="true"></span>
              <span class="easel-coach-text">Add a sticky note <kbd>S</kbd></span>
            </li>
            <li class="easel-coach-step" data-step="image">
              <span class="easel-coach-tick" aria-hidden="true"></span>
              <span class="easel-coach-text">Drag in an image</span>
            </li>
            <li class="easel-coach-step" data-step="agent">
              <span class="easel-coach-tick" aria-hidden="true"></span>
              <span class="easel-coach-text">Ask the agent to build something</span>
            </li>
          </ul>
          <button class="easel-coach-skip" id="coach-skip" type="button">Skip</button>
        </div>
        <div class="easel-drop-hint" id="drop-hint" hidden>Drop images to add them to the board</div>
        <div class="easel-swatches" id="swatches" role="group" aria-label="Selection style" hidden>
          <button class="easel-shape-kind" id="shape-kind" type="button" title="Switch shape kind" hidden>Ellipse</button>
          <button class="easel-swatch" type="button" data-color="#fff3a3" title="Yellow" aria-label="Yellow" style="background:#fff3a3"></button>
          <button class="easel-swatch" type="button" data-color="#ffd1a3" title="Peach" aria-label="Peach" style="background:#ffd1a3"></button>
          <button class="easel-swatch" type="button" data-color="#ffc9d4" title="Pink" aria-label="Pink" style="background:#ffc9d4"></button>
          <button class="easel-swatch" type="button" data-color="#d4c5ff" title="Purple" aria-label="Purple" style="background:#d4c5ff"></button>
          <button class="easel-swatch" type="button" data-color="#bcdcff" title="Blue" aria-label="Blue" style="background:#bcdcff"></button>
          <button class="easel-swatch" type="button" data-color="#c7f0c2" title="Green" aria-label="Green" style="background:#c7f0c2"></button>
        </div>
        <div class="easel-alignbar" id="alignbar" role="group" aria-label="Align and distribute" hidden>
          <button class="easel-align-btn" type="button" data-align="left" title="Align left edges" aria-label="Align left edges"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M2 2v12M5 5h7M5 11h4" /></svg></button>
          <button class="easel-align-btn" type="button" data-align="hcenter" title="Align horizontal centers" aria-label="Align horizontal centers"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M8 2v12M4 5h8M5 11h6" /></svg></button>
          <button class="easel-align-btn" type="button" data-align="right" title="Align right edges" aria-label="Align right edges"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M14 2v12M4 5h7M7 11h4" /></svg></button>
          <span class="easel-align-sep"></span>
          <button class="easel-align-btn" type="button" data-align="top" title="Align top edges" aria-label="Align top edges"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M2 2h12M5 5v7M11 5v4" /></svg></button>
          <button class="easel-align-btn" type="button" data-align="vmiddle" title="Align vertical centers" aria-label="Align vertical centers"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M2 8h12M5 4v8M11 5v6" /></svg></button>
          <button class="easel-align-btn" type="button" data-align="bottom" title="Align bottom edges" aria-label="Align bottom edges"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M2 14h12M5 4v7M11 7v4" /></svg></button>
          <span class="easel-align-sep"></span>
          <button class="easel-align-btn" type="button" data-dist="h" title="Distribute horizontal spacing" aria-label="Distribute horizontal spacing"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M2 3v10M8 3v10M14 3v10" /></svg></button>
          <button class="easel-align-btn" type="button" data-dist="v" title="Distribute vertical spacing" aria-label="Distribute vertical spacing"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M3 2h10M3 8h10M3 14h10" /></svg></button>
        </div>
        <div class="easel-connbar" id="connbar" role="group" aria-label="Connector style" hidden>
          <button class="easel-conn-style" id="conn-style" type="button" title="Toggle arrowhead">Line</button>
          <span class="easel-align-sep"></span>
          <button class="easel-conn-color" type="button" data-color="#5b6472" title="Gray" aria-label="Gray" style="background:#5b6472"></button>
          <button class="easel-conn-color" type="button" data-color="#1a1a1a" title="Black" aria-label="Black" style="background:#1a1a1a"></button>
          <button class="easel-conn-color" type="button" data-color="#e0564f" title="Red" aria-label="Red" style="background:#e0564f"></button>
          <button class="easel-conn-color" type="button" data-color="#2f6fed" title="Blue" aria-label="Blue" style="background:#2f6fed"></button>
          <button class="easel-conn-color" type="button" data-color="#3fa45b" title="Green" aria-label="Green" style="background:#3fa45b"></button>
          <span class="easel-align-sep"></span>
          <button class="easel-conn-del" id="conn-del" type="button" title="Delete connector" aria-label="Delete connector"><svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M3 4h10M6 4V2.6h4V4M5 4l.6 9h4.8L11 4" /></svg></button>
        </div>
        <button class="easel-zoom-badge" id="zoom-badge" type="button" title="Reset zoom to 100%">100%</button>
        <div class="easel-keys" id="keys-overlay" role="dialog" aria-label="Keyboard shortcuts" hidden>
          <h2 class="easel-keys-title">Keyboard shortcuts</h2>
          <dl class="easel-keys-list">
            <dt><kbd>T</kbd></dt><dd>Add text</dd>
            <dt><kbd>S</kbd></dt><dd>Add sticky</dd>
            <dt><kbd>R</kbd></dt><dd>Add frame</dd>
            <dt><kbd>H</kbd></dt><dd>Add shape (rectangle or ellipse)</dd>
            <dt><kbd>C</kbd></dt><dd>Connect two elements with an arrow</dd>
            <dt><kbd>U</kbd></dt><dd>Upload images</dd>
            <dt><kbd>F</kbd></dt><dd>Fit board to view</dd>
            <dt><kbd>Ctrl</kbd>+<kbd>V</kbd></dt><dd>Paste an image from the clipboard</dd>
            <dt><kbd>Ctrl</kbd>+<kbd>Z</kbd></dt><dd>Undo</dd>
            <dt><kbd>Ctrl</kbd>+<kbd>Shift</kbd>+<kbd>Z</kbd></dt><dd>Redo (or <kbd>Ctrl</kbd>+<kbd>Y</kbd>)</dd>
            <dt><kbd>Ctrl</kbd>+<kbd>S</kbd></dt><dd>Save now</dd>
            <dt><kbd>Ctrl</kbd>+<kbd>D</kbd></dt><dd>Duplicate the selection</dd>
            <dt><kbd>Ctrl</kbd>+<kbd>]</kbd> / <kbd>[</kbd></dt><dd>Bring forward / send backward</dd>
            <dt><kbd>Ctrl</kbd>+<kbd>Shift</kbd>+<kbd>]</kbd> / <kbd>[</kbd></dt><dd>Bring to front / send to back</dd>
            <dt><kbd>Delete</kbd></dt><dd>Delete the selected element</dd>
            <dt>Click an arrow</dt><dd>Select a connector to recolour, flip arrow/line, or <kbd>Delete</kbd></dd>
            <dt>Rotate handle</dt><dd>Drag the knob above a selected element to spin it; hold <kbd>Shift</kbd> to snap to 15&deg;</dd>
            <dt><kbd>P</kbd> · Draw</dt><dd>Freehand pen: left-drag to paint a stroke; <kbd>Space</kbd>+drag still pans. <kbd>Esc</kbd> exits</dd>
            <dt>Arrow keys</dt><dd>Nudge selection 1 unit (<kbd>Shift</kbd> for 10)</dd>
            <dt>Drag empty</dt><dd>Pan the canvas · <kbd>Shift</kbd>+drag to marquee-select</dd>
            <dt><kbd>Shift</kbd> + click</dt><dd>Add or remove an element from the selection</dd>
            <dt><kbd>Ctrl</kbd>/<kbd>Cmd</kbd>+<kbd>A</kbd></dt><dd>Select every element</dd>
            <dt>Drag group corner</dt><dd>Resize a multi-selection as a unit (<kbd>Shift</kbd> keeps aspect)</dd>
            <dt><kbd>Alt</kbd> + drag</dt><dd>Move without snapping</dd>
            <dt>Export</dt><dd>Download the board as PNG or SVG (just the selection if 2+ are selected)</dd>
            <dt>Double-click</dt><dd>Empty canvas: new sticky. On an element: edit text or label</dd>
            <dt>Scroll / drag</dt><dd>Pan the canvas · <kbd>Ctrl</kbd>/<kbd>Cmd</kbd>+scroll or pinch to zoom</dd>
            <dt><kbd>Esc</kbd></dt><dd>Deselect (closes this panel first)</dd>
            <dt><kbd>?</kbd></dt><dd>Toggle this panel</dd>
          </dl>
        </div>
        <div class="easel-templates" id="templates-modal" role="dialog" aria-modal="true" aria-label="Start from a template" hidden>
          <div class="easel-templates-panel">
            <h2 class="easel-templates-title">Start from a template</h2>
            <p class="easel-templates-sub">Drop a ready-made layout onto the board. Edit, move, or delete anything afterwards.</p>
            <div class="easel-templates-grid">
              <button class="easel-template-card" type="button" data-template="brainstorm">
                <svg class="easel-template-art" viewBox="0 0 120 80" aria-hidden="true"><line x1="60" y1="40" x2="28" y2="20"/><line x1="60" y1="40" x2="92" y2="20"/><line x1="60" y1="40" x2="28" y2="60"/><line x1="60" y1="40" x2="92" y2="60"/><rect x="48" y="31" width="24" height="18" rx="3" class="art-fill"/><rect x="16" y="12" width="22" height="14" rx="2"/><rect x="82" y="12" width="22" height="14" rx="2"/><rect x="16" y="54" width="22" height="14" rx="2"/><rect x="82" y="54" width="22" height="14" rx="2"/></svg>
                <span class="easel-template-name">Brainstorm</span>
                <span class="easel-template-desc">A central topic with idea notes wired around it.</span>
              </button>
              <button class="easel-template-card" type="button" data-template="retro">
                <svg class="easel-template-art" viewBox="0 0 120 80" aria-hidden="true"><rect x="8" y="10" width="32" height="60" rx="3"/><rect x="44" y="10" width="32" height="60" rx="3"/><rect x="80" y="10" width="32" height="60" rx="3"/><rect x="13" y="20" width="22" height="12" rx="2" class="art-fill"/><rect x="49" y="20" width="22" height="12" rx="2" class="art-fill"/><rect x="85" y="20" width="22" height="12" rx="2" class="art-fill"/></svg>
                <span class="easel-template-name">Retro</span>
                <span class="easel-template-desc">What went well, what didn't, action items.</span>
              </button>
              <button class="easel-template-card" type="button" data-template="kanban">
                <svg class="easel-template-art" viewBox="0 0 120 80" aria-hidden="true"><rect x="8" y="10" width="32" height="60" rx="3"/><rect x="44" y="10" width="32" height="60" rx="3"/><rect x="80" y="10" width="32" height="60" rx="3"/><rect x="13" y="20" width="22" height="11" rx="2" class="art-fill"/><rect x="13" y="35" width="22" height="11" rx="2" class="art-fill"/><rect x="13" y="50" width="22" height="11" rx="2" class="art-fill"/></svg>
                <span class="easel-template-name">Kanban</span>
                <span class="easel-template-desc">To do, in progress, done — with starter cards.</span>
              </button>
              <button class="easel-template-card" type="button" data-template="moodboard">
                <svg class="easel-template-art" viewBox="0 0 120 80" aria-hidden="true"><rect x="8" y="8" width="104" height="64" rx="3"/><rect x="16" y="18" width="44" height="22" rx="2" class="art-fill"/><rect x="64" y="18" width="40" height="22" rx="2" class="art-fill"/><rect x="16" y="44" width="44" height="22" rx="2" class="art-fill"/><rect x="64" y="44" width="40" height="22" rx="2" class="art-fill"/></svg>
                <span class="easel-template-name">Moodboard</span>
                <span class="easel-template-desc">A framed grid of image slots to fill.</span>
              </button>
            </div>
            <button class="easel-templates-close" id="templates-close" type="button">Cancel</button>
          </div>
        </div>
      </div>

      <!-- Agent dock -->
      <aside class="easel-agent" id="agent-dock">
        <div class="easel-agent-head">
          <span class="easel-agent-dot" id="agent-dot" role="status" title="Agent idle"><span class="easel-sr-only" id="agent-status-text">Agent idle</span></span>
          <span class="easel-agent-name">Agent</span>
          <button class="easel-agent-collapse" id="agent-collapse" type="button" aria-label="Collapse agent panel" aria-expanded="true">–</button>
        </div>
        <div class="easel-agent-feed" id="agent-feed">
          <p class="easel-agent-empty" id="agent-empty">
            Ask for anything: “arrange these into a moodboard with a title,”
            “group by color and label the groups,” “generate two more images
            that match the vibe.” The agent sees the board and works it live.
          </p>
        </div>
        <form class="easel-agent-form" id="agent-form">
          <textarea
            class="easel-agent-input"
            id="agent-input"
            rows="1"
            maxlength={maxPrompt}
            placeholder="Tell the agent what to do with this board… (Enter to send, Shift+Enter for a new line)"
          ></textarea>
          <button class="easel-btn easel-btn-primary easel-agent-send" id="agent-send" type="submit">
            Run
          </button>
        </form>
      </aside>

      <input type="file" id="file-input" accept="image/png,image/jpeg,image/webp,image/gif" multiple hidden />
    </section>
  </main>

  <style>
    .easel-page {
      min-height: 100vh;
    }
    .easel-hero {
      max-width: 760px;
      margin: 0 auto;
      padding: 6rem 1.5rem 4rem;
      text-align: center;
    }
    .easel-eyebrow {
      text-transform: uppercase;
      letter-spacing: 0.14em;
      font-size: 0.78rem;
      opacity: 0.65;
      margin-bottom: 1rem;
    }
    .easel-display {
      font-size: clamp(2.2rem, 5vw, 3.4rem);
      line-height: 1.12;
      margin: 0 0 1.25rem;
    }
    .easel-display em {
      font-style: italic;
    }
    .easel-lead {
      font-size: 1.08rem;
      line-height: 1.65;
      opacity: 0.85;
      margin: 0 auto 2rem;
      max-width: 620px;
    }
    .easel-hero-actions {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
    }
    .easel-hero-note {
      font-size: 0.85rem;
      opacity: 0.6;
    }
    .easel-hero-gallery {
      font-size: 0.9rem;
      opacity: 0.75;
      text-decoration: none;
      border-bottom: 1px solid rgba(0, 0, 0, 0.25);
      padding-bottom: 1px;
    }
    .easel-hero-gallery:hover { opacity: 1; }
    .easel-hero-error {
      margin-top: 1.5rem;
      font-size: 0.9rem;
      color: #c0362c;
      font-weight: 600;
    }
    .easel-hero-loading {
      margin-top: 1.5rem;
      font-size: 0.95rem;
      opacity: 0.7;
    }
    .easel-hero-loading::after {
      content: "";
      display: inline-block;
      width: 0.8em;
      height: 0.8em;
      margin-left: 0.5em;
      vertical-align: -0.05em;
      border: 2px solid currentColor;
      border-right-color: transparent;
      border-radius: 50%;
      animation: easel-hero-spin 0.7s linear infinite;
    }
    @keyframes easel-hero-spin { to { transform: rotate(360deg); } }
    @media (prefers-reduced-motion: reduce) {
      .easel-hero-loading::after { animation: none; }
    }
    /* While a shared ?b= link is loading, suppress the landing affordances so a
       slow fetch can't be mistaken for the landing page (and can't get a stray
       "Start a board" click that would create a duplicate). */
    .easel-hero.is-loading .easel-hero-actions,
    .easel-hero.is-loading .easel-recent { display: none; }
    .easel-recent {
      margin-top: 3.5rem;
      text-align: left;
    }
    .easel-recent-title {
      font-size: 1rem;
      margin-bottom: 0.75rem;
    }
    .easel-recent-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }
  </style>

  <!-- Workspace + canvas element styles. Everything below is applied to
       JS-created DOM nodes, so it must live in a global stylesheet:
       Astro's scoped styles only match SSR-rendered nodes. -->
  <style is:global>
    .easel-btn {
      border: 1px solid rgba(0, 0, 0, 0.25);
      border-radius: 999px;
      padding: 0.55rem 1.4rem;
      font-size: 0.95rem;
      cursor: pointer;
      background: transparent;
    }
    .easel-btn-primary {
      background: #1a1a1a;
      color: #fdfbf7;
      border-color: #1a1a1a;
    }
    .easel-btn-primary:hover { opacity: 0.88; }

    .easel-workspace {
      position: fixed;
      inset: 0;
      z-index: 50;
      display: flex;
      flex-direction: column;
      background: #fdfbf7;
    }
    .easel-topbar {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.5rem 0.9rem;
      border-bottom: 1px solid rgba(0, 0, 0, 0.1);
      background: #fffdf9;
      z-index: 3;
    }
    .easel-topbar-home {
      font-weight: 700;
      text-decoration: none;
      color: inherit;
      font-size: 1rem;
    }
    .easel-title-input {
      border: none;
      background: transparent;
      font-size: 0.95rem;
      font-weight: 500;
      width: 16rem;
      padding: 0.3rem 0.4rem;
      border-radius: 6px;
    }
    .easel-title-input:hover, .easel-title-input:focus {
      background: rgba(0, 0, 0, 0.05);
      outline: none;
    }
    .easel-topbar-tools {
      margin-left: auto;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }
    .easel-tool {
      border: 1px solid rgba(0, 0, 0, 0.16);
      background: transparent;
      border-radius: 8px;
      padding: 0.35rem 0.7rem;
      font-size: 0.82rem;
      cursor: pointer;
    }
    .easel-tool:hover { background: rgba(0, 0, 0, 0.05); }
    .easel-tool.is-public {
      border-color: rgba(26, 26, 26, 0.55);
      background: rgba(26, 26, 26, 0.06);
    }
    /* Connect mode is a sticky tool state (unlike the one-shot add buttons), so
       give the Connect button a pressed look while it is armed. */
    .easel-tool.is-active {
      border-color: rgba(36, 70, 200, 0.6);
      background: rgba(36, 70, 200, 0.1);
      color: #2446c8;
    }
    /* Export PNG/SVG menu. Trigger lives in the topbar (dark-aware chrome), so the
       popover uses --ez-* tokens. position:fixed (coords set in JS from the
       trigger rect) keeps it out of the mobile tools strip's scroll clipping. */
    .easel-export-wrap { display: inline-flex; }
    .easel-export-menu {
      position: fixed;
      z-index: 40;
      min-width: 12.5rem;
      padding: 0.3rem;
      background: var(--ez-panel);
      border: 1px solid var(--ez-border);
      border-radius: 10px;
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.18);
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
    }
    .easel-export-menu[hidden] { display: none; }
    .easel-export-item {
      display: flex;
      flex-direction: column;
      gap: 0.1rem;
      text-align: left;
      border: none;
      background: transparent;
      border-radius: 7px;
      padding: 0.45rem 0.6rem;
      cursor: pointer;
      color: var(--ez-text);
    }
    .easel-export-item:hover { background: var(--ez-hover); }
    .easel-export-item-name { font-size: 0.85rem; font-weight: 600; }
    .easel-export-item-sub { font-size: 0.72rem; color: var(--ez-muted); }
    .easel-save-state {
      font-size: 0.78rem;
      opacity: 0.55;
      min-width: 4.5rem;
      text-align: right;
    }
    /* A failed save is the one state the user must not miss: make it stand out
       instead of reading like the muted "Saved". */
    .easel-save-state.is-error {
      opacity: 1;
      color: #c0362c;
      font-weight: 600;
    }
    /* On a phone the topbar is one non-wrapping flex row, so the tools group
       (Publish/Share live at its right end) overflowed off-screen with no page
       scroll to chase it — unreachable on touch, even though pan/pinch makes
       mobile a real surface. Below 640px the title row wraps above a full-width
       tools strip that scrolls horizontally, keeping every button reachable. */
    @media (max-width: 640px) {
      .easel-topbar { flex-wrap: wrap; row-gap: 0.4rem; }
      .easel-title-input { width: auto; flex: 1 1 8rem; min-width: 0; }
      .easel-topbar-tools {
        margin-left: 0;
        width: 100%;
        flex-wrap: nowrap;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        padding-bottom: 2px;
      }
      .easel-topbar-tools::-webkit-scrollbar { display: none; }
      .easel-tool, .easel-save-state { flex: 0 0 auto; }
    }

    .easel-stage {
      position: relative;
      flex: 1;
      overflow: hidden;
      cursor: default;
      touch-action: none;
      background:
        radial-gradient(circle, rgba(0, 0, 0, 0.07) 1px, transparent 1px) 0 0 / 24px 24px,
        #fdfbf7;
    }
    .easel-stage.is-panning { cursor: grabbing; }
    /* Connect mode: the whole stage takes a crosshair and every element invites
       a click. The armed source element gets a dashed ring so the user knows
       which end the next click will wire to. */
    .easel-stage.is-connecting { cursor: crosshair; }
    .easel-stage.is-connecting .easel-el { cursor: crosshair; }
    /* Draw mode: a crosshair over the whole stage; a left-drag paints a stroke. */
    .easel-stage.is-drawing { cursor: crosshair; }
    .easel-stage.is-drawing .easel-el { cursor: crosshair; }
    .easel-el.is-connect-src {
      outline: 2px dashed #2446c8;
      outline-offset: 3px;
    }
    /* Connector layer: a single SVG that holds every arrow, pinned to the world
       origin so its line coordinates are world units (it pans/zooms with the
       board). It sits behind the elements and never eats pointer events; the
       arrows live in the gaps between boxes, so being underneath is invisible. */
    .easel-connectors {
      position: absolute;
      left: 0;
      top: 0;
      width: 0;
      height: 0;
      overflow: visible;
      pointer-events: none;
      z-index: 0;
    }
    .easel-world {
      position: absolute;
      top: 0;
      left: 0;
      width: 0;
      height: 0;
      transform-origin: 0 0;
    }
    /* Onboarding hint shown only while the board has zero elements. It sits
       above the world but below the drop-hint and overlays, and never eats a
       click (pointer-events: none) so double-click-to-add still works through it. */
    .easel-empty-hint {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.35rem;
      text-align: center;
      padding: 1rem;
      pointer-events: none;
      z-index: 3;
    }
    .easel-empty-hint-title {
      margin: 0;
      font-size: 1.15rem;
      font-weight: 600;
      opacity: 0.55;
    }
    .easel-empty-hint-sub {
      margin: 0;
      max-width: 26rem;
      font-size: 0.9rem;
      line-height: 1.55;
      opacity: 0.45;
    }
    .easel-drop-hint {
      position: absolute;
      inset: 1rem;
      border: 2px dashed rgba(0, 0, 0, 0.3);
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.1rem;
      background: rgba(253, 251, 247, 0.85);
      pointer-events: none;
      z-index: 5;
    }
    /* Sticky color palette: a fixed bar at the top of the stage, shown only
       while a sticky is selected. Fixed position (not anchored to the element)
       avoids pan/zoom math; the stage is always light paper in both themes. */
    .easel-swatches {
      position: absolute;
      top: 0.9rem;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: 0.4rem;
      padding: 0.4rem 0.5rem;
      border: 1px solid rgba(0, 0, 0, 0.12);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.96);
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.14);
      z-index: 6;
    }
    .easel-swatch {
      width: 20px;
      height: 20px;
      padding: 0;
      border-radius: 50%;
      border: 2px solid rgba(0, 0, 0, 0.14);
      cursor: pointer;
    }
    .easel-swatch:hover { transform: scale(1.12); }
    .easel-shape-kind {
      padding: 0 0.55rem;
      height: 22px;
      border-radius: 999px;
      border: 1px solid rgba(0, 0, 0, 0.16);
      background: #fff;
      font-size: 0.78rem;
      font-weight: 600;
      color: #1a1a1a;
      cursor: pointer;
      margin-right: 0.15rem;
    }
    .easel-shape-kind:hover { background: #f1f0ec; }
    .easel-swatch.is-active {
      border-color: rgba(0, 0, 0, 0.55);
      box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.95), 0 0 0 3px rgba(0, 0, 0, 0.4);
    }
    /* Align/distribute bar: the same top-center pill as the swatch bar, shown
       only while two or more elements are selected. The single-select swatch
       bar is hidden in that state, so the two pills never collide. */
    .easel-alignbar {
      position: absolute;
      top: 0.9rem;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      align-items: center;
      gap: 0.1rem;
      padding: 0.3rem 0.4rem;
      border: 1px solid rgba(0, 0, 0, 0.12);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.96);
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.14);
      z-index: 6;
    }
    .easel-align-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      padding: 0;
      border: 0;
      border-radius: 7px;
      background: transparent;
      color: #1a1a1a;
      cursor: pointer;
    }
    .easel-align-btn:hover { background: #f1f0ec; }
    .easel-align-btn:disabled { opacity: 0.32; cursor: default; }
    .easel-align-btn:disabled:hover { background: transparent; }
    .easel-align-btn svg path {
      fill: none;
      stroke: currentColor;
      stroke-width: 1.6;
      stroke-linecap: round;
    }
    .easel-align-sep {
      width: 1px;
      height: 18px;
      background: rgba(0, 0, 0, 0.14);
      margin: 0 0.2rem;
    }
    /* Connector style bar: same top-center pill, shown only while a single
       connector (arrow/line) is selected. A connector selection clears any box
       selection, so this never collides with the swatch or align pills. */
    .easel-connbar {
      position: absolute;
      top: 0.9rem;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.35rem 0.5rem;
      border: 1px solid rgba(0, 0, 0, 0.12);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.96);
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.14);
      z-index: 6;
    }
    .easel-conn-color {
      width: 20px;
      height: 20px;
      padding: 0;
      border-radius: 50%;
      border: 2px solid rgba(0, 0, 0, 0.14);
      cursor: pointer;
    }
    .easel-conn-color:hover { transform: scale(1.12); }
    .easel-conn-color.is-active {
      border-color: rgba(0, 0, 0, 0.55);
      box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.95), 0 0 0 3px rgba(0, 0, 0, 0.4);
    }
    .easel-conn-style {
      padding: 0 0.55rem;
      height: 22px;
      border-radius: 999px;
      border: 1px solid rgba(0, 0, 0, 0.16);
      background: #fff;
      font-size: 0.78rem;
      font-weight: 600;
      color: #1a1a1a;
      cursor: pointer;
    }
    .easel-conn-style:hover { background: #f1f0ec; }
    .easel-conn-del {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 26px;
      height: 26px;
      padding: 0;
      border: 0;
      border-radius: 7px;
      background: transparent;
      color: #b3261e;
      cursor: pointer;
    }
    .easel-conn-del:hover { background: rgba(179, 38, 30, 0.12); }
    .easel-conn-del svg path {
      fill: none;
      stroke: currentColor;
      stroke-width: 1.4;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    /* The wide invisible hit target that makes a thin connector clickable, plus
       the selected-connector highlight (CSS stroke-width + a glow; the line's
       own colour and arrowhead are kept so it stays recognisable while picked). */
    .easel-conn-hit { cursor: pointer; }
    .easel-conn.is-selected {
      stroke-width: 4px;
      filter: drop-shadow(0 0 2.5px rgba(47, 111, 237, 0.95));
    }
    /* Marquee selection rectangle, drawn in stage screen-space while a
       Shift+left-drag sweeps empty canvas. Never eats pointer events. */
    .easel-marquee {
      position: absolute;
      border: 1px solid #2446c8;
      background: rgba(36, 70, 200, 0.08);
      pointer-events: none;
      z-index: 6;
    }
    /* Group bounding box, drawn in #world (so it pans/zooms with the board)
       around a 2+ multi-selection. The box itself passes clicks through; only
       its bottom-right handle is interactive and scales the whole group. */
    .easel-groupbox {
      position: absolute;
      border: 2px dashed #2446c8;
      pointer-events: none;
      z-index: 9999;
    }
    .easel-groupbox-handle {
      position: absolute;
      right: -7px;
      bottom: -7px;
      width: 13px;
      height: 13px;
      border: 2px solid #2446c8;
      border-radius: 3px;
      background: #fff;
      pointer-events: auto;
      cursor: nwse-resize;
    }
    .easel-zoom-badge {
      position: absolute;
      left: 0.9rem;
      bottom: 0.9rem;
      font-size: 0.75rem;
      padding: 0.2rem 0.55rem;
      border-radius: 999px;
      background: rgba(0, 0, 0, 0.07);
      z-index: 4;
      user-select: none;
      border: 0;
      color: inherit;
      font: inherit;
      cursor: pointer;
    }
    .easel-zoom-badge:hover { background: rgba(0, 0, 0, 0.13); }
    /* First-run onboarding coach: a small checklist that floats over the light
       paper stage (just above the zoom badge), teaching the three core moves.
       Each step ticks itself off as the user does it; once all three are done —
       or the user clicks Skip — it dismisses forever. Light card / dark ink so
       it matches the always-light stage in both themes (not the --ez-* chrome). */
    .easel-coach {
      position: absolute;
      left: 0.9rem;
      bottom: 3rem;
      z-index: 8;
      width: 16rem;
      max-width: calc(100% - 1.8rem);
      padding: 0.85rem 0.95rem 0.9rem;
      border-radius: 14px;
      background: rgba(255, 255, 255, 0.97);
      border: 1px solid rgba(0, 0, 0, 0.1);
      box-shadow: 0 10px 28px rgba(0, 0, 0, 0.12);
      color: #1f1d1a;
      font-size: 0.85rem;
      animation: easel-coach-in 0.3s var(--ease-out, ease) both;
    }
    .easel-coach[hidden] { display: none; }
    @keyframes easel-coach-in {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: none; }
    }
    .easel-coach.is-leaving {
      opacity: 0;
      transform: translateY(8px);
      transition: opacity 0.4s ease, transform 0.4s ease;
    }
    .easel-coach-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      margin-bottom: 0.6rem;
    }
    .easel-coach-title { font-weight: 650; font-size: 0.9rem; }
    .easel-coach-count {
      font-size: 0.72rem;
      font-variant-numeric: tabular-nums;
      opacity: 0.55;
    }
    .easel-coach-steps {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }
    .easel-coach-step {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      line-height: 1.3;
    }
    .easel-coach-tick {
      flex: none;
      width: 17px;
      height: 17px;
      border-radius: 999px;
      border: 1.5px solid rgba(0, 0, 0, 0.28);
      position: relative;
      transition: background 0.2s ease, border-color 0.2s ease;
    }
    .easel-coach-step.is-done .easel-coach-tick {
      background: #2f9e44;
      border-color: #2f9e44;
    }
    .easel-coach-step.is-done .easel-coach-tick::after {
      content: "";
      position: absolute;
      left: 5px;
      top: 2px;
      width: 4px;
      height: 8px;
      border: solid #fff;
      border-width: 0 2px 2px 0;
      transform: rotate(45deg);
    }
    .easel-coach-text { flex: 1; }
    .easel-coach-step.is-done .easel-coach-text {
      text-decoration: line-through;
      opacity: 0.5;
    }
    .easel-coach-text kbd {
      font: inherit;
      font-size: 0.72rem;
      padding: 0.02rem 0.32rem;
      border-radius: 5px;
      border: 1px solid rgba(0, 0, 0, 0.18);
      background: rgba(0, 0, 0, 0.04);
    }
    .easel-coach-skip {
      margin-top: 0.7rem;
      font: inherit;
      font-size: 0.78rem;
      color: inherit;
      opacity: 0.6;
      background: none;
      border: 0;
      padding: 0.1rem 0;
      cursor: pointer;
    }
    .easel-coach-skip:hover { opacity: 0.9; text-decoration: underline; }
    @media (max-width: 640px) { .easel-coach { display: none; } }
    .easel-keys {
      position: absolute;
      right: 0.9rem;
      bottom: 0.9rem;
      z-index: 11; /* above the agent panel (10) so the dialog is fully readable */
      width: min(330px, calc(100% - 1.8rem));
      max-height: calc(100% - 1.8rem);
      overflow-y: auto;
      padding: 0.9rem 1rem;
      border: 1px solid rgba(0, 0, 0, 0.12);
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.96);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
    }
    .easel-keys-title {
      margin: 0 0 0.6rem;
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      opacity: 0.7;
    }
    .easel-keys-list {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 0.35rem 0.75rem;
      margin: 0;
      font-size: 0.8rem;
    }
    .easel-keys-list dt { white-space: nowrap; }
    .easel-keys-list dd { margin: 0; opacity: 0.85; }
    .easel-keys kbd {
      display: inline-block;
      padding: 0 0.3rem;
      border: 1px solid rgba(0, 0, 0, 0.2);
      border-bottom-width: 2px;
      border-radius: 4px;
      background: rgba(0, 0, 0, 0.04);
      font-size: 0.72rem;
      font-family: inherit;
    }

    /* ---------- templates picker ---------- */
    .easel-empty-hint-cta {
      margin-top: 0.9rem;
      padding: 0.5rem 1rem;
      border: 1px solid var(--ez-border);
      border-radius: 8px;
      background: var(--ez-panel-2);
      color: var(--ez-text);
      font: inherit;
      font-size: 0.85rem;
      cursor: pointer;
    }
    .easel-empty-hint-cta:hover { background: var(--ez-hover); }
    .easel-templates {
      position: absolute;
      inset: 0;
      z-index: 14; /* above keys overlay (11) and agent panel (10) */
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      background: rgba(0, 0, 0, 0.42);
    }
    .easel-templates[hidden] { display: none; }
    .easel-templates-panel {
      width: min(720px, 100%);
      max-height: 100%;
      overflow-y: auto;
      padding: 1.4rem 1.5rem 1.2rem;
      border: 1px solid var(--ez-border);
      border-radius: 14px;
      background: var(--ez-panel-2);
      color: var(--ez-text);
      box-shadow: 0 18px 50px rgba(0, 0, 0, 0.28);
    }
    .easel-templates-title {
      margin: 0 0 0.25rem;
      font-size: 1.05rem;
      font-weight: 600;
    }
    .easel-templates-sub {
      margin: 0 0 1.1rem;
      font-size: 0.85rem;
      color: var(--ez-muted);
    }
    .easel-templates-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.8rem;
    }
    @media (max-width: 560px) {
      .easel-templates-grid { grid-template-columns: 1fr; }
    }
    .easel-template-card {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.35rem;
      padding: 0.85rem;
      border: 1px solid var(--ez-border);
      border-radius: 10px;
      background: var(--ez-panel);
      color: var(--ez-text);
      text-align: left;
      font: inherit;
      cursor: pointer;
      transition: border-color 0.12s ease, transform 0.12s ease;
    }
    .easel-template-card:hover {
      border-color: var(--ez-text);
      transform: translateY(-1px);
    }
    .easel-template-art {
      width: 100%;
      height: auto;
      aspect-ratio: 120 / 80;
      border-radius: 6px;
      background: var(--ez-hover);
      stroke: var(--ez-muted);
      stroke-width: 2;
      fill: none;
    }
    .easel-template-art rect.art-fill { fill: var(--ez-muted); stroke: none; }
    .easel-template-name { font-size: 0.92rem; font-weight: 600; }
    .easel-template-desc { font-size: 0.78rem; color: var(--ez-muted); line-height: 1.35; }
    .easel-templates-close {
      margin-top: 1.1rem;
      padding: 0.45rem 1rem;
      border: 1px solid var(--ez-border);
      border-radius: 8px;
      background: transparent;
      color: var(--ez-text);
      font: inherit;
      font-size: 0.85rem;
      cursor: pointer;
    }
    .easel-templates-close:hover { background: var(--ez-hover); }

    /* ---------- elements ---------- */
    .easel-el {
      position: absolute;
      box-sizing: border-box;
      user-select: none;
      cursor: grab;
    }
    .easel-el.is-grabbing { cursor: grabbing; }
    .easel-el.is-agent-moving {
      transition: top 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                  left 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                  width 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                  height 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }
    .easel-el.is-selected {
      outline: 2px solid #4658e0;
      outline-offset: 1px;
    }
    .easel-el-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      border-radius: 6px;
      box-shadow: 0 1px 6px rgba(0, 0, 0, 0.14);
      pointer-events: none;
    }
    .easel-el-text {
      font-size: 28px;
      line-height: 1.25;
      padding: 4px 6px;
      white-space: pre-wrap;
      word-break: break-word;
      overflow: hidden;
    }
    .easel-el-sticky {
      background: #fff3a3;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
      padding: 12px;
      font-size: 15px;
      line-height: 1.4;
      white-space: pre-wrap;
      word-break: break-word;
      overflow: hidden;
    }
    .easel-el-sticky.is-suggestion {
      border: 1.5px dashed #5b6bf5;
      padding-top: 26px;
      box-shadow: 0 2px 10px rgba(91, 107, 245, 0.22);
    }
    .easel-suggest-badge {
      position: absolute;
      top: 6px;
      left: 8px;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: #fff;
      background: #5b6bf5;
      padding: 2px 7px;
      border-radius: 999px;
      pointer-events: none;
    }
    .easel-suggest-dismiss {
      position: absolute;
      top: 4px;
      right: 4px;
      width: 20px;
      height: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 0;
      border-radius: 50%;
      padding: 0;
      background: rgba(91, 107, 245, 0.14);
      color: #3a3a8c;
      font-size: 15px;
      line-height: 1;
      cursor: pointer;
    }
    .easel-suggest-dismiss:hover {
      background: rgba(91, 107, 245, 0.28);
    }
    .easel-el-frame {
      border: 1.5px solid rgba(0, 0, 0, 0.35);
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.35);
    }
    .easel-el-frame .easel-frame-label {
      position: absolute;
      top: -1.6em;
      left: 0;
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      opacity: 0.7;
      white-space: nowrap;
    }
    .easel-el-shape {
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 10px;
      font-size: 15px;
      line-height: 1.35;
      font-weight: 600;
      color: #1a1a1a;
      white-space: pre-wrap;
      word-break: break-word;
      overflow: hidden;
    }
    /* Freehand stroke: a transparent box whose SVG path fills it. The svg has
       pointer-events:none so the box itself catches drags (move/select), and
       overflow:visible lets a round line-cap sit flush at the padded edge. */
    .easel-el-draw { background: transparent; overflow: visible; }
    .easel-el-draw .easel-draw-svg {
      width: 100%;
      height: 100%;
      display: block;
      overflow: visible;
      pointer-events: none;
    }
    .easel-el[data-editing="1"] {
      user-select: text;
      cursor: text;
    }
    .easel-resize-handle {
      position: absolute;
      right: -7px;
      bottom: -7px;
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: #4658e0;
      border: 2px solid #fdfbf7;
      cursor: nwse-resize;
      display: none;
    }
    .easel-el.is-selected .easel-resize-handle { display: block; }
    /* Rotation grip lives in #world (not on the node) so an element's own
       overflow:hidden never clips it. A zero-size host anchored at the
       element centre carries the box's rotation; the knob hangs above. */
    .easel-rotate-host {
      position: absolute;
      width: 0;
      height: 0;
      transform-origin: 0 0;
      pointer-events: none;
      z-index: 9999;
    }
    .easel-rotate-knob {
      position: absolute;
      left: -7px;
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: #4658e0;
      border: 2px solid #fdfbf7;
      pointer-events: auto;
      cursor: grab;
    }
    /* Stem joining the knob down toward the top edge of the box. */
    .easel-rotate-knob::before {
      content: "";
      position: absolute;
      left: 50%;
      top: 14px;
      width: 1.5px;
      height: 14px;
      margin-left: -0.75px;
      background: #4658e0;
    }
    .easel-rotate-knob:active { cursor: grabbing; }
    .easel-guide {
      position: absolute;
      background: #e0457b;
      pointer-events: none;
      z-index: 100000;
    }
    .easel-el-ghost {
      opacity: 0.55;
      filter: saturate(0.4);
    }
    .easel-el-ghost::after {
      content: "generating…";
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      background: rgba(253, 251, 247, 0.6);
      border-radius: 6px;
    }
    /* Graceful fallback when an image's source fails to load: hide the broken
       glyph and show a paper-tone placeholder, matching the ghost overlay idiom. */
    .easel-el-image.is-broken img { opacity: 0; }
    .easel-el-image.is-broken {
      border-radius: 6px;
      border: 1.5px dashed rgba(0, 0, 0, 0.22);
      background: rgba(253, 251, 247, 0.85);
    }
    .easel-el-image.is-broken::after {
      content: "image unavailable";
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      color: rgba(0, 0, 0, 0.45);
      border-radius: 6px;
    }

    /* ---------- agent dock ---------- */
    .easel-agent {
      position: absolute;
      right: 1rem;
      bottom: 1rem;
      width: min(380px, calc(100vw - 2rem));
      max-height: min(520px, 70vh);
      display: flex;
      flex-direction: column;
      background: #ffffff;
      border: 1px solid rgba(0, 0, 0, 0.12);
      border-radius: 14px;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
      z-index: 10;
      overflow: hidden;
    }
    .easel-agent.is-collapsed .easel-agent-feed,
    .easel-agent.is-collapsed .easel-agent-form { display: none; }
    .easel-agent-head {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.6rem 0.85rem;
      border-bottom: 1px solid rgba(0, 0, 0, 0.08);
      font-size: 0.88rem;
      font-weight: 600;
    }
    .easel-agent.is-collapsed .easel-agent-head { border-bottom: none; }
    .easel-agent-dot {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: #9aa0a6;
      flex: none;
    }
    /* Visually-hidden status text inside the dot. role="status" on the dot makes
       it a live region; toggling this text announces "Agent working"/"Agent idle"
       to assistive tech without disturbing the 9px visual. */
    .easel-sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
      border: 0;
    }
    .easel-agent-dot.is-live {
      background: #2fb344;
      animation: easel-pulse 1.4s ease-in-out infinite;
    }
    @keyframes easel-pulse {
      0%, 100% { box-shadow: 0 0 0 0 rgba(47, 179, 68, 0.45); }
      50% { box-shadow: 0 0 0 6px rgba(47, 179, 68, 0); }
    }
    .easel-agent-collapse {
      margin-left: auto;
      border: none;
      background: transparent;
      cursor: pointer;
      font-size: 1rem;
      line-height: 1;
      padding: 0.1rem 0.4rem;
    }
    .easel-agent-feed {
      flex: 1;
      overflow-y: auto;
      padding: 0.75rem 0.85rem;
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
      min-height: 120px;
    }
    .easel-agent-empty {
      font-size: 0.84rem;
      line-height: 1.55;
      opacity: 0.6;
      margin: 0;
    }
    .easel-feed-item {
      font-size: 0.84rem;
      line-height: 1.5;
      border-radius: 10px;
      padding: 0.5rem 0.65rem;
    }
    .easel-feed-user {
      background: #1a1a1a;
      color: #fdfbf7;
      align-self: flex-end;
      max-width: 90%;
    }
    .easel-feed-thought {
      background: rgba(0, 0, 0, 0.045);
      white-space: pre-wrap;
    }
    .easel-feed-tool {
      font-family: ui-monospace, "JetBrains Mono", monospace;
      font-size: 0.74rem;
      background: rgba(70, 88, 224, 0.07);
      border: 1px solid rgba(70, 88, 224, 0.18);
      color: #2c3aa8;
    }
    .easel-feed-error {
      background: rgba(200, 40, 40, 0.08);
      border: 1px solid rgba(200, 40, 40, 0.25);
      color: #8c1f1f;
    }
    .easel-feed-done {
      background: rgba(47, 179, 68, 0.09);
      border: 1px solid rgba(47, 179, 68, 0.25);
    }
    .easel-agent-form {
      display: flex;
      gap: 0.5rem;
      padding: 0.6rem 0.85rem;
      border-top: 1px solid rgba(0, 0, 0, 0.08);
    }
    .easel-agent-input {
      flex: 1;
      resize: none;
      border: 1px solid rgba(0, 0, 0, 0.15);
      border-radius: 10px;
      padding: 0.5rem 0.6rem;
      font-size: 0.86rem;
      font-family: inherit;
      /* border-box so the JS height (= scrollHeight) and min/max-height all
         measure the same box; auto-grows with content up to the cap, then
         scrolls; min-height holds the resting ~2-row size when empty. */
      box-sizing: border-box;
      min-height: 3.9rem;
      max-height: 140px;
      overflow-y: auto;
    }
    .easel-agent-input:focus { outline: 2px solid rgba(70, 88, 224, 0.4); }
    .easel-agent-send { padding: 0.45rem 1rem; align-self: flex-end; }
    .easel-agent-send:disabled { opacity: 0.5; cursor: not-allowed; }

    .easel-recent-list a {
      display: block;
      padding: 0.5rem 0.75rem;
      border: 1px solid rgba(0, 0, 0, 0.1);
      border-radius: 10px;
      text-decoration: none;
      color: inherit;
      font-size: 0.9rem;
    }
    .easel-recent-list a:hover { background: rgba(0, 0, 0, 0.04); }

    /* ---------- theming: dark-aware chrome, light paper canvas ----------
       The paper stage + paper-note elements stay light in BOTH themes (they are
       physical paper); pin their ink dark so they never inherit the dark-theme
       near-white text color. The app chrome follows the site theme via --ez-*. */

    /* Paper world: light surface, dark ink, in every theme. */
    .easel-stage { color: #1f1d1a; }

    /* Chrome tokens — light defaults match the prior hardcoded values. */
    .easel-page,
    .easel-workspace {
      --ez-surface: #fdfbf7;
      --ez-panel:   #fffdf9;
      --ez-panel-2: #ffffff;
      --ez-text:    #1f1d1a;
      --ez-muted:   rgba(0, 0, 0, 0.55);
      --ez-border:  rgba(0, 0, 0, 0.12);
      --ez-hover:   rgba(0, 0, 0, 0.05);
    }
    .easel-workspace { background: var(--ez-surface); color: var(--ez-text); }
    .easel-topbar { background: var(--ez-panel); border-bottom-color: var(--ez-border); color: var(--ez-text); }
    .easel-tool { border-color: var(--ez-border); color: var(--ez-text); }
    .easel-tool:hover { background: var(--ez-hover); }
    .easel-title-input { color: var(--ez-text); }
    .easel-title-input:hover, .easel-title-input:focus { background: var(--ez-hover); }
    .easel-agent { background: var(--ez-panel-2); border-color: var(--ez-border); color: var(--ez-text); }
    .easel-agent-head { border-bottom-color: var(--ez-border); }
    .easel-agent-form { border-top-color: var(--ez-border); }
    .easel-agent-input { background: var(--ez-panel-2); color: var(--ez-text); border-color: var(--ez-border); }
    .easel-feed-thought { background: var(--ez-hover); }
    .easel-recent-list a { border-color: var(--ez-border); color: var(--ez-text); }
    .easel-recent-list a:hover { background: var(--ez-hover); }
    .easel-btn { border-color: var(--ez-border); color: var(--ez-text); }

    /* Dark theme: explicit toggle + system preference (unless forced light).
       Values mirror the site's dark family from global.css. */
    [data-theme="dark"] .easel-page,
    [data-theme="dark"] .easel-workspace {
      --ez-surface: #0e0c08;
      --ez-panel:   #181510;
      --ez-panel-2: #221e16;
      --ez-text:    #f5efde;
      --ez-muted:   #a89e83;
      --ez-border:  #2e2920;
      --ez-hover:   rgba(245, 239, 222, 0.07);
    }
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) .easel-page,
      :root:not([data-theme="light"]) .easel-workspace {
        --ez-surface: #0e0c08;
        --ez-panel:   #181510;
        --ez-panel-2: #221e16;
        --ez-text:    #f5efde;
        --ez-muted:   #a89e83;
        --ez-border:  #2e2920;
        --ez-hover:   rgba(245, 239, 222, 0.07);
      }
    }

    /* Agent feed status chips: the light-tuned saturated text goes low-contrast
       on the dark panel, so lift text + tint in dark mode. Primary buttons use
       the site accent so they pop on the dark surface. User bubble gets a border
       so it separates from the dark panel. */
    [data-theme="dark"] .easel-feed-tool,
    :root:not([data-theme="light"]) .easel-feed-tool {
      background: rgba(129, 139, 219, 0.16);
      border-color: rgba(129, 139, 219, 0.34);
      color: #c2c8f2;
    }
    [data-theme="dark"] .easel-feed-error,
    :root:not([data-theme="light"]) .easel-feed-error {
      background: rgba(224, 90, 90, 0.16);
      border-color: rgba(224, 90, 90, 0.36);
      color: #f1b0b0;
    }
    [data-theme="dark"] .easel-feed-done,
    :root:not([data-theme="light"]) .easel-feed-done {
      background: rgba(47, 179, 68, 0.16);
      border-color: rgba(47, 179, 68, 0.34);
    }
    [data-theme="dark"] .easel-feed-user,
    :root:not([data-theme="light"]) .easel-feed-user {
      background: #2a2a38;
      color: #f5efde;
    }
    [data-theme="dark"] .easel-btn-primary,
    :root:not([data-theme="light"]) .easel-btn-primary {
      background: var(--accent); color: #14110c; border-color: var(--accent);
    }
    [data-theme="dark"] .easel-tool.is-active,
    :root:not([data-theme="light"]) .easel-tool.is-active {
      border-color: rgba(129, 139, 219, 0.7);
      background: rgba(129, 139, 219, 0.16);
      color: #c2c8f2;
    }
  </style>

  <script>
    // Easel canvas client. Board doc is the source of truth; this client
    // renders it, edits it optimistically, and reconciles with the server
    // via a version counter. During agent sessions it polls at 1Hz and
    // animates agent mutations.

    type El = {
      id: string;
      type: "image" | "text" | "sticky" | "frame" | "shape" | "draw" | "connector";
      x: number; y: number; w: number; h: number; z: number;
      rotation?: number;
      props: Record<string, any>;
    };
    type Doc = { elements: El[]; background: string };

    const $ = <T extends HTMLElement = HTMLElement>(id: string) =>
      document.getElementById(id) as T;

    const hero = $("easel-hero");
    const workspace = $("easel-workspace");
    const stage = $("stage");
    const world = $("world");
    const emptyHint = $("empty-hint");
    const swatches = $("swatches");
    const shapeKind = $<HTMLButtonElement>("shape-kind");
    const alignbar = $("alignbar");
    const connbar = $("connbar");
    const connStyleBtn = $<HTMLButtonElement>("conn-style");
    const dropHint = $("drop-hint");
    const templatesModal = $("templates-modal");
    const keysOverlay = $("keys-overlay");
    // The shortcuts trigger declares aria-haspopup="dialog"; keep its
    // aria-expanded in lockstep with the overlay so assistive tech announces
    // whether the panel is open. Single chokepoint so the four toggle sites
    // (button click, ? key, Esc, in-overlay ?/Esc) can't drift out of sync.
    const setKeysOverlay = (open: boolean) => {
      keysOverlay.hidden = !open;
      $("tool-keys").setAttribute("aria-expanded", String(open));
    };
    // ---------- first-run onboarding coach ----------
    // A 3-step checklist that floats over the stage on a visitor's first board,
    // ticking each step off as they do it: add a sticky, drag in an image, ask
    // the agent. Completing all three — or clicking Skip — dismisses it forever
    // via localStorage so it never nags a returning user.
    const coach = $("coach");
    const COACH_KEY = "easel.coach.v1";
    const coachDone = new Set<string>();
    let coachActive = false;
    const dismissCoach = () => {
      if (!coachActive) return;
      coachActive = false;
      try { localStorage.setItem(COACH_KEY, "done"); } catch {}
      coach.classList.add("is-leaving");
      window.setTimeout(() => { coach.hidden = true; coach.classList.remove("is-leaving"); }, 420);
    };
    const coachMark = (step: string) => {
      if (!coachActive || coachDone.has(step)) return;
      coachDone.add(step);
      coach.querySelector(`[data-step="${step}"]`)?.classList.add("is-done");
      const count = $("coach-count");
      if (coachDone.size >= 3) {
        count.textContent = "All set";
        window.setTimeout(dismissCoach, 1100);
      } else {
        count.textContent = `${coachDone.size} / 3`;
      }
    };
    // Surfaced once a board is open (workspace visible), gated on the flag.
    const initCoach = () => {
      let seen = "done";
      try { seen = localStorage.getItem(COACH_KEY) ?? ""; } catch {}
      if (seen === "done") return;
      coachActive = true;
      coach.hidden = false;
    };
    $("coach-skip").addEventListener("click", dismissCoach);
    const zoomBadge = $("zoom-badge");
    const saveState = $("save-state");
    const titleInput = $<HTMLInputElement>("board-title");
    const fileInput = $<HTMLInputElement>("file-input");
    const agentFeed = $("agent-feed");
    const agentEmpty = $("agent-empty");
    const agentForm = $<HTMLFormElement>("agent-form");
    const agentInput = $<HTMLTextAreaElement>("agent-input");
    const agentSend = $<HTMLButtonElement>("agent-send");
    const agentDot = $("agent-dot");
    const agentStatusText = $("agent-status-text");
    // Single chokepoint for the agent activity dot: toggles the pulse and updates
    // the announced status text + hover tooltip so the state is legible to both
    // sighted and assistive-tech users.
    const setAgentLive = (live: boolean) => {
      agentDot.classList.toggle("is-live", live);
      const label = live ? "Agent working" : "Agent idle";
      agentStatusText.textContent = label;
      agentDot.title = label;
    };

    let boardId: string | null = null;
    let doc: Doc = { elements: [], background: "white" };
    let version = 0;
    // Last non-empty title the server accepted. The board PUT keeps the stored
    // title when an empty one is sent (COALESCE), so blanking the input must not
    // be treated as a real rename client-side — we restore from this on blur.
    let currentTitle = "";
    let isPublic = false;
    // Selection is a set. selectedId mirrors it only when exactly one element
    // is selected, so every single-element affordance (style bar, duplicate,
    // resize handle) lights up for a lone selection and stays dark for a group.
    const selectedIds = new Set<string>();
    let selectedId: string | null = null;
    // True while the space bar is held — turns a left-drag on empty canvas into
    // a pan instead of a marquee (Figma/FigJam convention).
    let spaceHeld = false;
    // Connect mode: while armed, clicking elements wires an arrow between them.
    // connectFrom holds the first-picked element id until the second click.
    let connectMode = false;
    let drawMode = false;
    // Last-used freehand stroke style, so consecutive strokes stay consistent.
    let lastDrawColor = "#1f1d1a";
    let lastDrawWidth = 3;
    // A freehand stroke is "M x y L x y …" in the element's local box space.
    const drawPath = (pts: number[][]) =>
      pts.length ? "M" + pts.map((p) => `${p[0]} ${p[1]}`).join(" L") : "";
    let connectFrom: string | null = null;
    let nextElNum = 1;
    let saveTimer: number | null = null;
    let saving = false;
    let dirty = false;
    let saveFailed = false;
    let agentRunning = false;
    let pollTimer: number | null = null;
    // True only while a save has failed and edits are sitting unsent ("Offline").
    // Used by the beforeunload guard so a transient in-flight save never warns.
    let unsynced = false;
    // Undo: one snapshot per local gesture (drag, resize, add, delete, edit).
    // undoBase holds the serialized elements at the last checkpoint; the
    // stack holds prior states. Cleared whenever the server doc replaces
    // ours (agent runs, other tabs) — undo never crosses a remote update.
    let undoStack: string[] = [];
    let redoStack: string[] = [];
    let undoBase = "[]";

    // ---------- viewport ----------
    let panX = 0, panY = 0, zoom = 1;
    const applyView = () => {
      world.style.transform = `translate(${panX}px, ${panY}px) scale(${zoom})`;
      zoomBadge.textContent = `${Math.round(zoom * 100)}%`;
      saveViewport();
    };
    // Persist pan/zoom per board so reopening keeps your place instead of
    // snapping back to a fit-all view. Debounced and id/value-snapshotted so
    // a board switch mid-gesture can't write the wrong board's viewport.
    const VIEW_KEY = (id: string) => `easel.view.${id}`;
    let viewSaveTimer = 0;
    const saveViewport = () => {
      if (!boardId) return;
      const id = boardId, px = panX, py = panY, z = zoom;
      window.clearTimeout(viewSaveTimer);
      viewSaveTimer = window.setTimeout(() => {
        try {
          localStorage.setItem(VIEW_KEY(id), JSON.stringify({ panX: px, panY: py, zoom: z }));
        } catch { /* private mode / quota — non-fatal */ }
      }, 400);
    };
    const loadViewport = (id: string) => {
      try {
        const v = JSON.parse(localStorage.getItem(VIEW_KEY(id)) || "null");
        if (v && Number.isFinite(v.panX) && Number.isFinite(v.panY) &&
          Number.isFinite(v.zoom) && v.zoom > 0) {
          return v as { panX: number; panY: number; zoom: number };
        }
      } catch { /* ignore */ }
      return null;
    };
    const stagePoint = (clientX: number, clientY: number) => {
      const r = stage.getBoundingClientRect();
      return { x: (clientX - r.left - panX) / zoom, y: (clientY - r.top - panY) / zoom };
    };

    // ---------- recent boards (localStorage) ----------
    const RECENT_KEY = "easel.recent.v1";
    const loadRecent = (): { id: string; title: string }[] => {
      try { return JSON.parse(localStorage.getItem(RECENT_KEY) || "[]"); } catch { return []; }
    };
    const rememberBoard = (id: string, title: string) => {
      const list = loadRecent().filter((b) => b.id !== id);
      list.unshift({ id, title });
      localStorage.setItem(RECENT_KEY, JSON.stringify(list.slice(0, 12)));
    };
    // Reflect the open board's name in the browser tab + bookmark title so
    // multiple board tabs are distinguishable. Falls back to the static page
    // title (captured before any board opens) on the landing view.
    const BASE_DOC_TITLE = document.title;
    const setDocTitle = (name: string) => {
      const t = (name || "").trim();
      document.title = t ? `${t} · Easel` : BASE_DOC_TITLE;
    };
    const renderRecent = () => {
      const list = loadRecent();
      if (!list.length) return;
      $("easel-recent").hidden = false;
      const ul = $("easel-recent-list");
      ul.innerHTML = "";
      for (const b of list) {
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = `/easel/?b=${encodeURIComponent(b.id)}`;
        a.textContent = b.title || b.id;
        li.appendChild(a);
        ul.appendChild(li);
      }
    };

    // ---------- API ----------
    const api = async (path: string, init?: RequestInit) => {
      const res = await fetch(path, init);
      const body = await res.json().catch(() => ({}));
      if (!res.ok || body.ok === false) {
        const msg = body?.error?.message || `${res.status}`;
        throw Object.assign(new Error(msg), { status: res.status, code: body?.error?.code });
      }
      return body;
    };

    // ---------- rendering ----------
    const elNode = (el: El): HTMLElement => {
      let node = world.querySelector<HTMLElement>(`[data-el-id="${el.id}"]`);
      if (!node) {
        node = document.createElement("div");
        node.dataset.elId = el.id;
        node.className = `easel-el easel-el-${el.type}`;
        if (el.type === "image") {
          const img = document.createElement("img");
          img.draggable = false;
          // A failed R2 fetch (deleted object, network blip) shows a tasteful
          // paper placeholder instead of the browser's broken-image glyph; the
          // flag clears if a later src change loads successfully.
          img.addEventListener("error", () => node!.classList.add("is-broken"));
          img.addEventListener("load", () => node!.classList.remove("is-broken"));
          node.appendChild(img);
        } else if (el.type === "frame") {
          const label = document.createElement("span");
          label.className = "easel-frame-label";
          node.appendChild(label);
        } else if (el.type === "draw") {
          // Inline SVG path. The viewBox is the stroke's drawn box and the svg
          // fills the node 100% with preserveAspectRatio=none, so resizing the
          // node stretches the stroke. pointer-events stay on the box, not the
          // path, so the whole bounding box is grabbable like any other element.
          const svg = document.createElementNS(SVG_NS, "svg");
          svg.setAttribute("class", "easel-draw-svg");
          svg.setAttribute("preserveAspectRatio", "none");
          const path = document.createElementNS(SVG_NS, "path");
          path.setAttribute("fill", "none");
          path.setAttribute("stroke-linecap", "round");
          path.setAttribute("stroke-linejoin", "round");
          svg.appendChild(path);
          node.appendChild(svg);
        }
        const handle = document.createElement("div");
        handle.className = "easel-resize-handle";
        node.appendChild(handle);
        world.appendChild(node);
        wireElement(node);
      }
      return node;
    };

    // A suggestion is an ordinary sticky carrying props.suggestion. It reads as an
    // agent-left advisory (dashed indigo frame + "Suggestion" badge) and a human
    // dismisses it with the corner ×. Kept as a sticky variant, not a new element
    // type, so it inherits every box gesture and needs no new validation or
    // render-route type — only chrome layered on top.
    const dismissSuggestion = (id: string) => {
      doc.elements = doc.elements.filter((e) =>
        e.id !== id &&
        !(e.type === "connector" && (e.props.from === id || e.props.to === id)));
      if (selectedIds.has(id)) selectEl(null);
      renderDoc();
      scheduleSave();
    };
    const applySuggestionChrome = (node: HTMLElement, el: El, on: boolean) => {
      node.classList.toggle("is-suggestion", on);
      let badge = node.querySelector<HTMLElement>(".easel-suggest-badge");
      let xBtn = node.querySelector<HTMLElement>(".easel-suggest-dismiss");
      if (on) {
        if (!badge) {
          badge = document.createElement("span");
          badge.className = "easel-suggest-badge";
          badge.textContent = "Suggestion";
          node.appendChild(badge);
        }
        if (!xBtn) {
          xBtn = document.createElement("button");
          xBtn.className = "easel-suggest-dismiss";
          (xBtn as HTMLButtonElement).type = "button";
          xBtn.title = "Dismiss suggestion";
          xBtn.setAttribute("aria-label", "Dismiss suggestion");
          xBtn.textContent = "\u00d7";
          // Keep the × out of the box's drag/select gesture machinery.
          xBtn.addEventListener("pointerdown", (ev) => ev.stopPropagation());
          xBtn.addEventListener("click", (ev) => { ev.stopPropagation(); dismissSuggestion(el.id); });
          node.appendChild(xBtn);
        }
      } else {
        badge?.remove();
        xBtn?.remove();
      }
    };

    const renderEl = (el: El, animate = false) => {
      // Connectors are not box nodes; they live in the SVG layer. Any call that
      // lands here (e.g. a move that touches a connector) just redraws the layer.
      if (el.type === "connector") { drawConnectors(); return; }
      const node = elNode(el);
      if (animate) {
        node.classList.add("is-agent-moving");
        window.setTimeout(() => node.classList.remove("is-agent-moving"), 600);
      }
      node.style.left = `${el.x}px`;
      node.style.top = `${el.y}px`;
      node.style.width = `${el.w}px`;
      node.style.height = `${el.h}px`;
      node.style.zIndex = String(el.z);
      node.style.transform = el.rotation ? `rotate(${el.rotation}deg)` : "";
      if (el.type === "image") {
        const img = node.querySelector("img")!;
        const src = String(el.props.src || "");
        if (img.getAttribute("src") !== src && src) img.src = src;
        node.classList.toggle("easel-el-ghost", !!el.props.ghost);
      } else if (el.type === "text") {
        node.childNodes[0]?.nodeType === Node.TEXT_NODE
          ? (node.childNodes[0].textContent = String(el.props.text ?? ""))
          : node.insertBefore(document.createTextNode(String(el.props.text ?? "")), node.firstChild);
        node.style.fontSize = `${Number(el.props.size) || 28}px`;
        node.style.fontWeight = String(el.props.weight || 600);
        node.style.color = String(el.props.color || "#1a1a1a");
        node.style.textAlign = String(el.props.align || "left");
      } else if (el.type === "sticky") {
        node.childNodes[0]?.nodeType === Node.TEXT_NODE
          ? (node.childNodes[0].textContent = String(el.props.text ?? ""))
          : node.insertBefore(document.createTextNode(String(el.props.text ?? "")), node.firstChild);
        const isSuggestion = !!el.props.suggestion;
        node.style.background = String(el.props.color || (isSuggestion ? "#eef1ff" : "#fff3a3"));
        applySuggestionChrome(node, el, isSuggestion);
      } else if (el.type === "frame") {
        const label = node.querySelector<HTMLElement>(".easel-frame-label")!;
        label.textContent = String(el.props.label ?? "");
      } else if (el.type === "shape") {
        // Optional centered text, same text-node handling as sticky/text.
        node.childNodes[0]?.nodeType === Node.TEXT_NODE
          ? (node.childNodes[0].textContent = String(el.props.text ?? ""))
          : node.insertBefore(document.createTextNode(String(el.props.text ?? "")), node.firstChild);
        node.style.background = String(el.props.fill || "#bcdcff");
        node.style.border = `2px solid ${String(el.props.stroke || "#3a4a8c")}`;
        node.style.borderRadius = el.props.kind === "ellipse" ? "50%" : "10px";
      } else if (el.type === "draw") {
        const svg = node.querySelector("svg")!;
        const pts = Array.isArray(el.props.points) ? (el.props.points as number[][]) : [];
        // vbW/vbH default to the element box, so an agent can supply points in
        // 0..w / 0..h space and omit the viewBox dims entirely.
        const vbW = Number(el.props.vbW) || el.w || 1;
        const vbH = Number(el.props.vbH) || el.h || 1;
        svg.setAttribute("viewBox", `0 0 ${vbW} ${vbH}`);
        const path = svg.querySelector("path")!;
        path.setAttribute("d", drawPath(pts));
        path.setAttribute("stroke", String(el.props.stroke || "#1f1d1a"));
        path.setAttribute("stroke-width", String(Number(el.props.width) || 3));
      }
      node.classList.toggle("is-selected", selectedIds.has(el.id));
    };

    // ---------- connectors ----------
    // A single SVG layer inside #world holds every connector arrow. Because
    // #world is the transformed coordinate space the elements live in, the line
    // coordinates are plain world units and pan/zoom for free. Lazily created.
    const SVG_NS = "http://www.w3.org/2000/svg";
    let connectorLayer: SVGSVGElement | null = null;
    // Connectors live in the SVG layer with no box node, so a picked connector
    // gets its own single-selection slot, separate from the box `selectedIds`.
    let selectedConnectorId: string | null = null;
    const ensureConnectorLayer = (): SVGSVGElement => {
      if (connectorLayer && connectorLayer.isConnected) return connectorLayer;
      const svg = document.createElementNS(SVG_NS, "svg");
      svg.setAttribute("class", "easel-connectors");
      const defs = document.createElementNS(SVG_NS, "defs");
      const marker = document.createElementNS(SVG_NS, "marker");
      marker.setAttribute("id", "easel-arrow");
      marker.setAttribute("markerWidth", "9");
      marker.setAttribute("markerHeight", "9");
      marker.setAttribute("refX", "7.5");
      marker.setAttribute("refY", "4.5");
      marker.setAttribute("orient", "auto");
      marker.setAttribute("markerUnits", "userSpaceOnUse");
      const head = document.createElementNS(SVG_NS, "path");
      head.setAttribute("d", "M0,0 L9,4.5 L0,9 z");
      head.setAttribute("fill", "context-stroke");
      marker.appendChild(head);
      defs.appendChild(marker);
      svg.appendChild(defs);
      // First child of #world so it paints behind the element nodes.
      world.insertBefore(svg, world.firstChild);
      connectorLayer = svg;
      return svg;
    };
    // Clip a point to a box border along the line from the box centre toward
    // (tx,ty) so an arrow lands on the edge instead of the middle.
    const borderPt = (b: El, tx: number, ty: number) => {
      const cx = b.x + b.w / 2, cy = b.y + b.h / 2;
      const dx = tx - cx, dy = ty - cy;
      if (!dx && !dy) return { x: cx, y: cy };
      const s = 1 / Math.max(Math.abs(dx) / (b.w / 2), Math.abs(dy) / (b.h / 2));
      return { x: cx + dx * s, y: cy + dy * s };
    };
    const drawConnectors = () => {
      const conns = doc.elements.filter((e) => e.type === "connector");
      if (!conns.length) {
        // Nothing to draw — drop the layer entirely so an empty board is clean.
        if (connectorLayer) { connectorLayer.remove(); connectorLayer = null; }
        return;
      }
      const svg = ensureConnectorLayer();
      // Rebuild the lines (cheap: a board has few connectors), keep <defs>.
      svg.querySelectorAll("line").forEach((n) => n.remove());
      for (const c of conns) {
        const a = getEl(String(c.props.from));
        const b = getEl(String(c.props.to));
        if (!a || !b || a.type === "connector" || b.type === "connector") continue;
        const s = borderPt(a, b.x + b.w / 2, b.y + b.h / 2);
        const e = borderPt(b, a.x + a.w / 2, a.y + a.h / 2);
        // A wide transparent line sits under the visible one so a 2.5px stroke
        // is easy to click. pointer-events:stroke makes only the line itself a
        // target even though the parent <svg> is pointer-events:none.
        const hit = document.createElementNS(SVG_NS, "line");
        hit.setAttribute("x1", s.x.toFixed(1));
        hit.setAttribute("y1", s.y.toFixed(1));
        hit.setAttribute("x2", e.x.toFixed(1));
        hit.setAttribute("y2", e.y.toFixed(1));
        hit.setAttribute("stroke", "transparent");
        hit.setAttribute("stroke-width", "16");
        hit.setAttribute("stroke-linecap", "round");
        hit.setAttribute("class", "easel-conn-hit");
        hit.style.pointerEvents = "stroke";
        hit.dataset.connId = c.id;
        hit.addEventListener("pointerdown", (ev) => {
          if (ev.button !== 0) return;
          ev.stopPropagation();
          selectConnector(c.id);
        });
        svg.appendChild(hit);
        const line = document.createElementNS(SVG_NS, "line");
        line.setAttribute("x1", s.x.toFixed(1));
        line.setAttribute("y1", s.y.toFixed(1));
        line.setAttribute("x2", e.x.toFixed(1));
        line.setAttribute("y2", e.y.toFixed(1));
        line.setAttribute("stroke", String(c.props.color || "#5b6472"));
        line.setAttribute("stroke-width", "2.5");
        line.setAttribute("stroke-linecap", "round");
        line.setAttribute("class", c.id === selectedConnectorId ? "easel-conn is-selected" : "easel-conn");
        if (c.props.style !== "line") line.setAttribute("marker-end", "url(#easel-arrow)");
        svg.appendChild(line);
      }
    };

    const renderDoc = (animate = false) => {
      const ids = new Set(doc.elements.map((e) => e.id));
      world.querySelectorAll<HTMLElement>("[data-el-id]").forEach((n) => {
        if (!ids.has(n.dataset.elId!)) n.remove();
      });
      for (const el of doc.elements) if (el.type !== "connector") renderEl(el, animate);
      drawConnectors();
      // Onboarding hint lives and dies with the empty-board state.
      emptyHint.hidden = doc.elements.length > 0;
      // track next element number
      for (const el of doc.elements) {
        const m = /^e(\d+)$/.exec(el.id);
        if (m) nextElNum = Math.max(nextElNum, Number(m[1]) + 1);
      }
    };

    const getEl = (id: string) => doc.elements.find((e) => e.id === id);
    const maxZ = () => doc.elements.reduce((m, e) => Math.max(m, e.z), 0);
    const minZ = () => doc.elements.reduce((m, e) => Math.min(m, e.z), 0);

    // ---------- persistence ----------
    const setSaveState = (s: string) => {
      saveState.textContent = s;
      // "Offline" is the only state where edits did not reach the server.
      saveState.classList.toggle("is-error", s === "Offline");
      unsynced = s === "Offline";
    };
    // Rapid same-kind edits (arrow-key nudges) should collapse into one undo
    // step, not one per keypress. A caller passes a coalesce key; while the
    // same key keeps arriving within the window, the change folds into the
    // current checkpoint instead of pushing a new one. The first edit of a run
    // still pushes, so undo returns to the pre-gesture state.
    let coalesceKey = "";
    let coalesceUntil = 0;
    const scheduleSave = (coalesce = "") => {
      const now = Date.now();
      const fold = !!coalesce && coalesce === coalesceKey && now < coalesceUntil;
      coalesceKey = coalesce;
      coalesceUntil = coalesce ? now + 600 : 0;
      const cur = JSON.stringify(doc.elements);
      if (cur !== undoBase) {
        if (!fold) {
          undoStack.push(undoBase);
          if (undoStack.length > 50) undoStack.shift();
          // A fresh edit invalidates the redo branch. Undo/redo themselves
          // land here with cur === undoBase, so they never clear it.
          redoStack = [];
        }
        undoBase = cur;
      }
      dirty = true;
      // Adds/deletes flow through here without a full renderDoc, so keep the
      // onboarding hint in sync with the element count on every local edit.
      emptyHint.hidden = doc.elements.length > 0;
      setSaveState("Editing…");
      if (saveTimer) window.clearTimeout(saveTimer);
      saveTimer = window.setTimeout(saveNow, 700);
    };
    const saveNow = async () => {
      if (!boardId || saving || !dirty) return;
      saving = true;
      dirty = false;
      setSaveState("Saving…");
      try {
        const body = await api(`/api/easel/board/${boardId}`, {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ doc, base_version: version, title: titleInput.value }),
        });
        version = body.version;
        setSaveState("Saved");
        // A blank input is a no-op rename server-side, so never store it in the
        // recent list (it would show the raw id); fall back to the kept title.
        if (titleInput.value.trim()) currentTitle = titleInput.value.trim();
        rememberBoard(boardId, currentTitle);
      } catch (err: any) {
        if (err.status === 409) {
          // Agent (or another tab) moved the board forward; refetch and merge
          // by taking the server doc. Local unsaved deltas are lost, which is
          // acceptable during an agent run — the agent owns the board then.
          await refetchBoard(true);
          setSaveState("Synced");
        } else {
          dirty = true;
          saveFailed = true;
          setSaveState("Offline");
        }
      } finally {
        saving = false;
        // A failed save retries quietly on a 2s backoff so "Offline" stays
        // visible. scheduleSave would reset the label to "Editing…" and spin a
        // tight 700ms loop, so it is only used for genuine new edits.
        if (saveFailed) {
          saveFailed = false;
          if (saveTimer) window.clearTimeout(saveTimer);
          saveTimer = window.setTimeout(saveNow, 2000);
        } else if (dirty) {
          scheduleSave();
        }
      }
    };

    const refetchBoard = async (animate = false) => {
      if (!boardId) return;
      const body = await api(`/api/easel/board/${boardId}?since=${version}`);
      if (body.unchanged) return;
      version = body.version;
      doc = body.doc;
      undoStack = [];
      redoStack = [];
      undoBase = JSON.stringify(doc.elements);
      currentTitle = body.title;
      if (document.activeElement !== titleInput) {
        titleInput.value = body.title;
        setDocTitle(body.title);
      }
      renderDoc(animate);
    };

    const undo = () => {
      const prev = undoStack.pop();
      if (prev === undefined) return;
      redoStack.push(undoBase);
      doc.elements = JSON.parse(prev);
      undoBase = prev;
      selectEl(null);
      renderDoc();
      scheduleSave();
    };

    const redo = () => {
      const next = redoStack.pop();
      if (next === undefined) return;
      undoStack.push(undoBase);
      if (undoStack.length > 50) undoStack.shift();
      doc.elements = JSON.parse(next);
      undoBase = next;
      selectEl(null);
      renderDoc();
      scheduleSave();
    };

    // ---------- alignment guides ----------
    // While a human drags an element, snap its edges and centers to the
    // edges and centers of every other element, and draw guide lines at
    // the matched positions. Guides live in #world so they pan/zoom with
    // the board; thickness compensates zoom to stay ~1.5px on screen.
    const clearGuides = () => {
      world.querySelectorAll(".easel-guide").forEach((n) => n.remove());
    };
    const drawGuide = (axis: "v" | "h", pos: number, lo: number, hi: number) => {
      const g = document.createElement("div");
      g.className = "easel-guide";
      const t = 1.5 / zoom;
      if (axis === "v") {
        g.style.left = `${pos - t / 2}px`;
        g.style.top = `${lo}px`;
        g.style.width = `${t}px`;
        g.style.height = `${hi - lo}px`;
      } else {
        g.style.left = `${lo}px`;
        g.style.top = `${pos - t / 2}px`;
        g.style.width = `${hi - lo}px`;
        g.style.height = `${t}px`;
      }
      world.appendChild(g);
    };
    type Snap = { d: number; snap: number; at: number; o: El };
    const snapMove = (el: El, nx: number, ny: number) => {
      clearGuides();
      const thr = 6 / zoom; // ~6 screen px regardless of zoom
      let bx: Snap | null = null;
      let by: Snap | null = null;
      for (const o of doc.elements) {
        if (o.id === el.id || o.type === "connector") continue;
        const oxs = [o.x, o.x + o.w / 2, o.x + o.w];
        const oys = [o.y, o.y + o.h / 2, o.y + o.h];
        const exs = [nx, nx + el.w / 2, nx + el.w];
        const eys = [ny, ny + el.h / 2, ny + el.h];
        for (const ox of oxs) for (const ex of exs) {
          const d = Math.abs(ex - ox);
          if (d < thr && (!bx || d < bx.d)) bx = { d, snap: nx + (ox - ex), at: ox, o };
        }
        for (const oy of oys) for (const ey of eys) {
          const d = Math.abs(ey - oy);
          if (d < thr && (!by || d < by.d)) by = { d, snap: ny + (oy - ey), at: oy, o };
        }
      }
      if (bx) nx = bx.snap;
      if (by) ny = by.snap;
      if (bx) {
        const lo = Math.min(ny, bx.o.y) - 12;
        const hi = Math.max(ny + el.h, bx.o.y + bx.o.h) + 12;
        drawGuide("v", bx.at, lo, hi);
      }
      if (by) {
        const lo = Math.min(nx, by.o.x) - 12;
        const hi = Math.max(nx + el.w, by.o.x + by.o.w) + 12;
        drawGuide("h", by.at, lo, hi);
      }
      return { x: nx, y: ny };
    };

    // ---------- element interaction ----------
    // Selection is a set. `selectedId` mirrors it only when exactly one element
    // is selected, so every single-element affordance (swatches, resize, drag
    // snap, dblclick edit, arrow nudge) keeps working unchanged and naturally
    // switches off for a multi-selection.
    const refreshSelectionUI = () => {
      selectedId = selectedIds.size === 1 ? [...selectedIds][0] : null;
      world.querySelectorAll<HTMLElement>("[data-el-id]").forEach((n) => {
        n.classList.toggle("is-selected", selectedIds.has(n.dataset.elId!));
      });
      // A box selection and a connector selection are mutually exclusive — any
      // change to the box set drops a picked connector (and its style bar).
      if (selectedConnectorId !== null) { selectedConnectorId = null; drawConnectors(); }
      connbar.hidden = true;
      reflectSwatches();
      updateAlignbar();
      drawGroupBox();
      drawRotateHandle();
    };
    const setSelection = (ids: string[]) => {
      selectedIds.clear();
      for (const id of ids) if (getEl(id)) selectedIds.add(id);
      refreshSelectionUI();
    };
    const toggleSelection = (id: string) => {
      if (selectedIds.has(id)) selectedIds.delete(id);
      else if (getEl(id)) selectedIds.add(id);
      refreshSelectionUI();
    };
    const selectEl = (id: string | null) => setSelection(id ? [id] : []);

    // ---------- connector selection ----------
    // Human parity with the agent's remove_elements / update_elements: a picked
    // connector shows a top-center style bar (colour, arrow/line, delete) and
    // responds to the Delete key. Connectors carry no box node, so this lives in
    // its own slot rather than the box selection set.
    const reflectConnbar = () => {
      const c = selectedConnectorId ? getEl(selectedConnectorId) : null;
      if (!c || c.type !== "connector") { connbar.hidden = true; return; }
      connbar.hidden = false;
      const cur = String(c.props.color || "#5b6472").toLowerCase();
      connbar.querySelectorAll<HTMLButtonElement>(".easel-conn-color").forEach((b) => {
        b.classList.toggle("is-active", (b.dataset.color || "").toLowerCase() === cur);
      });
      // Label shows the style a click switches TO.
      connStyleBtn.textContent = c.props.style === "line" ? "Arrow" : "Line";
    };
    const selectConnector = (id: string) => {
      setSelection([]); // refreshSelectionUI clears any prior connector pick too
      selectedConnectorId = id;
      drawConnectors(); // apply the is-selected highlight
      reflectConnbar();
    };
    const clearConnectorSelection = () => {
      if (selectedConnectorId === null) return;
      selectedConnectorId = null;
      connbar.hidden = true;
      drawConnectors();
    };
    const deleteConnector = (id: string) => {
      clearConnectorSelection();
      doc.elements = doc.elements.filter((e) => e.id !== id);
      drawConnectors();
      scheduleSave();
    };

    // Box elements (everything except connectors) are the targets for the
    // align/distribute bar. Show the bar at 2+, enable distribute at 3+.
    const selectedBoxes = () =>
      [...selectedIds].map(getEl).filter((e): e is NonNullable<typeof e> => !!e && e.type !== "connector");
    const updateAlignbar = () => {
      const boxes = selectedBoxes();
      alignbar.hidden = boxes.length < 2;
      alignbar.querySelectorAll<HTMLButtonElement>("[data-dist]").forEach((b) => {
        b.disabled = boxes.length < 3;
      });
    };

    // ---------- group bounding box + resize-as-unit ----------
    // A dashed box around a 2+ multi-selection with a single bottom-right handle.
    // It lives in #world so it pans and zooms with the board; the box passes
    // clicks through and only the handle is interactive. Dragging the handle
    // scales every member's position and size proportionally about the group's
    // top-left anchor (free by default, Shift = uniform / aspect-locked).
    const groupBox = document.createElement("div");
    groupBox.className = "easel-groupbox";
    groupBox.hidden = true;
    const groupHandle = document.createElement("div");
    groupHandle.className = "easel-groupbox-handle";
    groupBox.appendChild(groupHandle);
    world.appendChild(groupBox);

    const groupBounds = () => {
      const boxes = selectedBoxes();
      if (boxes.length < 2) return null;
      const minL = Math.min(...boxes.map((e) => e.x));
      const minT = Math.min(...boxes.map((e) => e.y));
      const maxR = Math.max(...boxes.map((e) => e.x + e.w));
      const maxB = Math.max(...boxes.map((e) => e.y + e.h));
      return { boxes, minL, minT, w: maxR - minL, h: maxB - minT };
    };
    const drawGroupBox = () => {
      const b = groupBounds();
      if (!b) { groupBox.hidden = true; return; }
      groupBox.hidden = false;
      groupBox.style.left = `${b.minL}px`;
      groupBox.style.top = `${b.minT}px`;
      groupBox.style.width = `${b.w}px`;
      groupBox.style.height = `${b.h}px`;
    };

    groupHandle.addEventListener("pointerdown", (ev) => {
      if (ev.button !== 0) return;
      ev.stopPropagation();
      const b = groupBounds();
      if (!b) return;
      const start = stagePoint(ev.clientX, ev.clientY);
      const anchor = { x: b.minL, y: b.minT };
      const W = Math.max(b.w, 1), H = Math.max(b.h, 1);
      const origins = b.boxes.map((e) => ({ el: e, x: e.x, y: e.y, w: e.w, h: e.h }));
      // Floor on scale so the smallest member never collapses below 20 units.
      const minW = Math.min(...origins.map((o) => o.w));
      const minH = Math.min(...origins.map((o) => o.h));
      const sxFloor = 20 / minW, syFloor = 20 / minH;
      groupHandle.setPointerCapture(ev.pointerId);
      const onMove = (mv: PointerEvent) => {
        const p = stagePoint(mv.clientX, mv.clientY);
        let sx = Math.max(sxFloor, (W + (p.x - start.x)) / W);
        let sy = Math.max(syFloor, (H + (p.y - start.y)) / H);
        if (mv.shiftKey) { const s = Math.max(sx, sy); sx = s; sy = s; }
        for (const o of origins) {
          o.el.x = anchor.x + (o.x - anchor.x) * sx;
          o.el.y = anchor.y + (o.y - anchor.y) * sy;
          o.el.w = o.w * sx;
          o.el.h = o.h * sy;
          renderEl(o.el);
        }
        drawConnectors();
        drawGroupBox();
      };
      const onUp = () => {
        groupHandle.removeEventListener("pointermove", onMove);
        groupHandle.removeEventListener("pointerup", onUp);
        scheduleSave();
      };
      groupHandle.addEventListener("pointermove", onMove);
      groupHandle.addEventListener("pointerup", onUp);
    });

    // ---------- rotation grip ----------
    // Human parity with the agent's update_elements rotation field. A single
    // selected box gets a knob above its top edge; dragging it spins the
    // element about its centre (Shift snaps to 15deg). The grip lives in
    // #world rather than on the node so an element's overflow:hidden never
    // clips it (the resize handle straddles the corner and survives; a top
    // knob sits fully outside and would be clipped). The render route already
    // emits transform:rotate(), so this is free parity end-to-end.
    const rotateHost = document.createElement("div");
    rotateHost.className = "easel-rotate-host";
    rotateHost.hidden = true;
    const rotateKnob = document.createElement("div");
    rotateKnob.className = "easel-rotate-knob";
    rotateHost.appendChild(rotateKnob);
    world.appendChild(rotateHost);

    const drawRotateHandle = () => {
      const el = selectedId ? getEl(selectedId) : null;
      // Only a lone box rotates; a group shows the dashed group box instead.
      if (!el || el.type === "connector") { rotateHost.hidden = true; return; }
      rotateHost.hidden = false;
      // Anchor the zero-size host at the element centre and rotate it with the
      // box; the knob hangs above the (local) top edge so it tracks rotation.
      rotateHost.style.left = `${el.x + el.w / 2}px`;
      rotateHost.style.top = `${el.y + el.h / 2}px`;
      rotateHost.style.transform = `rotate(${el.rotation || 0}deg)`;
      rotateKnob.style.top = `${-(el.h / 2 + 26)}px`;
    };

    rotateKnob.addEventListener("pointerdown", (ev) => {
      if (ev.button !== 0) return;
      ev.stopPropagation();
      ev.preventDefault();
      const el = selectedId ? getEl(selectedId) : null;
      if (!el) return;
      const cx = el.x + el.w / 2;
      const cy = el.y + el.h / 2;
      const startP = stagePoint(ev.clientX, ev.clientY);
      // Angle is measured centre→pointer in world space, so the knob's own
      // offset never biases the delta.
      const startAngle = Math.atan2(startP.y - cy, startP.x - cx);
      const origRot = el.rotation || 0;
      rotateKnob.setPointerCapture(ev.pointerId);
      const onMove = (mv: PointerEvent) => {
        const p = stagePoint(mv.clientX, mv.clientY);
        const cur = Math.atan2(p.y - cy, p.x - cx);
        let deg = origRot + (cur - startAngle) * (180 / Math.PI);
        if (mv.shiftKey) deg = Math.round(deg / 15) * 15;
        // Normalise into (-180, 180] to match the agent's rotation range.
        deg = ((deg + 180) % 360 + 360) % 360 - 180;
        el.rotation = Math.round(deg);
        renderEl(el);
        drawRotateHandle();
        drawConnectors();
      };
      const onUp = () => {
        rotateKnob.removeEventListener("pointermove", onMove);
        rotateKnob.removeEventListener("pointerup", onUp);
        scheduleSave();
      };
      rotateKnob.addEventListener("pointermove", onMove);
      rotateKnob.addEventListener("pointerup", onUp);
    });

    // The selection-style bar serves stickies (background color) and shapes
    // (fill color + a rect/ellipse kind toggle). Show it on selection of either
    // and mark the swatch matching the current color.
    const reflectSwatches = () => {
      const el = selectedId ? getEl(selectedId) : null;
      const isSticky = !!el && el.type === "sticky";
      const isShape = !!el && el.type === "shape";
      swatches.hidden = !(isSticky || isShape);
      shapeKind.hidden = !isShape;
      if (!isSticky && !isShape) return;
      // Stickies recolor props.color; shapes recolor props.fill.
      const cur = String((isSticky ? el!.props.color : el!.props.fill) || (isSticky ? "#fff3a3" : "#bcdcff")).toLowerCase();
      swatches.querySelectorAll<HTMLButtonElement>(".easel-swatch").forEach((b) => {
        b.classList.toggle("is-active", (b.dataset.color || "").toLowerCase() === cur);
      });
      // Toggle label shows the kind a click switches TO.
      if (isShape) shapeKind.textContent = el!.props.kind === "ellipse" ? "Rectangle" : "Ellipse";
    };

    const wireElement = (node: HTMLElement) => {
      const handle = node.querySelector<HTMLElement>(".easel-resize-handle")!;

      node.addEventListener("pointerdown", (ev) => {
        if (ev.button !== 0 || node.dataset.editing === "1") return;
        ev.stopPropagation();
        const id = node.dataset.elId!;
        const el = getEl(id);
        if (!el) return;
        // In connect mode a click wires an arrow instead of selecting/dragging.
        if (connectMode) { handleConnectPick(id); return; }
        // Shift-click toggles membership without starting a drag.
        if (ev.shiftKey) { toggleSelection(id); return; }
        // Clicking an element already inside a multi-selection keeps the group
        // (so you can drag the whole set); a plain click on anything else makes
        // it the sole selection.
        if (!selectedIds.has(id)) selectEl(id);

        // A group move slides every selected box together; single select keeps
        // the rich single-element behaviour (resize, snap guides, z-bump).
        const group = selectedBoxes();
        const isGroup = group.length > 1;

        // Frames live at the back so they never cover the elements inside
        // them; everything else comes to the front on grab. Only bump z for a
        // lone non-frame grab — a group move should preserve relative z-order.
        if (!isGroup && el.type !== "frame") {
          el.z = maxZ() + 1;
          node.style.zIndex = String(el.z);
        }

        const resizing = !isGroup && ev.target === handle;
        const start = stagePoint(ev.clientX, ev.clientY);
        const orig = { x: el.x, y: el.y, w: el.w, h: el.h };
        const ratio = orig.w / Math.max(orig.h, 1);
        // Capture every group member's origin so the whole set translates as one.
        const groupOrigins = group.map((g) => ({ el: g, x: g.x, y: g.y }));
        // Body drag shows the closed-hand cursor; resize keeps its corner cursor.
        if (!resizing) node.classList.add("is-grabbing");
        node.setPointerCapture(ev.pointerId);

        const onMove = (mv: PointerEvent) => {
          const p = stagePoint(mv.clientX, mv.clientY);
          const dx = p.x - start.x, dy = p.y - start.y;
          if (resizing) {
            el.w = Math.max(40, orig.w + dx);
            el.h = mv.shiftKey || el.type !== "image"
              ? Math.max(40, orig.h + dy)
              : Math.max(40, el.w / ratio);
            renderEl(el);
          } else if (isGroup) {
            // Group move: translate every member, no snap guides (snapping a
            // single edge of a rigid group is more confusing than helpful).
            clearGuides();
            for (const g of groupOrigins) {
              g.el.x = g.x + dx;
              g.el.y = g.y + dy;
              renderEl(g.el);
            }
            drawGroupBox();
          } else if (mv.altKey) {
            // Alt bypasses snapping for free placement.
            clearGuides();
            el.x = orig.x + dx;
            el.y = orig.y + dy;
            renderEl(el);
          } else {
            const s = snapMove(el, orig.x + dx, orig.y + dy);
            el.x = s.x;
            el.y = s.y;
            renderEl(el);
          }
          // Re-route any arrows attached to a moved/resized box.
          drawConnectors();
          // Keep the rotation grip glued to a lone box as it moves/resizes.
          if (!isGroup) drawRotateHandle();
        };
        const onUp = () => {
          clearGuides();
          node.classList.remove("is-grabbing");
          node.removeEventListener("pointermove", onMove);
          node.removeEventListener("pointerup", onUp);
          scheduleSave();
        };
        node.addEventListener("pointermove", onMove);
        node.addEventListener("pointerup", onUp);
      });

      node.addEventListener("dblclick", () => {
        const id = node.dataset.elId!;
        const el = getEl(id);
        if (!el) return;
        if (el.type === "frame") {
          // Edit the frame's label span, not the frame body.
          const label = node.querySelector<HTMLElement>(".easel-frame-label")!;
          node.dataset.editing = "1";
          label.contentEditable = "plaintext-only";
          label.focus();
          window.getSelection()?.selectAllChildren(label);
          const finishLabel = () => {
            node.dataset.editing = "0";
            label.contentEditable = "false";
            el.props.label = label.textContent ?? "";
            renderEl(el);
            scheduleSave();
            label.removeEventListener("blur", finishLabel);
            label.removeEventListener("keydown", onKeyLabel);
          };
          // Escape exits the inline edit (commits, like clicking away) without
          // having to click empty canvas — which would also deselect/pan.
          // stopPropagation keeps the document Escape handler from also
          // deselecting; first Escape exits editing, a second one deselects.
          const onKeyLabel = (ev: KeyboardEvent) => {
            if (ev.key === "Escape") { ev.preventDefault(); ev.stopPropagation(); label.blur(); }
          };
          label.addEventListener("blur", finishLabel);
          label.addEventListener("keydown", onKeyLabel);
          return;
        }
        if (el.type !== "text" && el.type !== "sticky" && el.type !== "shape") return;
        node.dataset.editing = "1";
        // Pull the resize handle out of the editable region while editing.
        // selectAllChildren spans every child, and on a flex container (shapes)
        // the browser merges typed text INTO the trailing block child — the
        // handle — which duplicates the label and corrupts the read. With the
        // handle detached, typed text has nowhere to merge; it is restored on
        // finish. Harmless for text/sticky, which also gain a cleaner edit.
        const hadHandle = handle.parentNode === node;
        if (hadHandle) handle.remove();
        // Detach suggestion chrome too: the badge text and × glyph would
        // otherwise be captured by the innerText read below and corrupt the
        // saved note. renderEl re-adds them on finish via applySuggestionChrome.
        node.querySelector(".easel-suggest-badge")?.remove();
        node.querySelector(".easel-suggest-dismiss")?.remove();
        node.contentEditable = "plaintext-only";
        node.focus();
        const sel = window.getSelection();
        sel?.selectAllChildren(node);
        const finish = () => {
          node.dataset.editing = "0";
          node.contentEditable = "false";
          // Read the edited text via innerText so it round-trips regardless of
          // how the browser structured the edit. plaintext-only typing leaves
          // bare text nodes on block elements (text/sticky), but on the shape's
          // flex container the browser wraps lines in <div>s; a text-node-only
          // reader would silently drop shape labels. innerText captures the
          // rendered text with line breaks in both cases. Trailing blank lines
          // that contenteditable tends to leave are trimmed.
          el.props.text = (node.innerText ?? "").replace(/\n+$/, "");
          // Clear every edit artifact, then restore the resize handle, so
          // renderEl rebuilds a single clean text node followed by the handle.
          Array.from(node.childNodes).forEach((c) => c.remove());
          if (hadHandle) node.appendChild(handle);
          renderEl(el);
          scheduleSave();
          node.removeEventListener("blur", finish);
          node.removeEventListener("keydown", onKeyNode);
        };
        // Escape commits and exits editing (Enter stays a newline for
        // multiline notes); saves a click-away that would deselect/pan.
        // stopPropagation keeps the document Escape handler from also
        // deselecting; first Escape exits editing, a second one deselects.
        const onKeyNode = (ev: KeyboardEvent) => {
          if (ev.key === "Escape") { ev.preventDefault(); ev.stopPropagation(); node.blur(); }
        };
        node.addEventListener("blur", finish);
        node.addEventListener("keydown", onKeyNode);
      });
    };

    // ---------- stage interaction (pan, zoom, deselect, delete) ----------
    // Touch: the canvas sets touch-action:none so the browser does no native
    // panning or zooming. Mouse uses the per-gesture closure below; touch is
    // handled separately because it needs the multi-pointer state for pinch —
    // one finger pans, two fingers pinch-zoom. Without this, touch devices
    // could not zoom at all (wheel never fires on touch) even though the help
    // overlay advertises pinch, and a second finger spawned a competing pan.
    const touches = new Map<number, { x: number; y: number }>();
    let pinchPrev: { dist: number; mx: number; my: number } | null = null;
    const touchDist = () => {
      const [a, b] = [...touches.values()];
      return Math.hypot(a.x - b.x, a.y - b.y);
    };
    const touchMid = () => {
      const [a, b] = [...touches.values()];
      const r = stage.getBoundingClientRect();
      return { x: (a.x + b.x) / 2 - r.left, y: (a.y + b.y) / 2 - r.top };
    };

    stage.addEventListener("pointerdown", (ev) => {
      // A click on empty canvas while armed cancels connect mode (the source
      // pick, if any, is dropped). Element clicks call stopPropagation, so they
      // never reach here.
      if (connectMode) { setConnectMode(false); return; }
      if (ev.pointerType === "touch") {
        touches.set(ev.pointerId, { x: ev.clientX, y: ev.clientY });
        // setPointerCapture throws on a synthetic pointer id (tests); harmless
        // to guard and it never throws for a real touch.
        try { stage.setPointerCapture(ev.pointerId); } catch { /* ignore */ }
        if (touches.size === 1) {
          selectEl(null);
          stage.classList.add("is-panning");
        } else if (touches.size === 2) {
          pinchPrev = { dist: touchDist(), ...touchMid() };
        }
        return;
      }
      // Draw mode: a plain left-drag paints a freehand stroke. Middle-mouse and
      // Space+left still PAN (interaction invariant), so guard on button 0 with
      // no Space held; everything else falls through to the normal pan/marquee.
      if (drawMode && ev.button === 0 && !spaceHeld) { startStroke(ev); return; }
      if (ev.button !== 0 && ev.button !== 1) return;
      // Drag-to-move is the default (Miro/FigJam): plain left-drag, middle-mouse,
      // or Space+left-drag all pan the canvas. Shift+left-drag draws a marquee
      // selection (additive — shift-click already toggles single elements).
      const marquee = ev.button === 0 && ev.shiftKey && !spaceHeld;
      if (marquee) { startMarquee(ev); return; }
      selectEl(null);
      stage.classList.add("is-panning");
      const startX = ev.clientX - panX, startY = ev.clientY - panY;
      stage.setPointerCapture(ev.pointerId);
      const onMove = (mv: PointerEvent) => {
        panX = mv.clientX - startX;
        panY = mv.clientY - startY;
        applyView();
      };
      const onUp = () => {
        stage.classList.remove("is-panning");
        stage.removeEventListener("pointermove", onMove);
        stage.removeEventListener("pointerup", onUp);
      };
      stage.addEventListener("pointermove", onMove);
      stage.addEventListener("pointerup", onUp);
    });

    // Rubber-band selection. A screen-space box is drawn in #stage; on move it
    // hit-tests every box element in world coords and selects those it covers.
    // Shift makes it additive to the current selection. Below the 4px threshold
    // it behaves as a plain click that deselects.
    const startMarquee = (ev: PointerEvent) => {
      const r = stage.getBoundingClientRect();
      const ox = ev.clientX, oy = ev.clientY;
      const base = ev.shiftKey ? new Set(selectedIds) : new Set<string>();
      const boxEls = doc.elements.filter((e) => e.type !== "connector");
      let box: HTMLElement | null = null;
      let moved = false;
      stage.setPointerCapture(ev.pointerId);
      const onMove = (mv: PointerEvent) => {
        const dx = mv.clientX - ox, dy = mv.clientY - oy;
        if (!moved && Math.abs(dx) < 4 && Math.abs(dy) < 4) return;
        moved = true;
        if (!box) {
          box = document.createElement("div");
          box.className = "easel-marquee";
          stage.appendChild(box);
        }
        const left = Math.min(ox, mv.clientX) - r.left;
        const top = Math.min(oy, mv.clientY) - r.top;
        box.style.left = `${left}px`;
        box.style.top = `${top}px`;
        box.style.width = `${Math.abs(dx)}px`;
        box.style.height = `${Math.abs(dy)}px`;
        // World-coord bounds of the marquee.
        const p0 = stagePoint(Math.min(ox, mv.clientX), Math.min(oy, mv.clientY));
        const p1 = stagePoint(Math.max(ox, mv.clientX), Math.max(oy, mv.clientY));
        const hit = new Set(base);
        for (const el of boxEls) {
          if (el.x < p1.x && el.x + el.w > p0.x && el.y < p1.y && el.y + el.h > p0.y) hit.add(el.id);
        }
        setSelection([...hit]);
      };
      const onUp = () => {
        if (box) box.remove();
        if (!moved) selectEl(null);
        stage.removeEventListener("pointermove", onMove);
        stage.removeEventListener("pointerup", onUp);
      };
      stage.addEventListener("pointermove", onMove);
      stage.addEventListener("pointerup", onUp);
    };

    // Freehand stroke capture (Draw mode). Points are collected in WORLD coords
    // via a live preview SVG appended to #world (so it pans/zooms for free like
    // the connector layer); on release the stroke is committed as a `draw`
    // element whose local point space equals its padded bounding box.
    const startStroke = (ev: PointerEvent) => {
      const pts: number[][] = [];
      const p0 = stagePoint(ev.clientX, ev.clientY);
      pts.push([p0.x, p0.y]);
      const prev = document.createElementNS(SVG_NS, "svg");
      prev.setAttribute("class", "easel-draw-preview");
      prev.style.cssText =
        "position:absolute;left:0;top:0;width:1px;height:1px;overflow:visible;pointer-events:none;z-index:9998;";
      const path = document.createElementNS(SVG_NS, "path");
      path.setAttribute("fill", "none");
      path.setAttribute("stroke", lastDrawColor);
      path.setAttribute("stroke-width", String(lastDrawWidth));
      path.setAttribute("stroke-linecap", "round");
      path.setAttribute("stroke-linejoin", "round");
      prev.appendChild(path);
      world.appendChild(prev);
      stage.setPointerCapture(ev.pointerId);
      const onMove = (mv: PointerEvent) => {
        const p = stagePoint(mv.clientX, mv.clientY);
        const last = pts[pts.length - 1];
        // Drop near-duplicate samples so the stored path stays light.
        if (Math.abs(p.x - last[0]) < 1.2 && Math.abs(p.y - last[1]) < 1.2) return;
        pts.push([p.x, p.y]);
        path.setAttribute("d", drawPath(pts));
      };
      const onUp = () => {
        stage.removeEventListener("pointermove", onMove);
        stage.removeEventListener("pointerup", onUp);
        prev.remove();
        commitStroke(pts);
      };
      stage.addEventListener("pointermove", onMove);
      stage.addEventListener("pointerup", onUp);
    };
    const STROKE_PAD = 6;
    const commitStroke = (worldPts: number[][]) => {
      if (worldPts.length < 2) return; // a tap, not a stroke
      let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
      for (const [x, y] of worldPts) {
        minX = Math.min(minX, x); minY = Math.min(minY, y);
        maxX = Math.max(maxX, x); maxY = Math.max(maxY, y);
      }
      const x = minX - STROKE_PAD, y = minY - STROKE_PAD;
      const w = (maxX - minX) + STROKE_PAD * 2;
      const h = (maxY - minY) + STROKE_PAD * 2;
      const local = worldPts.map(
        ([px, py]) => [Math.round((px - x) * 10) / 10, Math.round((py - y) * 10) / 10],
      );
      // Commit without selecting so Draw mode stays armed for the next stroke
      // (FigJam pen behaviour). Exit the mode to select/move the stroke.
      const full: El = {
        type: "draw", id: `e${nextElNum++}`, z: maxZ() + 1,
        x, y, w, h,
        props: { points: local, stroke: lastDrawColor, width: lastDrawWidth, vbW: w, vbH: h },
      };
      doc.elements.push(full);
      renderEl(full);
      scheduleSave();
    };

    stage.addEventListener("pointermove", (ev) => {
      if (ev.pointerType !== "touch" || !touches.has(ev.pointerId)) return;
      const prev = touches.get(ev.pointerId)!;
      touches.set(ev.pointerId, { x: ev.clientX, y: ev.clientY });
      if (touches.size === 1) {
        panX += ev.clientX - prev.x;
        panY += ev.clientY - prev.y;
        applyView();
      } else if (touches.size >= 2 && pinchPrev) {
        const dist = touchDist();
        const mid = touchMid();
        const next = Math.min(4, Math.max(0.1, zoom * (dist / Math.max(pinchPrev.dist, 1))));
        // Zoom around the pinch midpoint, then follow a two-finger drag of it.
        panX = mid.x - ((mid.x - panX) / zoom) * next + (mid.x - pinchPrev.mx);
        panY = mid.y - ((mid.y - panY) / zoom) * next + (mid.y - pinchPrev.my);
        zoom = next;
        applyView();
        pinchPrev = { dist, mx: mid.x, my: mid.y };
      }
    });

    const endTouch = (ev: PointerEvent) => {
      if (ev.pointerType !== "touch" || !touches.has(ev.pointerId)) return;
      touches.delete(ev.pointerId);
      if (touches.size < 2) pinchPrev = null;
      if (touches.size === 0) stage.classList.remove("is-panning");
    };
    stage.addEventListener("pointerup", endTouch);
    stage.addEventListener("pointercancel", endTouch);

    stage.addEventListener("wheel", (ev) => {
      ev.preventDefault();
      // Figma/Miro model: plain scroll (and two-finger trackpad swipe) pans the
      // canvas; Ctrl/Cmd+scroll zooms around the cursor; Shift+scroll pans
      // horizontally. A trackpad pinch arrives as a Ctrl+wheel event, so it
      // zooms too. This is the gesture set users reach for to move the board.
      if (ev.ctrlKey || ev.metaKey) {
        const r = stage.getBoundingClientRect();
        const mx = ev.clientX - r.left, my = ev.clientY - r.top;
        const factor = ev.deltaY < 0 ? 1.1 : 1 / 1.1;
        const next = Math.min(4, Math.max(0.1, zoom * factor));
        panX = mx - ((mx - panX) / zoom) * next;
        panY = my - ((my - panY) / zoom) * next;
        zoom = next;
        applyView();
        return;
      }
      // Pan. Shift turns a vertical mouse wheel into horizontal motion;
      // trackpads already deliver deltaX directly for a sideways swipe.
      let dx = ev.deltaX, dy = ev.deltaY;
      if (ev.shiftKey && dx === 0) { dx = dy; dy = 0; }
      panX -= dx;
      panY -= dy;
      applyView();
    }, { passive: false });
    // Double-clicking empty canvas drops a sticky at the cursor (Miro/FigJam).
    // Element dblclick edits in place and is ignored here via the target guard.
    stage.addEventListener("dblclick", (ev) => {
      if ((ev.target as HTMLElement).closest("[data-el-id]")) return;
      addSticky(stagePoint(ev.clientX, ev.clientY));
    });

    document.addEventListener("keydown", (ev) => {
      if (workspace.hidden) return;
      const tag = (document.activeElement?.tagName || "").toLowerCase();
      const typing = tag === "input" || tag === "textarea" ||
        (document.activeElement as HTMLElement)?.isContentEditable;
      if (typing) return;
      // Hold Space to turn left-drag into a pan (released in the keyup handler).
      if (ev.key === " " || ev.code === "Space") {
        spaceHeld = true;
        ev.preventDefault();
        return;
      }
      // The templates picker is a modal too: while it's open only Escape acts,
      // so single-letter shortcuts don't mutate the board behind the dialog.
      if (!templatesModal.hidden) {
        if (ev.key === "Escape") { ev.preventDefault(); setTemplatesModal(false); }
        return;
      }
      // The shortcuts overlay is a modal: while it's open only ? (toggle) and
      // Escape (close) act. Without this, single-letter shortcuts (t/s/r/u/f),
      // arrows, Delete and undo all still fired and mutated the board behind
      // the open dialog.
      if (!keysOverlay.hidden) {
        if (ev.key === "Escape" || ev.key === "?") {
          ev.preventDefault();
          setKeysOverlay(false);
        }
        return;
      }
      // Ctrl/Cmd+S: people hit it out of habit — flush the pending save
      // instead of opening the browser's save dialog.
      if ((ev.metaKey || ev.ctrlKey) && ev.key.toLowerCase() === "s") {
        ev.preventDefault();
        if (dirty) saveNow();
        return;
      }
      // Ctrl/Cmd+Z: undo the last local gesture.
      if ((ev.metaKey || ev.ctrlKey) && !ev.shiftKey && ev.key.toLowerCase() === "z") {
        ev.preventDefault();
        undo();
        return;
      }
      // Ctrl/Cmd+Shift+Z or Ctrl/Cmd+Y: redo.
      if ((ev.metaKey || ev.ctrlKey) &&
        ((ev.shiftKey && ev.key.toLowerCase() === "z") || ev.key.toLowerCase() === "y")) {
        ev.preventDefault();
        redo();
        return;
      }
      // Ctrl/Cmd+D: duplicate the whole selection just off itself.
      if ((ev.metaKey || ev.ctrlKey) && ev.key.toLowerCase() === "d" && selectedBoxes().length) {
        ev.preventDefault();
        duplicateSelected();
        return;
      }
      // Ctrl/Cmd+A: select every element on the board.
      if ((ev.metaKey || ev.ctrlKey) && ev.key.toLowerCase() === "a") {
        ev.preventDefault();
        setSelection(doc.elements.filter((e) => e.type !== "connector").map((e) => e.id));
        return;
      }
      // Ctrl/Cmd+] / [ restack: bring forward / send backward; +Shift jumps to
      // the very front / back. ev.code is layout-safe (Shift turns ] into }).
      if ((ev.metaKey || ev.ctrlKey) &&
          (ev.code === "BracketRight" || ev.code === "BracketLeft") &&
          selectedBoxes().length) {
        ev.preventDefault();
        const toFront = ev.code === "BracketRight";
        restackSelected(ev.shiftKey ? (toFront ? "front" : "back") : (toFront ? "forward" : "backward"));
        return;
      }
      // Never hijack browser shortcuts (Ctrl+R reload, Ctrl+F find,
      // Ctrl+T new tab, Ctrl+U view source…); single letters only.
      if (ev.metaKey || ev.ctrlKey || ev.altKey) return;
      // Arrow keys nudge the selected element 1 world unit (10 with Shift).
      const nudges: Record<string, [number, number]> = {
        ArrowUp: [0, -1], ArrowDown: [0, 1], ArrowLeft: [-1, 0], ArrowRight: [1, 0],
      };
      if (nudges[ev.key] && selectedIds.size) {
        const targets = selectedBoxes();
        if (targets.length) {
          ev.preventDefault();
          const step = ev.shiftKey ? 10 : 1;
          for (const el of targets) {
            el.x += nudges[ev.key][0] * step;
            el.y += nudges[ev.key][1] * step;
            renderEl(el);
          }
          drawConnectors();
          drawGroupBox();
          // Coalesce a burst of arrow nudges into a single undo step.
          scheduleSave(`nudge:${[...selectedIds].sort().join(",")}`);
        }
        return;
      }
      if ((ev.key === "Delete" || ev.key === "Backspace") && selectedConnectorId && !selectedIds.size) {
        ev.preventDefault();
        deleteConnector(selectedConnectorId);
        return;
      }
      if ((ev.key === "Delete" || ev.key === "Backspace") && selectedIds.size) {
        const delIds = new Set(selectedIds);
        // Drop the selected elements and any connector that referenced one of
        // them, so no arrow is left dangling to a box that no longer exists.
        doc.elements = doc.elements.filter((e) =>
          !delIds.has(e.id) &&
          !(e.type === "connector" && (delIds.has(e.props.from) || delIds.has(e.props.to))));
        selectEl(null);
        renderDoc();
        scheduleSave();
      } else if (ev.key.toLowerCase() === "t") addText();
      else if (ev.key.toLowerCase() === "s") addSticky();
      else if (ev.key.toLowerCase() === "r") addFrame();
      else if (ev.key.toLowerCase() === "h") addShape();
      else if (ev.key.toLowerCase() === "c") setConnectMode(!connectMode);
      else if (ev.key.toLowerCase() === "p") setDrawMode(!drawMode);
      else if (ev.key.toLowerCase() === "u") fileInput.click();
      else if (ev.key.toLowerCase() === "f") zoomToFit();
      else if (ev.key === "?") setKeysOverlay(keysOverlay.hidden);
      else if (ev.key === "Escape") {
        // Esc closes the help overlay first, then cancels connect mode, then
        // deselects — one concern unwound per press.
        if (!keysOverlay.hidden) setKeysOverlay(false);
        else if (connectMode) setConnectMode(false);
        else if (drawMode) setDrawMode(false);
        else if (selectedConnectorId) clearConnectorSelection();
        else if (selectedIds.size) selectEl(null);
      }
    });

    // Release the Space-to-pan modifier.
    document.addEventListener("keyup", (ev) => {
      if (ev.key === " " || ev.code === "Space") spaceHeld = false;
    });
    // If focus leaves the window mid-hold, drop the modifier so the next
    // left-drag is a marquee, not a surprise pan.
    window.addEventListener("blur", () => { spaceHeld = false; });

    // ---------- creation ----------
    const centerPoint = () => {
      const r = stage.getBoundingClientRect();
      return stagePoint(r.left + r.width / 2, r.top + r.height / 2);
    };
    const addElement = (el: Omit<El, "id" | "z">) => {
      const full: El = { ...el, id: `e${nextElNum++}`, z: maxZ() + 1 };
      doc.elements.push(full);
      renderEl(full);
      selectEl(full.id);
      scheduleSave();
      return full;
    };
    // A freshly added text or sticky opens straight into edit mode so you can
    // type immediately instead of add-then-double-click. The node's own dblclick
    // handler selects the placeholder, so the first keystroke replaces it. The
    // event is non-bubbling (the stage's dblclick adds a sticky), and queueMicrotask
    // lets the triggering click/keydown finish before focus moves into the node.
    const editElement = (id: string) => {
      queueMicrotask(() => {
        world.querySelector<HTMLElement>(`[data-el-id="${id}"]`)
          ?.dispatchEvent(new MouseEvent("dblclick"));
      });
    };
    const addText = () => {
      const c = centerPoint();
      const el = addElement({ type: "text", x: c.x - 160, y: c.y - 24, w: 320, h: 48,
        props: { text: "Double-click to edit", size: 28, weight: 600 } });
      editElement(el.id);
    };
    // Remember the last sticky color the user chose from the palette so the next
    // sticky inherits it, instead of snapping back to yellow every time. Most
    // canvas tools (Miro/FigJam) keep the last-used color; picking blue, then
    // adding another note, should give you blue. Updated by the swatch handler.
    let lastStickyColor = "#fff3a3";
    const addSticky = (at?: { x: number; y: number }) => {
      const c = at ?? centerPoint();
      const el = addElement({ type: "sticky", x: c.x - 90, y: c.y - 90, w: 180, h: 180,
        props: { text: "New note", color: lastStickyColor } });
      editElement(el.id);
      coachMark("sticky");
    };
    const addFrame = () => {
      // Frames go to the BACK of the z-order so they group elements
      // visually without covering them.
      const c = centerPoint();
      const full: El = {
        type: "frame", id: `e${nextElNum++}`, z: minZ() - 1,
        x: c.x - 240, y: c.y - 160, w: 480, h: 320,
        props: { label: "Frame" },
      };
      doc.elements.push(full);
      renderEl(full);
      selectEl(full.id);
      scheduleSave();
    };
    // Shapes are visual blocks (rect/ellipse) with optional centered text. A new
    // shape lands as a rectangle; flip it to an ellipse and recolor its fill from
    // the selection-style bar, or double-click to type a label.
    const addShape = (at?: { x: number; y: number }) => {
      const c = at ?? centerPoint();
      addElement({ type: "shape", x: c.x - 90, y: c.y - 60, w: 180, h: 120,
        props: { kind: "rect", fill: "#bcdcff", stroke: "#3a4a8c", text: "" } });
    };
    // ---------- templates ----------
    // Starter layouts built from the existing element types (frame/sticky/shape +
    // connectors), so the no-JS render route already paints them — no render-route
    // change needed. Each template is plain data: boxes with local `ref` names and
    // connectors that reference those refs. KEEP IN SYNC with the apply_template
    // tool in reel-claude-bridge/easel-mcp.ts (same definitions, server-side) so a
    // human and the agent drop identical boards. Coordinates are template-local;
    // applyTemplate shifts the whole layout so its center lands at the view center.
    type TplBox = { ref?: string; type: "frame" | "sticky" | "shape" | "text"; x: number; y: number; w: number; h: number; props: Record<string, any> };
    type TplConn = { from: string; to: string };
    type Template = { name: string; boxes: TplBox[]; conns?: TplConn[] };
    const TEMPLATES: Record<string, Template> = {
      brainstorm: {
        name: "Brainstorm",
        boxes: [
          { ref: "c", type: "sticky", x: -90, y: -90, w: 180, h: 180, props: { text: "Topic", color: "#bcdcff" } },
          { ref: "i1", type: "sticky", x: -80, y: -330, w: 160, h: 120, props: { text: "Idea", color: "#fff3a3" } },
          { ref: "i2", type: "sticky", x: 240, y: -220, w: 160, h: 120, props: { text: "Idea", color: "#fff3a3" } },
          { ref: "i3", type: "sticky", x: 240, y: 120, w: 160, h: 120, props: { text: "Idea", color: "#fff3a3" } },
          { ref: "i4", type: "sticky", x: -80, y: 210, w: 160, h: 120, props: { text: "Idea", color: "#fff3a3" } },
          { ref: "i5", type: "sticky", x: -400, y: 120, w: 160, h: 120, props: { text: "Idea", color: "#fff3a3" } },
          { ref: "i6", type: "sticky", x: -400, y: -220, w: 160, h: 120, props: { text: "Idea", color: "#fff3a3" } },
        ],
        conns: [
          { from: "c", to: "i1" }, { from: "c", to: "i2" }, { from: "c", to: "i3" },
          { from: "c", to: "i4" }, { from: "c", to: "i5" }, { from: "c", to: "i6" },
        ],
      },
      retro: {
        name: "Retro",
        boxes: [
          { type: "frame", x: 0, y: 0, w: 360, h: 540, props: { label: "What went well" } },
          { type: "frame", x: 400, y: 0, w: 360, h: 540, props: { label: "What didn't" } },
          { type: "frame", x: 800, y: 0, w: 360, h: 540, props: { label: "Action items" } },
          { type: "sticky", x: 30, y: 70, w: 300, h: 120, props: { text: "A win worth repeating", color: "#c7f0c2" } },
          { type: "sticky", x: 430, y: 70, w: 300, h: 120, props: { text: "Something that slowed us down", color: "#ffc9d4" } },
          { type: "sticky", x: 830, y: 70, w: 300, h: 120, props: { text: "Next step — who & when", color: "#fff3a3" } },
        ],
      },
      kanban: {
        name: "Kanban",
        boxes: [
          { type: "frame", x: 0, y: 0, w: 320, h: 560, props: { label: "To Do" } },
          { type: "frame", x: 360, y: 0, w: 320, h: 560, props: { label: "In Progress" } },
          { type: "frame", x: 720, y: 0, w: 320, h: 560, props: { label: "Done" } },
          { type: "sticky", x: 25, y: 70, w: 270, h: 110, props: { text: "Task one", color: "#fff3a3" } },
          { type: "sticky", x: 25, y: 200, w: 270, h: 110, props: { text: "Task two", color: "#fff3a3" } },
          { type: "sticky", x: 25, y: 330, w: 270, h: 110, props: { text: "Task three", color: "#fff3a3" } },
        ],
      },
      moodboard: {
        name: "Moodboard",
        boxes: [
          { type: "frame", x: 0, y: 0, w: 820, h: 580, props: { label: "Moodboard" } },
          { type: "shape", x: 25, y: 70, w: 370, h: 220, props: { kind: "rect", fill: "#eceff3", stroke: "#aab2c0", text: "Image" } },
          { type: "shape", x: 425, y: 70, w: 370, h: 220, props: { kind: "rect", fill: "#eceff3", stroke: "#aab2c0", text: "Image" } },
          { type: "shape", x: 25, y: 310, w: 370, h: 220, props: { kind: "rect", fill: "#eceff3", stroke: "#aab2c0", text: "Image" } },
          { type: "shape", x: 425, y: 310, w: 370, h: 220, props: { kind: "rect", fill: "#eceff3", stroke: "#aab2c0", text: "Image" } },
        ],
      },
    };
    const applyTemplate = (key: string) => {
      const tpl = TEMPLATES[key];
      if (!tpl) return;
      // Center the template's bounding box on the current view center.
      const xs = tpl.boxes.map((b) => b.x), ys = tpl.boxes.map((b) => b.y);
      const xe = tpl.boxes.map((b) => b.x + b.w), ye = tpl.boxes.map((b) => b.y + b.h);
      const minX = Math.min(...xs), maxX = Math.max(...xe);
      const minY = Math.min(...ys), maxY = Math.max(...ye);
      const target = centerPoint();
      const dx = target.x - (minX + maxX) / 2;
      const dy = target.y - (minY + maxY) / 2;
      // Frames sit behind everything; other boxes stack above existing content.
      const baseFrameZ = minZ() - 1;
      let z = maxZ();
      const refMap: Record<string, string> = {};
      const created: El[] = [];
      for (const b of tpl.boxes) {
        const id = `e${nextElNum++}`;
        if (b.ref) refMap[b.ref] = id;
        const el: El = {
          id, type: b.type,
          x: Math.round(b.x + dx), y: Math.round(b.y + dy), w: b.w, h: b.h,
          z: b.type === "frame" ? baseFrameZ : ++z,
          props: { ...b.props },
        };
        doc.elements.push(el);
        created.push(el);
      }
      for (const c of tpl.conns ?? []) {
        const from = refMap[c.from], to = refMap[c.to];
        if (!from || !to) continue;
        doc.elements.push({
          type: "connector", id: `e${nextElNum++}`, x: 0, y: 0, w: 0, h: 0, z: 0,
          props: { from, to, style: "arrow", color: "#5b6472" },
        });
      }
      for (const el of created) renderEl(el, true);
      drawConnectors();
      scheduleSave();
      // Select the new boxes so the group affordances frame the fresh layout,
      // then fit the view so the whole template is visible at once.
      setSelection(created.map((e) => e.id));
      zoomToFit();
      setSaveState(`${tpl.name} template added`);
    };
    const setTemplatesModal = (open: boolean) => {
      templatesModal.hidden = !open;
      $("tool-templates").setAttribute("aria-expanded", String(open));
    };
    // ---------- connect mode ----------
    // Wire an arrow between two existing elements. The connector stores only the
    // two ids + style; its geometry is derived on every draw, so it re-routes
    // automatically when either endpoint moves.
    const addConnector = (fromId: string, toId: string) => {
      if (fromId === toId) return;
      const a = getEl(fromId), b = getEl(toId);
      if (!a || !b || a.type === "connector" || b.type === "connector") return;
      // Skip a duplicate arrow between the same unordered pair.
      const dup = doc.elements.some((e) => e.type === "connector" &&
        ((e.props.from === fromId && e.props.to === toId) ||
         (e.props.from === toId && e.props.to === fromId)));
      if (dup) return;
      doc.elements.push({
        type: "connector", id: `e${nextElNum++}`, x: 0, y: 0, w: 0, h: 0, z: 0,
        props: { from: fromId, to: toId, style: "arrow", color: "#5b6472" },
      });
      drawConnectors();
      scheduleSave();
    };
    const markConnectSrc = (id: string | null) => {
      world.querySelectorAll<HTMLElement>("[data-el-id]").forEach((n) => {
        n.classList.toggle("is-connect-src", n.dataset.elId === id);
      });
    };
    const setConnectMode = (on: boolean) => {
      connectMode = on;
      connectFrom = null;
      markConnectSrc(null);
      stage.classList.toggle("is-connecting", on);
      const btn = $("tool-connect");
      btn.classList.toggle("is-active", on);
      btn.setAttribute("aria-pressed", String(on));
      if (on) { if (drawMode) setDrawMode(false); selectEl(null); } // modes are mutually exclusive
    };
    // Draw mode mirrors connect mode: a stage-wide armed state with its own
    // toolbar toggle. The two modes are mutually exclusive.
    const setDrawMode = (on: boolean) => {
      drawMode = on;
      stage.classList.toggle("is-drawing", on);
      const btn = $("tool-draw");
      btn.classList.toggle("is-active", on);
      btn.setAttribute("aria-pressed", String(on));
      if (on) { if (connectMode) setConnectMode(false); selectEl(null); }
    };
    // Called from an element's pointerdown while connect mode is armed: first
    // click picks the source, second click wires the arrow and exits the mode.
    const handleConnectPick = (id: string) => {
      const el = getEl(id);
      if (!el || el.type === "connector") return;
      if (!connectFrom) {
        connectFrom = id;
        markConnectSrc(id);
        return;
      }
      addConnector(connectFrom, id);
      setConnectMode(false);
    };
    const duplicateSelected = () => {
      // Duplicate the whole selection: every selected box plus any connector
      // whose BOTH endpoints are in the set (so internal wiring survives the
      // copy, re-pointed at the clones). Lone-endpoint connectors are dropped.
      const boxes = selectedBoxes();
      if (!boxes.length) return;
      const srcIds = new Set(boxes.map((b) => b.id));
      const conns = doc.elements.filter(
        (e) => e.type === "connector" &&
          srcIds.has(String(e.props?.from)) && srcIds.has(String(e.props?.to)),
      );
      // Frames stay at the back; everything else lands on top, like a fresh add.
      let zTop = maxZ(), zBot = minZ();
      const idMap: Record<string, string> = {};
      const cloneBoxIds: string[] = [];
      const fresh: El[] = [];
      for (const src of [...boxes].sort((a, b) => a.z - b.z)) {
        const nid = `e${nextElNum++}`;
        idMap[src.id] = nid;
        cloneBoxIds.push(nid);
        const clone: El = {
          ...src,
          id: nid,
          x: src.x + 24, y: src.y + 24,
          z: src.type === "frame" ? --zBot : ++zTop,
          props: { ...src.props },
        };
        doc.elements.push(clone);
        fresh.push(clone);
      }
      for (const c of conns) {
        const from = idMap[String(c.props?.from)];
        const to = idMap[String(c.props?.to)];
        if (!from || !to) continue;
        const clone: El = {
          ...c,
          id: `e${nextElNum++}`,
          props: { ...c.props, from, to },
        };
        doc.elements.push(clone);
      }
      for (const el of fresh) renderEl(el);
      drawConnectors();
      setSelection(cloneBoxIds);
      scheduleSave();
    };

    // ---------- layering (z-order) ----------
    // Restack the selected boxes. "front"/"back" jump above/below everything
    // (relative order within the selection preserved); "forward"/"backward"
    // step past one non-selected neighbour at a time, so a selected block moves
    // as a unit. Connectors live in their own SVG layer and have no z-order.
    type RestackOp = "front" | "back" | "forward" | "backward";
    const applyRestack = (elements: El[], sel: Set<string>, op: RestackOp) => {
      const boxes = elements.filter((e) => e.type !== "connector");
      if (op === "front" || op === "back") {
        const others = boxes.filter((e) => !sel.has(e.id));
        const picked = boxes.filter((e) => sel.has(e.id)).sort((a, b) => a.z - b.z);
        if (!picked.length) return;
        if (op === "front") {
          const top = others.length ? Math.max(...others.map((e) => e.z)) : 0;
          picked.forEach((e, i) => { e.z = top + 1 + i; });
        } else {
          const bot = others.length ? Math.min(...others.map((e) => e.z)) : 0;
          picked.forEach((e, i) => { e.z = bot - picked.length + i; });
        }
        return;
      }
      // forward / backward: swap z with the nearest non-selected neighbour.
      const ordered = [...boxes].sort((a, b) => a.z - b.z);
      if (op === "forward") {
        for (let i = ordered.length - 2; i >= 0; i--) {
          const cur = ordered[i];
          if (!sel.has(cur.id)) continue;
          const above = ordered[i + 1];
          if (sel.has(above.id)) continue;
          const z = cur.z; cur.z = above.z; above.z = z;
          ordered[i] = above; ordered[i + 1] = cur;
        }
      } else {
        for (let i = 1; i < ordered.length; i++) {
          const cur = ordered[i];
          if (!sel.has(cur.id)) continue;
          const below = ordered[i - 1];
          if (sel.has(below.id)) continue;
          const z = cur.z; cur.z = below.z; below.z = z;
          ordered[i] = below; ordered[i - 1] = cur;
        }
      }
    };
    const restackSelected = (op: RestackOp) => {
      const boxes = selectedBoxes();
      if (!boxes.length) return;
      applyRestack(doc.elements, new Set(boxes.map((b) => b.id)), op);
      for (const el of doc.elements) {
        if (el.type === "connector") continue;
        elNode(el).style.zIndex = String(el.z);
      }
      scheduleSave();
    };

    // ---------- align & distribute ----------
    // Operate on the selected box elements (2+ to align, 3+ to distribute).
    // Align snaps a chosen edge/center to the group's extreme or mean; distribute
    // spreads the inner elements so the gaps between them are equal.
    type AlignMode = "left" | "hcenter" | "right" | "top" | "vmiddle" | "bottom";
    const alignSelected = (mode: AlignMode) => {
      const boxes = selectedBoxes();
      if (boxes.length < 2) return;
      const lefts = boxes.map((e) => e.x);
      const rights = boxes.map((e) => e.x + e.w);
      const tops = boxes.map((e) => e.y);
      const bottoms = boxes.map((e) => e.y + e.h);
      const minL = Math.min(...lefts), maxR = Math.max(...rights);
      const minT = Math.min(...tops), maxB = Math.max(...bottoms);
      const cx = (minL + maxR) / 2, cy = (minT + maxB) / 2;
      for (const el of boxes) {
        if (mode === "left") el.x = minL;
        else if (mode === "right") el.x = maxR - el.w;
        else if (mode === "hcenter") el.x = cx - el.w / 2;
        else if (mode === "top") el.y = minT;
        else if (mode === "bottom") el.y = maxB - el.h;
        else if (mode === "vmiddle") el.y = cy - el.h / 2;
        renderEl(el);
      }
      drawConnectors();
      drawGroupBox();
      scheduleSave();
    };
    const distributeSelected = (axis: "h" | "v") => {
      const boxes = selectedBoxes();
      if (boxes.length < 3) return;
      if (axis === "h") {
        boxes.sort((a, b) => a.x - b.x);
        const left = boxes[0].x;
        const right = boxes[boxes.length - 1].x + boxes[boxes.length - 1].w;
        const totalW = boxes.reduce((s, e) => s + e.w, 0);
        const gap = (right - left - totalW) / (boxes.length - 1);
        let cursor = left;
        for (const el of boxes) { el.x = cursor; cursor += el.w + gap; renderEl(el); }
      } else {
        boxes.sort((a, b) => a.y - b.y);
        const top = boxes[0].y;
        const bottom = boxes[boxes.length - 1].y + boxes[boxes.length - 1].h;
        const totalH = boxes.reduce((s, e) => s + e.h, 0);
        const gap = (bottom - top - totalH) / (boxes.length - 1);
        let cursor = top;
        for (const el of boxes) { el.y = cursor; cursor += el.h + gap; renderEl(el); }
      }
      drawConnectors();
      drawGroupBox();
      scheduleSave();
    };

    const zoomToFit = () => {
      // Connectors have placeholder 0-geometry; fit to the real boxes only.
      const boxes = doc.elements.filter((e) => e.type !== "connector");
      if (!boxes.length) { panX = 0; panY = 0; zoom = 1; applyView(); return; }
      const xs = boxes.map((e) => e.x), ys = boxes.map((e) => e.y);
      const xe = boxes.map((e) => e.x + e.w), ye = boxes.map((e) => e.y + e.h);
      const minX = Math.min(...xs), minY = Math.min(...ys);
      const maxX = Math.max(...xe), maxY = Math.max(...ye);
      const r = stage.getBoundingClientRect();
      const pad = 80;
      zoom = Math.min(2, Math.max(0.1, Math.min(
        (r.width - pad * 2) / Math.max(maxX - minX, 1),
        (r.height - pad * 2) / Math.max(maxY - minY, 1),
      )));
      panX = (r.width - (maxX - minX) * zoom) / 2 - minX * zoom;
      panY = (r.height - (maxY - minY) * zoom) / 2 - minY * zoom;
      applyView();
    };

    // ---------- uploads ----------
    const uploadFiles = async (files: FileList | File[], at?: { x: number; y: number }) => {
      if (!boardId) return;
      let offset = 0;
      let uploaded = 0, skipped = 0;
      for (const file of Array.from(files)) {
        if (!/^image\/(png|jpeg|webp|gif)$/.test(file.type)) { skipped++; continue; }
        try {
          setSaveState("Uploading…");
          const res = await fetch(`/api/easel/upload?board=${boardId}`, {
            method: "POST",
            headers: { "Content-Type": file.type },
            body: file,
          });
          const body = await res.json();
          if (!res.ok || !body.ok) throw new Error(body?.error?.message || String(res.status));
          const dims = await imageDims(file);
          const w = Math.min(420, dims.w);
          const h = w * (dims.h / Math.max(dims.w, 1));
          const p = at ?? centerPoint();
          addElement({
            type: "image",
            x: p.x - w / 2 + offset, y: p.y - h / 2 + offset, w, h,
            props: { src: body.src, natural_w: dims.w, natural_h: dims.h },
          });
          offset += 28;
          uploaded++;
        } catch (err: any) {
          setSaveState(err?.message?.includes("quota") ? "Upload quota hit" : "Upload failed");
        }
      }
      if (uploaded) coachMark("image");
      // Dropping an unsupported file (PDF, HEIC, text…) used to do nothing at all
      // — no element, no message. Say why when nothing landed on the board.
      if (!uploaded && skipped) setSaveState("Only PNG, JPG, WebP or GIF");
    };
    const imageDims = (file: File): Promise<{ w: number; h: number }> =>
      new Promise((resolve) => {
        const url = URL.createObjectURL(file);
        const img = new Image();
        img.onload = () => { resolve({ w: img.naturalWidth, h: img.naturalHeight }); URL.revokeObjectURL(url); };
        img.onerror = () => { resolve({ w: 400, h: 300 }); URL.revokeObjectURL(url); };
        img.src = url;
      });

    let dragDepth = 0;
    stage.addEventListener("dragenter", (ev) => { ev.preventDefault(); dragDepth++; dropHint.hidden = false; });
    stage.addEventListener("dragleave", () => { if (--dragDepth <= 0) { dragDepth = 0; dropHint.hidden = true; } });
    stage.addEventListener("dragover", (ev) => ev.preventDefault());
    stage.addEventListener("drop", (ev) => {
      ev.preventDefault();
      dragDepth = 0;
      dropHint.hidden = true;
      if (ev.dataTransfer?.files?.length) {
        uploadFiles(ev.dataTransfer.files, stagePoint(ev.clientX, ev.clientY));
      }
    });

    // Paste images straight from the clipboard (screenshots, copied images).
    document.addEventListener("paste", (ev) => {
      if (workspace.hidden) return;
      const tag = (document.activeElement?.tagName || "").toLowerCase();
      if (tag === "input" || tag === "textarea" ||
        (document.activeElement as HTMLElement)?.isContentEditable) return;
      const files = Array.from(ev.clipboardData?.files ?? [])
        .filter((f) => /^image\//.test(f.type));
      if (!files.length) return;
      ev.preventDefault();
      uploadFiles(files);
    });

    // ---------- agent ----------
    // True when the feed is scrolled to (or very near) the bottom. Used to
    // "stick" to the latest output only when the user hasn't scrolled up to
    // read earlier messages — otherwise a streaming run yanks them back down.
    const feedAtBottom = () =>
      agentFeed.scrollHeight - agentFeed.scrollTop - agentFeed.clientHeight <= 48;

    const addFeedItem = (cls: string, text: string, force = false) => {
      agentEmpty.hidden = true;
      const stick = force || feedAtBottom();
      const div = document.createElement("div");
      div.className = `easel-feed-item ${cls}`;
      div.textContent = text;
      agentFeed.appendChild(div);
      if (stick) agentFeed.scrollTop = agentFeed.scrollHeight;
      return div;
    };

    const startPolling = () => {
      if (pollTimer) return;
      pollTimer = window.setInterval(() => refetchBoard(true).catch(() => {}), 1000);
    };
    const stopPolling = () => {
      if (pollTimer) { window.clearInterval(pollTimer); pollTimer = null; }
    };

    // A backgrounded tab can't show live updates, so the 1Hz reconcile poll is
    // pure wasted network while hidden — pause it on tab-hide and resume with an
    // immediate catch-up refetch when the tab returns, but only if the agent run
    // is still live. The SSE stream stays connected in the background, so no
    // agent events are missed; the catch-up refetch reconciles any board doc
    // changes that landed while the poll was paused.
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        if (agentRunning) stopPolling();
      } else if (agentRunning) {
        refetchBoard(true).catch(() => {});
        startPolling();
      }
    });

    agentForm.addEventListener("submit", async (ev) => {
      ev.preventDefault();
      const prompt = agentInput.value.trim();
      if (!prompt || !boardId || agentRunning) return;
      coachMark("agent");
      // flush pending edits so the agent sees the latest board
      if (dirty) await saveNow();

      agentRunning = true;
      agentSend.disabled = true;
      setAgentLive(true);
      addFeedItem("easel-feed-user", prompt, true);
      agentInput.value = "";
      autoGrowInput();
      startPolling();

      try {
        const body = await api(`/api/easel/agent`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ board_id: boardId, prompt }),
        });
        const sessionId = body.session_id;
        await streamSession(sessionId);
      } catch (err: any) {
        addFeedItem("easel-feed-error",
          err?.code === "daily_quota_exceeded"
            ? "Daily agent quota reached. Come back tomorrow."
            : `Could not start the agent: ${err.message}`);
      } finally {
        agentRunning = false;
        agentSend.disabled = false;
        setAgentLive(false);
        stopPolling();
        refetchBoard(true).catch(() => {});
      }
    });

    // Warn before leaving only when something would actually be lost: a live
    // agent run (abandoning a session the user is paying for and watching) or
    // edits stuck offline after a failed save. Normal editing autosaves within
    // ~1s, so transient dirty state never triggers the prompt.
    window.addEventListener("beforeunload", (ev) => {
      if (!agentRunning && !unsynced) return;
      ev.preventDefault();
      ev.returnValue = "";
    });

    // Grow the prompt box with its content (up to the CSS max-height, then it
    // scrolls) so multi-line Shift+Enter prompts are fully visible instead of
    // cramped in the 2-row box. Reset to "auto" first so it can also shrink.
    const autoGrowInput = () => {
      // Empty field: drop the inline height so the CSS min-height resting size
      // wins. (scrollHeight would otherwise measure the multi-line placeholder
      // and leave the box taller than its resting state after a send.)
      if (!agentInput.value) { agentInput.style.height = ""; return; }
      // Collapse to 0 first so scrollHeight is the true content height; CSS
      // min-height supplies the resting floor, max-height caps + scrolls.
      agentInput.style.height = "0px";
      agentInput.style.height = `${Math.min(140, agentInput.scrollHeight)}px`;
    };
    agentInput.addEventListener("input", autoGrowInput);

    // Enter sends the prompt; Shift+Enter inserts a newline (standard chat input).
    // requestSubmit fires the form's submit handler (unlike .submit()); the
    // isComposing guard keeps IME candidate selection from sending early.
    agentInput.addEventListener("keydown", (ev) => {
      if (ev.key === "Enter" && !ev.shiftKey && !ev.isComposing) {
        ev.preventDefault();
        agentForm.requestSubmit();
      }
    });

    const streamSession = (sessionId: string) =>
      new Promise<void>((resolve) => {
        const es = new EventSource(`/api/easel/stream/${sessionId}`);
        let thoughtNode: HTMLElement | null = null;
        const finish = () => { es.close(); resolve(); };
        es.addEventListener("thought", (ev) => {
          const data = JSON.parse((ev as MessageEvent).data);
          const stick = feedAtBottom();
          if (!thoughtNode) thoughtNode = addFeedItem("easel-feed-thought", "");
          thoughtNode.textContent = data.text;
          if (stick) agentFeed.scrollTop = agentFeed.scrollHeight;
        });
        es.addEventListener("say", (ev) => {
          const data = JSON.parse((ev as MessageEvent).data);
          thoughtNode = null;
          addFeedItem("easel-feed-thought", data.text);
        });
        es.addEventListener("tool", (ev) => {
          const data = JSON.parse((ev as MessageEvent).data);
          thoughtNode = null;
          addFeedItem("easel-feed-tool", data.label);
          refetchBoard(true).catch(() => {});
        });
        es.addEventListener("done", (ev) => {
          const data = JSON.parse((ev as MessageEvent).data);
          addFeedItem("easel-feed-done", data.summary || "Done.");
          finish();
        });
        es.addEventListener("error_event", (ev) => {
          const data = JSON.parse((ev as MessageEvent).data);
          addFeedItem("easel-feed-error", data.message || "The agent hit an error.");
          finish();
        });
        es.onerror = () => {
          // EventSource reconnects automatically; only give up when the
          // session has been closed server-side (readyState CLOSED).
          if (es.readyState === EventSource.CLOSED) finish();
        };
        // hard ceiling so the UI never hangs forever
        window.setTimeout(finish, 10 * 60 * 1000);
      });

    $("agent-collapse").addEventListener("click", () => {
      // Reflect the toggled state on the button: collapsed shows "+" (expand),
      // expanded shows "–" (collapse). Without this the button stayed "–" after
      // collapsing, giving no hint it reopens the panel.
      const collapsed = $("agent-dock").classList.toggle("is-collapsed");
      const btn = $("agent-collapse");
      btn.textContent = collapsed ? "+" : "–";
      btn.setAttribute("aria-label", collapsed ? "Expand agent panel" : "Collapse agent panel");
      btn.setAttribute("aria-expanded", String(!collapsed));
    });

    // ---------- toolbar ----------
    $("tool-text").addEventListener("click", addText);
    $("tool-sticky").addEventListener("click", addSticky);
    $("tool-frame").addEventListener("click", addFrame);
    $("tool-shape").addEventListener("click", () => addShape());
    $("tool-connect").addEventListener("click", () => setConnectMode(!connectMode));
    $("tool-draw").addEventListener("click", () => setDrawMode(!drawMode));
    $("tool-upload").addEventListener("click", () => fileInput.click());
    $("tool-zoom-fit").addEventListener("click", zoomToFit);
    // Clicking the zoom badge resets to 100%, anchored on the stage center
    // (same zoom-around-a-point math as the wheel handler) so the view stays put.
    zoomBadge.addEventListener("click", () => {
      const r = stage.getBoundingClientRect();
      const cx = r.width / 2, cy = r.height / 2;
      panX = cx - ((cx - panX) / zoom) * 1;
      panY = cy - ((cy - panY) / zoom) * 1;
      zoom = 1;
      applyView();
    });
    // Keep clicks on the palette from reaching the stage, which would
    // deselect the sticky (and start a pan) before the recolor click fires.
    swatches.addEventListener("pointerdown", (ev) => ev.stopPropagation());
    // Recolor the selected sticky (background) or shape (fill) from the palette.
    swatches.addEventListener("click", (ev) => {
      const btn = (ev.target as HTMLElement).closest<HTMLButtonElement>(".easel-swatch");
      if (!btn || !selectedId || !btn.dataset.color) return;
      const el = getEl(selectedId);
      if (!el) return;
      if (el.type === "sticky") {
        el.props.color = btn.dataset.color;
        // Carry the choice forward as the default for the next new sticky.
        lastStickyColor = btn.dataset.color;
      } else if (el.type === "shape") {
        el.props.fill = btn.dataset.color;
      } else return;
      renderEl(el);
      reflectSwatches();
      scheduleSave();
    });
    // Flip the selected shape between rectangle and ellipse.
    shapeKind.addEventListener("click", () => {
      if (!selectedId) return;
      const el = getEl(selectedId);
      if (!el || el.type !== "shape") return;
      el.props.kind = el.props.kind === "ellipse" ? "rect" : "ellipse";
      renderEl(el);
      reflectSwatches();
      scheduleSave();
    });
    // Align/distribute bar: keep clicks off the stage, dispatch by data attr.
    alignbar.addEventListener("pointerdown", (ev) => ev.stopPropagation());
    alignbar.addEventListener("click", (ev) => {
      const btn = (ev.target as HTMLElement).closest<HTMLButtonElement>("button");
      if (!btn || btn.disabled) return;
      if (btn.dataset.align) alignSelected(btn.dataset.align as AlignMode);
      else if (btn.dataset.dist) distributeSelected(btn.dataset.dist as "h" | "v");
    });
    // Connector style bar: recolour, flip arrow/line, or delete the picked
    // connector. pointerdown is swallowed so a click here never deselects.
    connbar.addEventListener("pointerdown", (ev) => ev.stopPropagation());
    connbar.addEventListener("click", (ev) => {
      const c = selectedConnectorId ? getEl(selectedConnectorId) : null;
      if (!c) return;
      const target = ev.target as HTMLElement;
      const colorBtn = target.closest<HTMLButtonElement>(".easel-conn-color");
      if (colorBtn && colorBtn.dataset.color) {
        c.props.color = colorBtn.dataset.color;
        drawConnectors(); reflectConnbar(); scheduleSave(); return;
      }
      if (target.closest("#conn-style")) {
        c.props.style = c.props.style === "line" ? "arrow" : "line";
        drawConnectors(); reflectConnbar(); scheduleSave(); return;
      }
      if (target.closest("#conn-del")) deleteConnector(c.id);
    });
    $("tool-keys").addEventListener("click", () => { setKeysOverlay(keysOverlay.hidden); });
    // ---------- templates picker wiring ----------
    $("tool-templates").addEventListener("click", () => setTemplatesModal(templatesModal.hidden));
    $("empty-templates").addEventListener("click", () => setTemplatesModal(true));
    $("templates-close").addEventListener("click", () => setTemplatesModal(false));
    // Click outside the panel (on the backdrop) closes the modal.
    templatesModal.addEventListener("click", (ev) => {
      if (ev.target === templatesModal) setTemplatesModal(false);
    });
    templatesModal.querySelectorAll<HTMLButtonElement>("[data-template]").forEach((card) => {
      card.addEventListener("click", () => {
        const key = card.dataset.template;
        if (key) { applyTemplate(key); setTemplatesModal(false); }
      });
    });
    // ---------- SVG export ----------
    // Serialise the board (or the current 2+ selection) to a portable, native
    // SVG: rect/ellipse/text/line/image, not <foreignObject>, so the file opens
    // faithfully in Illustrator/Figma/Inkscape as well as a browser. Mirrors the
    // visual mapping of the no-JS render route (functions/easel/render/[id].ts):
    // same element geometry, same background palette, same connector edge-clip.
    const EXPORT_PAD = 40;
    const EXPORT_FONT = "-apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif";
    const EXPORT_BG: Record<string, string> = { white: "#ffffff", paper: "#fdfbf7", dark: "#1a1a1a" };
    // Color props are user/agent-influencable strings; allow only simple color
    // syntax (matches safeColor in the render route) so a hostile value can't
    // inject markup into an attribute.
    const safeColorE = (v: unknown, fb: string): string => {
      const s = String(v ?? "");
      return /^(#[0-9a-fA-F]{3,8}|[a-zA-Z]{3,20}|rgba?\([0-9.,\s%]+\)|hsla?\([0-9.,\s%deg]+\))$/.test(s) ? s : fb;
    };
    const xmlEsc = (s: unknown): string =>
      String(s ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
    const measureCtx = document.createElement("canvas").getContext("2d")!;
    const wrapLines = (text: unknown, maxW: number, fontPx: number, weight: number): string[] => {
      measureCtx.font = `${weight} ${fontPx}px ${EXPORT_FONT}`;
      const w = (s: string) => measureCtx.measureText(s).width;
      const lines: string[] = [];
      for (const para of String(text ?? "").split("\n")) {
        let line = "";
        for (let word of para.split(" ")) {
          // Hard-break a single word wider than the box.
          while (w(word) > maxW && word.length > 1) {
            let i = 1;
            while (i < word.length && w(word.slice(0, i + 1)) <= maxW) i++;
            if (line) { lines.push(line); line = ""; }
            lines.push(word.slice(0, i));
            word = word.slice(i);
          }
          const test = line ? line + " " + word : word;
          if (line && w(test) > maxW) { lines.push(line); line = word; }
          else line = test;
        }
        lines.push(line);
      }
      return lines;
    };
    type TextOpts = { x: number; w: number; top: number; height: number; fontPx: number; lh: number;
      color: string; weight: number; align: string; vAlign: "top" | "middle"; padX: number; padY: number };
    const textBlock = (lines: string[], o: TextOpts): string => {
      if (!lines.length) return "";
      const lineH = o.fontPx * o.lh;
      const anchor = o.align === "center" ? "middle" : o.align === "right" ? "end" : "start";
      const tx = o.align === "center" ? o.x + o.w / 2 : o.align === "right" ? o.x + o.w - o.padX : o.x + o.padX;
      const totalH = lines.length * lineH;
      const firstBase = o.vAlign === "middle"
        ? o.top + o.height / 2 - totalH / 2 + o.fontPx
        : o.top + o.padY + o.fontPx;
      const tspans = lines.map((ln, i) =>
        `<tspan x="${tx.toFixed(1)}"${i === 0 ? ` y="${firstBase.toFixed(1)}"` : ` dy="${lineH.toFixed(1)}"`}>${xmlEsc(ln) || " "}</tspan>`,
      ).join("");
      return `<text font-family="${EXPORT_FONT}" font-size="${o.fontPx}" font-weight="${o.weight}" fill="${o.color}" text-anchor="${anchor}">${tspans}</text>`;
    };
    // Clip an endpoint to a box's border along the centre-to-centre line so the
    // arrow touches the edge, not the middle (same math as the render route).
    const borderPtE = (b: { x: number; y: number; w: number; h: number }, tx: number, ty: number) => {
      const cx = b.x + b.w / 2, cy = b.y + b.h / 2;
      const dx = tx - cx, dy = ty - cy;
      if (!dx && !dy) return { x: cx, y: cy };
      const s = 1 / Math.max(Math.abs(dx) / (b.w / 2), Math.abs(dy) / (b.h / 2));
      return { x: cx + dx * s, y: cy + dy * s };
    };
    const buildBoardSvg = (imgMap?: Map<string, string>): string | null => {
      const selBoxes = selectedBoxes();
      const useSel = selBoxes.length >= 2;
      const boxEls = useSel ? selBoxes : doc.elements.filter((e) => e.type !== "connector");
      if (!boxEls.length) return null;
      const idSet = new Set(boxEls.map((e) => e.id));
      // Bounding box (frame labels hang 28u above their frame).
      let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
      for (const el of boxEls) {
        minX = Math.min(minX, el.x);
        minY = Math.min(minY, el.y - (el.type === "frame" ? 28 : 0));
        maxX = Math.max(maxX, el.x + el.w);
        maxY = Math.max(maxY, el.y + el.h);
      }
      const W = Math.ceil(maxX - minX + EXPORT_PAD * 2);
      const H = Math.ceil(maxY - minY + EXPORT_PAD * 2);
      const ox = -minX + EXPORT_PAD, oy = -minY + EXPORT_PAD;
      const shifted = new Map<string, { x: number; y: number; w: number; h: number }>();
      for (const el of boxEls) shifted.set(el.id, { x: el.x + ox, y: el.y + oy, w: el.w, h: el.h });

      const defs: string[] = [];
      const body: string[] = [];
      let clipN = 0;

      for (const el of [...boxEls].sort((a, b) => a.z - b.z)) {
        const g = shifted.get(el.id)!;
        const p = el.props ?? {};
        const X = g.x.toFixed(1), Y = g.y.toFixed(1), Wd = g.w.toFixed(1), Ht = g.h.toFixed(1);
        if (el.type === "image") {
          const src = typeof p.src === "string" && /^\/i-easel\/img\//.test(p.src) ? p.src : "";
          if (!src) continue;
          const cid = `imgclip-${clipN++}`;
          // SVG export keeps the remote /i-easel URL (portable, small file). PNG
          // export passes imgMap with the image already inlined as a data URI, so
          // the SVG is self-contained and rasterizes without the sandboxed
          // SVG-in-<img> blocking the external load (and without tainting canvas).
          const href = imgMap?.get(src) ?? (location.origin + src);
          defs.push(`<clipPath id="${cid}"><rect x="${X}" y="${Y}" width="${Wd}" height="${Ht}" rx="6"/></clipPath>`);
          body.push(`<image x="${X}" y="${Y}" width="${Wd}" height="${Ht}" preserveAspectRatio="xMidYMid slice" clip-path="url(#${cid})" href="${xmlEsc(href)}"/>`);
        } else if (el.type === "text") {
          const fontPx = Number(p.size) || 28;
          const weight = Number(p.weight) || 600;
          const color = safeColorE(p.color, "#1a1a1a");
          const align = ["left", "center", "right"].includes(String(p.align)) ? String(p.align) : "left";
          const lines = wrapLines(p.text, g.w - 12, fontPx, weight);
          body.push(textBlock(lines, { x: g.x, w: g.w, top: g.y, height: g.h, fontPx, lh: 1.25, color, weight, align, vAlign: "top", padX: 6, padY: 4 }));
        } else if (el.type === "sticky") {
          const color = safeColorE(p.color, "#fff3a3");
          const lines = wrapLines(p.text, g.w - 24, 15, 400);
          body.push(`<rect x="${X}" y="${Y}" width="${Wd}" height="${Ht}" rx="8" fill="${color}"/>`);
          body.push(textBlock(lines, { x: g.x, w: g.w, top: g.y, height: g.h, fontPx: 15, lh: 1.4, color: "#1a1a1a", weight: 400, align: "left", vAlign: "top", padX: 12, padY: 12 }));
        } else if (el.type === "frame") {
          body.push(`<rect x="${X}" y="${Y}" width="${Wd}" height="${Ht}" rx="12" fill="rgba(255,255,255,0.35)" stroke="rgba(0,0,0,0.35)" stroke-width="1.5"/>`);
          const label = String(p.label ?? "").toUpperCase();
          if (label) body.push(`<text x="${X}" y="${(g.y - 6).toFixed(1)}" font-family="${EXPORT_FONT}" font-size="13" font-weight="600" letter-spacing="0.5" fill="rgba(0,0,0,0.7)">${xmlEsc(label)}</text>`);
        } else if (el.type === "shape") {
          const fill = safeColorE(p.fill, "#bcdcff");
          const stroke = safeColorE(p.stroke, "#3a4a8c");
          if (p.kind === "ellipse") {
            body.push(`<ellipse cx="${(g.x + g.w / 2).toFixed(1)}" cy="${(g.y + g.h / 2).toFixed(1)}" rx="${(g.w / 2).toFixed(1)}" ry="${(g.h / 2).toFixed(1)}" fill="${fill}" stroke="${stroke}" stroke-width="2"/>`);
          } else {
            body.push(`<rect x="${X}" y="${Y}" width="${Wd}" height="${Ht}" rx="10" fill="${fill}" stroke="${stroke}" stroke-width="2"/>`);
          }
          const lines = wrapLines(p.text, g.w - 20, 15, 600);
          body.push(textBlock(lines, { x: g.x, w: g.w, top: g.y, height: g.h, fontPx: 15, lh: 1.35, color: "#1a1a1a", weight: 600, align: "center", vAlign: "middle", padX: 10, padY: 10 }));
        }
      }

      // Connectors whose BOTH endpoints are in the exported set. One marker per
      // distinct colour (context-stroke is not honoured by every SVG viewer).
      const markerByColor = new Map<string, string>();
      const lines: string[] = [];
      for (const el of doc.elements) {
        if (el.type !== "connector") continue;
        const p = el.props ?? {};
        if (!idSet.has(String(p.from)) || !idSet.has(String(p.to))) continue;
        const a = shifted.get(String(p.from)), b = shifted.get(String(p.to));
        if (!a || !b) continue;
        const s = borderPtE(a, b.x + b.w / 2, b.y + b.h / 2);
        const e = borderPtE(b, a.x + a.w / 2, a.y + a.h / 2);
        const color = safeColorE(p.color, "#5b6472");
        let marker = "";
        if (p.style !== "line") {
          let mid = markerByColor.get(color);
          if (!mid) {
            mid = `ar-${markerByColor.size}`;
            markerByColor.set(color, mid);
            defs.push(`<marker id="${mid}" markerWidth="9" markerHeight="9" refX="7.5" refY="4.5" orient="auto" markerUnits="userSpaceOnUse"><path d="M0,0 L9,4.5 L0,9 z" fill="${color}"/></marker>`);
          }
          marker = ` marker-end="url(#${mid})"`;
        }
        lines.push(`<line x1="${s.x.toFixed(1)}" y1="${s.y.toFixed(1)}" x2="${e.x.toFixed(1)}" y2="${e.y.toFixed(1)}" stroke="${color}" stroke-width="2.5" stroke-linecap="round"${marker}/>`);
      }

      const bg = EXPORT_BG[doc.background] ?? EXPORT_BG.white;
      return [
        `<?xml version="1.0" encoding="UTF-8"?>`,
        `<svg xmlns="http://www.w3.org/2000/svg" width="${W}" height="${H}" viewBox="0 0 ${W} ${H}">`,
        defs.length ? `<defs>${defs.join("")}</defs>` : "",
        `<rect x="0" y="0" width="${W}" height="${H}" fill="${bg}"/>`,
        lines.join(""),   // connectors behind the boxes, as on the canvas
        body.join(""),
        `</svg>`,
      ].filter(Boolean).join("\n");
    };
    const exportBaseName = () => (titleInput.value.trim() || "easel-board")
      .toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "").slice(0, 60) || "easel-board";
    const downloadHref = (href: string, filename: string) => {
      const a = document.createElement("a");
      a.href = href; a.download = filename;
      document.body.appendChild(a); a.click(); a.remove();
    };
    const flashExport = (text: string, ms = 1200) => {
      const btn = $("tool-export");
      const prev = btn.dataset.label ?? btn.textContent ?? "Export";
      btn.dataset.label = prev;
      btn.textContent = text;
      window.setTimeout(() => { btn.textContent = prev; delete btn.dataset.label; }, ms);
    };
    const exportBoard = () => {
      const svg = buildBoardSvg();
      if (!svg) { flashExport("Empty board"); return; }
      const blob = new Blob([svg], { type: "image/svg+xml;charset=utf-8" });
      const url = URL.createObjectURL(blob);
      downloadHref(url, `${exportBaseName()}.svg`);
      window.setTimeout(() => URL.revokeObjectURL(url), 1000);
      flashExport("Exported");
    };
    // PNG raster export. The board's images live at same-origin /i-easel/img/...
    // so we fetch each, inline it as a data URI inside the SVG, then draw that
    // self-contained SVG onto a 2x canvas and download a PNG. Same-origin +
    // data-URI means the canvas is never tainted, so toDataURL succeeds.
    const exportPng = async () => {
      const srcs = new Set<string>();
      for (const el of doc.elements) {
        if (el.type !== "image") continue;
        const s = el.props?.src;
        if (typeof s === "string" && /^\/i-easel\/img\//.test(s)) srcs.add(s);
      }
      try {
        flashExport("Rendering…", 60000);
        const imgMap = new Map<string, string>();
        await Promise.all([...srcs].map(async (s) => {
          const resp = await fetch(location.origin + s);
          if (!resp.ok) return;
          const blob = await resp.blob();
          const dataUrl = await new Promise<string>((res, rej) => {
            const fr = new FileReader();
            fr.onload = () => res(String(fr.result));
            fr.onerror = () => rej(new Error("read"));
            fr.readAsDataURL(blob);
          });
          imgMap.set(s, dataUrl);
        }));
        const svg = buildBoardSvg(imgMap);
        if (!svg) { flashExport("Empty board"); return; }
        const url = URL.createObjectURL(new Blob([svg], { type: "image/svg+xml;charset=utf-8" }));
        const img = new Image();
        await new Promise<void>((res, rej) => {
          img.onload = () => res();
          img.onerror = () => rej(new Error("raster"));
          img.src = url;
        });
        const scale = 2;
        const w = img.naturalWidth || 1, h = img.naturalHeight || 1;
        const canvas = document.createElement("canvas");
        canvas.width = Math.round(w * scale);
        canvas.height = Math.round(h * scale);
        const ctx = canvas.getContext("2d");
        if (!ctx) { URL.revokeObjectURL(url); flashExport("Export failed", 1500); return; }
        ctx.scale(scale, scale);
        ctx.drawImage(img, 0, 0);
        URL.revokeObjectURL(url);
        downloadHref(canvas.toDataURL("image/png"), `${exportBaseName()}.png`);
        flashExport("Exported");
      } catch {
        flashExport("Export failed", 1500);
      }
    };

    // Export is a small PNG/SVG menu (fixed-positioned so it never clips inside
    // the topbar's mobile horizontal-scroll strip). Dismisses on outside click,
    // Esc, or resize-away.
    const exportMenu = $("export-menu");
    let exportMenuOpen = false;
    const positionExportMenu = () => {
      const r = $("tool-export").getBoundingClientRect();
      exportMenu.style.top = `${Math.round(r.bottom + 6)}px`;
      exportMenu.style.right = `${Math.round(window.innerWidth - r.right)}px`;
    };
    const closeExportMenu = () => {
      if (!exportMenuOpen) return;
      exportMenuOpen = false;
      exportMenu.hidden = true;
      $("tool-export").setAttribute("aria-expanded", "false");
    };
    const openExportMenu = () => {
      exportMenuOpen = true;
      positionExportMenu();
      exportMenu.hidden = false;
      $("tool-export").setAttribute("aria-expanded", "true");
    };
    $("tool-export").addEventListener("click", (e) => {
      e.stopPropagation();
      exportMenuOpen ? closeExportMenu() : openExportMenu();
    });
    document.addEventListener("click", (e) => {
      if (exportMenuOpen && !exportMenu.contains(e.target as Node)) closeExportMenu();
    });
    document.addEventListener("keydown", (e) => {
      if (exportMenuOpen && e.key === "Escape") { e.stopImmediatePropagation(); e.preventDefault(); closeExportMenu(); }
    }, true);
    window.addEventListener("resize", () => { if (exportMenuOpen) positionExportMenu(); });
    $("export-png").addEventListener("click", () => { closeExportMenu(); void exportPng(); });
    $("export-svg").addEventListener("click", () => { closeExportMenu(); exportBoard(); });

    // Copy with a fallback: the async Clipboard API throws when the document
    // isn't focused (NotAllowedError) or is missing in some embedded webviews,
    // which used to fail the Share click silently. Fall back to a hidden
    // textarea + execCommand so the link still copies, and report failure.
    const copyText = async (text: string): Promise<boolean> => {
      try {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(text);
          return true;
        }
      } catch { /* fall through to the legacy path */ }
      try {
        const ta = document.createElement("textarea");
        ta.value = text;
        ta.setAttribute("readonly", "");
        ta.style.position = "fixed";
        ta.style.top = "-1000px";
        ta.style.opacity = "0";
        document.body.appendChild(ta);
        ta.select();
        const ok = document.execCommand("copy");
        ta.remove();
        return ok;
      } catch {
        return false;
      }
    };
    $("tool-share").addEventListener("click", async () => {
      if (!boardId) return;
      const btn = $("tool-share");
      const prev = btn.textContent;
      const ok = await copyText(`${location.origin}/easel/?b=${boardId}`);
      btn.textContent = ok ? "Copied" : "Copy failed";
      window.setTimeout(() => { btn.textContent = prev; }, 1200);
    });
    const reflectPublish = () => {
      const btn = $("tool-publish");
      btn.textContent = isPublic ? "Unpublish" : "Publish";
      btn.title = isPublic
        ? "This board is in the public gallery. Click to remove it."
        : "Show this board in the public gallery";
      btn.classList.toggle("is-public", isPublic);
    };
    $("tool-publish").addEventListener("click", async () => {
      if (!boardId) return;
      try {
        const body = await api(`/api/easel/board/${boardId}/publish`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ public: !isPublic }),
        });
        isPublic = body.is_public;
        reflectPublish();
      } catch {
        // A silent failure here is dangerous: publish toggles whether the board
        // is in the public gallery, so the user must not be left guessing. Mirror
        // the Share button: flash the outcome, then restore the true (unchanged)
        // state via reflectPublish().
        const btn = $("tool-publish");
        btn.textContent = "Failed";
        window.setTimeout(reflectPublish, 1200);
      }
    });
    fileInput.addEventListener("change", () => {
      if (fileInput.files?.length) uploadFiles(fileInput.files);
      fileInput.value = "";
    });
    titleInput.addEventListener("input", () => { setDocTitle(titleInput.value); scheduleSave(); });
    // Leaving the title blank reads as "no title"; the server keeps the old one
    // (COALESCE), so on blur restore the input + tab title to that kept value
    // instead of stranding the user on an empty field.
    titleInput.addEventListener("blur", () => {
      if (!titleInput.value.trim() && currentTitle) {
        titleInput.value = currentTitle;
        setDocTitle(currentTitle);
      }
    });

    // ---------- boot ----------
    const openBoard = async (id: string) => {
      boardId = id;
      const body = await api(`/api/easel/board/${id}`);
      version = body.version;
      doc = body.doc;
      undoStack = [];
      redoStack = [];
      undoBase = JSON.stringify(doc.elements);
      isPublic = body.is_public === true;
      reflectPublish();
      currentTitle = body.title;
      titleInput.value = body.title;
      setDocTitle(body.title);
      hero.hidden = true;
      workspace.hidden = false;
      renderDoc();
      // Restore the saved viewport for returning visits; fit-all only on the
      // first open of a board (or if the saved view was cleared).
      const savedView = loadViewport(id);
      if (savedView) {
        panX = savedView.panX;
        panY = savedView.panY;
        zoom = savedView.zoom;
        applyView();
      } else {
        zoomToFit();
      }
      rememberBoard(id, body.title);
      initCoach();
    };

    const newBoardBtn = $<HTMLButtonElement>("new-board-btn");
    newBoardBtn.addEventListener("click", async () => {
      // The primary CTA used to swallow a rejected create (flaky network, server
      // hiccup, daily quota): the button just sat there and the rejection died
      // in the console. Worse, a double-click fired two POSTs and created two
      // boards. Disable while in flight, and on failure reuse the load-error
      // note (the same affordance the bad-?b= path uses) and re-enable.
      if (newBoardBtn.disabled) return;
      newBoardBtn.disabled = true;
      const note = $("easel-load-error");
      note.hidden = true;
      try {
        const body = await api(`/api/easel/board`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({}),
        });
        history.replaceState(null, "", `/easel/?b=${body.id}`);
        await openBoard(body.id);
        // On success openBoard hides the hero (and this button with it), so the
        // disabled state never shows; no need to re-enable.
      } catch (err: any) {
        note.textContent = `Couldn't start a board: ${err.message}. Please try again.`;
        note.hidden = false;
        newBoardBtn.disabled = false;
      }
    });

    const params = new URLSearchParams(location.search);
    const b = params.get("b");
    if (b && /^el_[a-z0-9]{8,22}$/.test(b)) {
      // Give a shared-link open immediate feedback: the fetch can take a beat,
      // and without this the page just sits on the landing hero looking idle.
      // is-loading also hides the landing actions so a slow load can't catch a
      // duplicate "Start a board" click. openBoard hides the whole hero on
      // success, so the loading state only ever shows during the in-flight open.
      hero.classList.add("is-loading");
      $("easel-load-status").hidden = false;
      openBoard(b).catch(() => {
        // A shared link to a deleted or wrong board used to dump the user on
        // the landing view with no explanation. Surface why and drop the bad
        // ?b= from the URL so a refresh doesn't retry it.
        hero.classList.remove("is-loading");
        $("easel-load-status").hidden = true;
        history.replaceState(null, "", "/easel/");
        const note = $("easel-load-error");
        note.textContent = "That board couldn't be opened — it may have been deleted, or the link is wrong. Start a new board below.";
        note.hidden = false;
        renderRecent();
      });
    } else {
      renderRecent();
    }
    applyView();
  </script>
</BaseLayout>
