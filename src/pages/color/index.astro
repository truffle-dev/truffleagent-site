---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Color · Convert HEX, RGB, HSL, OKLCH and Check Contrast";
const description =
  "Paste any CSS color and read it back as HEX, RGB, HSL, and OKLCH, with a live swatch and WCAG contrast against white and black. Works offline. No accounts, no servers, no trackers.";
const ogImage = "/img/og.jpg";
const canonical = "https://truffleagent.com/color/";

const webAppJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Color Converter and Contrast Checker",
  alternateName: ["HEX to RGB", "RGB to HSL", "OKLCH Converter", "WCAG Contrast Checker"],
  url: canonical,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Any (Web)",
  browserRequirements: "Requires JavaScript",
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  description,
  featureList: [
    "Parse any CSS color: HEX, rgb(), hsl(), oklch(), or a named color",
    "Convert to HEX, RGB, HSL, and OKLCH",
    "Copy any format with one click",
    "Live swatch preview",
    "WCAG contrast ratio against white and black",
    "AA and AAA pass indicators for normal and large text",
    "Shareable URL: the color lives in the link",
    "Works offline, no servers, no trackers",
  ],
  author: "Truffle",
};

const faq = [
  {
    q: "What is OKLCH and why is it here?",
    a: "OKLCH is a perceptual color space: lightness, chroma, and hue laid out so that a fixed step looks like a fixed step to the eye, which HSL never managed. CSS supports it natively now, so it is the modern way to pick a palette where every swatch reads as equally bright. Most converters still stop at HSL; this one carries the OKLCH triplet straight through.",
  },
  {
    q: "How is the contrast ratio calculated?",
    a: "By the WCAG 2 formula. Each color's relative luminance comes from its linearized sRGB channels weighted 0.2126 red, 0.7152 green, 0.0722 blue, then the ratio is (lighter + 0.05) divided by (darker + 0.05). The result runs from 1:1 for two identical colors up to 21:1 for pure black on pure white.",
  },
  {
    q: "What do AA and AAA mean?",
    a: "They are the two WCAG conformance bars. AA wants 4.5:1 for normal text and 3:1 for large text (18.66px bold or 24px regular and up). AAA is stricter: 7:1 for normal and 4.5:1 for large. The badges here show, for your color as a foreground, which bars it clears against a white page and a black page.",
  },
  {
    q: "Can I paste a named color like rebeccapurple?",
    a: "Yes. Anything the browser's own CSS parser accepts works: named colors, #abc and #aabbcc hex, rgb() and rgba(), hsl() and hsla(), and oklch(). Parsing runs through the browser's color engine, so if a stylesheet would accept it, this page will too.",
  },
  {
    q: "Does it track me or need a connection?",
    a: "No. No ads, no analytics, no third-party scripts, no outbound requests. Every conversion runs in your browser, and after the first load it works with no network at all.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<BaseLayout title={title} description={description} ogImage={ogImage} canonical={canonical}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(webAppJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <main class="c-page">
    <header class="c-topbar">
      <div class="c-topbar-inner">
        <div class="c-brand">
          <span class="c-brand-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="9" />
              <path d="M12 3a9 9 0 0 0 0 18" />
              <circle cx="9" cy="9" r="1.2" fill="currentColor" stroke="none" />
              <circle cx="15" cy="9" r="1.2" fill="currentColor" stroke="none" />
              <circle cx="9.5" cy="15" r="1.2" fill="currentColor" stroke="none" />
            </svg>
          </span>
          <span class="c-brand-name">Color</span>
        </div>
        <div class="c-topbar-actions">
          <button id="share-btn" type="button" class="c-btn c-btn-ghost">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12v8h16v-8" /><path d="M12 3v13" /><path d="M7 8l5-5 5 5" /></svg>
            <span>Share</span>
          </button>
        </div>
      </div>
    </header>

    <section class="c-input-row">
      <label class="c-field">
        <span class="c-field-label">Type or paste a color</span>
        <input id="color-input" type="text" spellcheck="false" autocomplete="off" autocapitalize="off" placeholder="#3a5b8c, rebeccapurple, rgb(58 91 140), hsl(214 41% 39%)" />
      </label>
      <div class="c-input-aux">
        <label class="c-picker" title="Pick a color">
          <input id="color-picker" type="color" value="#3a5b8c" aria-label="Color picker" />
        </label>
        <button id="random-btn" type="button" class="c-btn c-btn-ghost">Random</button>
      </div>
    </section>

    <section class="c-result" id="c-result">
      <div class="c-swatch" id="c-swatch" aria-hidden="true">
        <span class="c-swatch-sample" id="c-sample-text">Aa</span>
      </div>
      <ul class="c-formats" id="c-formats" aria-live="polite"></ul>
    </section>

    <section class="c-contrast" id="c-contrast" hidden>
      <h2>Contrast</h2>
      <p class="c-contrast-note">This color as text, on a white page and a black page. AA needs 4.5:1 for normal text and 3:1 for large; AAA needs 7:1 and 4.5:1.</p>
      <div class="c-contrast-grid" id="c-contrast-grid"></div>
    </section>

    <section class="c-why">
      <h2>Why this exists</h2>
      <p>
        A color converter is easy to find. One that carries OKLCH and tells you the WCAG contrast in
        the same glance is rarer. Paste any CSS color and this page hands back all four notations and
        the two numbers that decide whether text will actually be readable: the ratio against white
        and the ratio against black. The color lives in the URL, so the link you copy reopens exactly
        what you saw. Nothing leaves your browser.
      </p>
    </section>

    <section class="c-faq" id="faq">
      <h2>Frequently asked questions</h2>
      <dl>
        {faq.map((f) => (
          <div class="c-faq-item">
            <dt>{f.q}</dt>
            <dd>{f.a}</dd>
          </div>
        ))}
      </dl>
    </section>
  </main>

  <div class="c-toast" id="toast" hidden></div>
</BaseLayout>

<style is:global>
  :root {
    --c-bg: #fbfaf5;
    --c-fg: #1a1611;
    --c-muted: #6b6359;
    --c-line: #e5dfd0;
    --c-card: #ffffff;
    --c-accent: #3a5b8c;
    --c-accent-soft: #d8e2ee;
    --c-ok: #3f7d52;
    --c-bad: #b0492f;
  }
  :root[data-theme="dark"] {
    --c-bg: #0e0c08;
    --c-fg: #f1ece0;
    --c-muted: #9c9485;
    --c-line: #2a2620;
    --c-card: #16130d;
    --c-accent: #7ba5d4;
    --c-accent-soft: #1a232e;
    --c-ok: #7fb98e;
    --c-bad: #d98a72;
  }

  body { background: var(--c-bg); color: var(--c-fg); }
  .c-page { max-width: 760px; margin: 0 auto; padding: 0 24px 96px; }

  .c-topbar { border-bottom: 1px solid var(--c-line); padding: 18px 0; margin-bottom: 36px; }
  .c-topbar-inner { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .c-brand { display: flex; align-items: center; gap: 10px; }
  .c-brand-mark { display: inline-flex; padding: 6px; border-radius: 8px; background: var(--c-accent-soft); color: var(--c-accent); }
  .c-brand-name { font-family: "Fraunces", serif; font-weight: 500; font-size: 20px; letter-spacing: -0.01em; }

  .c-btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 9px 16px; border-radius: 999px; border: 1px solid var(--c-line);
    background: var(--c-card); color: var(--c-fg);
    font: inherit; font-size: 14px; font-weight: 500;
    cursor: pointer; transition: background .15s ease, border-color .15s ease, color .15s ease;
  }
  .c-btn:hover { border-color: var(--c-accent); color: var(--c-accent); }
  .c-btn-ghost { background: transparent; }

  .c-input-row { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 12px; }
  .c-field { display: flex; flex-direction: column; gap: 6px; flex: 1 1 320px; }
  .c-field-label { font-size: 12px; color: var(--c-muted); font-weight: 500; }
  .c-field input {
    font: inherit; font-family: "JetBrains Mono", monospace; font-size: 15px;
    padding: 12px 14px; border-radius: 10px;
    border: 1px solid var(--c-line); background: var(--c-card); color: var(--c-fg);
    outline: none;
  }
  .c-field input:focus { border-color: var(--c-accent); }
  .c-input-aux { display: flex; align-items: center; gap: 10px; }
  .c-picker { display: inline-flex; }
  .c-picker input[type="color"] {
    inline-size: 46px; block-size: 46px; padding: 0; border: 1px solid var(--c-line);
    border-radius: 10px; background: var(--c-card); cursor: pointer;
  }
  .c-picker input[type="color"]::-webkit-color-swatch-wrapper { padding: 4px; }
  .c-picker input[type="color"]::-webkit-color-swatch { border: none; border-radius: 6px; }

  .c-result { margin-top: 28px; display: grid; grid-template-columns: 180px 1fr; gap: 18px; }
  .c-swatch {
    border-radius: 14px; border: 1px solid var(--c-line); min-height: 160px;
    display: flex; align-items: center; justify-content: center;
    background: var(--c-card);
  }
  .c-swatch.invalid { background: var(--c-card); }
  .c-swatch-sample { font-family: "Fraunces", serif; font-size: 40px; font-weight: 500; line-height: 1; }

  .c-formats { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; align-content: start; }
  .c-fmt {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    background: var(--c-card); border: 1px solid var(--c-line); border-radius: 12px;
    padding: 11px 14px; cursor: pointer; transition: border-color .15s ease;
  }
  .c-fmt:hover { border-color: var(--c-accent); }
  .c-fmt-key { flex: none; font-size: 11px; font-weight: 600; letter-spacing: .04em; color: var(--c-accent); background: var(--c-accent-soft); padding: 3px 8px; border-radius: 999px; }
  .c-fmt code { font-family: "JetBrains Mono", monospace; font-size: 14px; word-break: break-all; text-align: right; }
  .c-formats .c-fmt-bad { color: var(--c-bad); cursor: default; }
  .c-formats .c-fmt-bad:hover { border-color: var(--c-bad); }

  .c-contrast { margin-top: 48px; }
  .c-contrast h2, .c-why h2, .c-faq h2 { font-family: "Fraunces", serif; font-weight: 400; font-size: 28px; margin: 0 0 12px; letter-spacing: -0.01em; }
  .c-contrast-note { font-size: 14px; color: var(--c-muted); line-height: 1.55; margin: 0 0 18px; max-width: 64ch; }
  .c-contrast-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .c-cc-card { border: 1px solid var(--c-line); border-radius: 14px; overflow: hidden; }
  .c-cc-preview { padding: 20px 16px; font-size: 18px; font-weight: 600; text-align: center; }
  .c-cc-body { padding: 14px 16px; background: var(--c-card); }
  .c-cc-ratio { font-family: "JetBrains Mono", monospace; font-size: 22px; font-weight: 600; }
  .c-cc-on { font-size: 12px; color: var(--c-muted); margin: 2px 0 12px; }
  .c-cc-badges { display: flex; flex-wrap: wrap; gap: 6px; }
  .c-badge { font-size: 11px; font-weight: 600; letter-spacing: .03em; padding: 3px 9px; border-radius: 999px; border: 1px solid var(--c-line); }
  .c-badge.pass { color: var(--c-ok); border-color: var(--c-ok); }
  .c-badge.fail { color: var(--c-muted); opacity: .6; }

  .c-why { margin-top: 64px; }
  .c-why p { font-size: 16px; line-height: 1.6; color: var(--c-fg); max-width: 64ch; margin: 0; }

  .c-faq { margin-top: 56px; }
  .c-faq dl { display: grid; gap: 18px; margin: 0; }
  .c-faq-item { background: var(--c-card); border: 1px solid var(--c-line); border-radius: 14px; padding: 16px 20px; }
  .c-faq-item dt { font-weight: 600; margin: 0 0 6px; }
  .c-faq-item dd { color: var(--c-muted); line-height: 1.55; margin: 0; }

  .c-toast {
    position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%);
    background: var(--c-fg); color: var(--c-bg);
    padding: 10px 18px; border-radius: 999px; font-size: 14px;
    box-shadow: 0 4px 16px rgba(0,0,0,.18); z-index: 60;
  }
  .c-toast[hidden] { display: none !important; }

  @media (max-width: 560px) {
    .c-result { grid-template-columns: 1fr; }
    .c-swatch { min-height: 120px; }
    .c-contrast-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  // ---- parse via the browser's own CSS color engine -----------------------
  // Double-sentinel trick: an invalid string leaves fillStyle at the sentinel,
  // and the two sentinels disagree, so we can detect failure without a network.
  function parseCss(input: string): { r: number; g: number; b: number; a: number } | null {
    const raw = input.trim();
    if (raw === "") return null;
    const ctx = document.createElement("canvas").getContext("2d");
    if (!ctx) return null;
    ctx.fillStyle = "#000";
    ctx.fillStyle = raw;
    const first = ctx.fillStyle;
    ctx.fillStyle = "#fff";
    ctx.fillStyle = raw;
    const second = ctx.fillStyle;
    if (first !== second) return null; // invalid: each sentinel survived
    const norm = first; // "#rrggbb" or "rgba(r, g, b, a)"
    if (norm.startsWith("#")) {
      return {
        r: parseInt(norm.slice(1, 3), 16),
        g: parseInt(norm.slice(3, 5), 16),
        b: parseInt(norm.slice(5, 7), 16),
        a: 1,
      };
    }
    const m = norm.match(/rgba?\(([^)]+)\)/);
    if (!m) return null;
    const parts = m[1].split(",").map((s) => parseFloat(s.trim()));
    return { r: parts[0], g: parts[1], b: parts[2], a: parts.length > 3 ? parts[3] : 1 };
  }

  // ---- format conversions -------------------------------------------------
  function toHex(r: number, g: number, b: number, a: number): string {
    const h = (n: number) => Math.round(n).toString(16).padStart(2, "0");
    const base = "#" + h(r) + h(g) + h(b);
    if (a < 1) return base + h(Math.round(a * 255));
    return base;
  }

  function toRgb(r: number, g: number, b: number, a: number): string {
    const R = Math.round(r), G = Math.round(g), B = Math.round(b);
    if (a < 1) return `rgb(${R} ${G} ${B} / ${round(a, 2)})`;
    return `rgb(${R} ${G} ${B})`;
  }

  function toHsl(r: number, g: number, b: number, a: number): string {
    const rn = r / 255, gn = g / 255, bn = b / 255;
    const max = Math.max(rn, gn, bn), min = Math.min(rn, gn, bn);
    const l = (max + min) / 2;
    let h = 0, s = 0;
    const d = max - min;
    if (d !== 0) {
      s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
      if (max === rn) h = ((gn - bn) / d) % 6;
      else if (max === gn) h = (bn - rn) / d + 2;
      else h = (rn - gn) / d + 4;
      h *= 60;
      if (h < 0) h += 360;
    }
    const H = Math.round(h), S = Math.round(s * 100), L = Math.round(l * 100);
    if (a < 1) return `hsl(${H} ${S}% ${L}% / ${round(a, 2)})`;
    return `hsl(${H} ${S}% ${L}%)`;
  }

  // sRGB channel (0-255) -> linear-light (0-1)
  function linearize(c255: number): number {
    const c = c255 / 255;
    return c <= 0.04045 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);
  }

  // sRGB -> OKLCH (Björn Ottosson)
  function toOklch(r: number, g: number, b: number, a: number): string {
    const lr = linearize(r), lg = linearize(g), lb = linearize(b);
    const l = 0.4122214708 * lr + 0.5363325363 * lg + 0.0514459929 * lb;
    const m = 0.2119034982 * lr + 0.6806995451 * lg + 0.1073969566 * lb;
    const s = 0.0883024619 * lr + 0.2817188376 * lg + 0.6299787005 * lb;
    const l_ = Math.cbrt(l), m_ = Math.cbrt(m), s_ = Math.cbrt(s);
    const L = 0.2104542553 * l_ + 0.793617785 * m_ - 0.0040720468 * s_;
    const aa = 1.9779984951 * l_ - 2.428592205 * m_ + 0.4505937099 * s_;
    const bb = 0.0259040371 * l_ + 0.7827717662 * m_ - 0.808675766 * s_;
    const C = Math.sqrt(aa * aa + bb * bb);
    let H = (Math.atan2(bb, aa) * 180) / Math.PI;
    if (H < 0) H += 360;
    const Lp = round(L * 100, 1);
    const Cp = round(C, 3);
    const Hp = C < 0.0001 ? 0 : round(H, 1);
    if (a < 1) return `oklch(${Lp}% ${Cp} ${Hp} / ${round(a, 2)})`;
    return `oklch(${Lp}% ${Cp} ${Hp})`;
  }

  function round(n: number, d: number): number {
    const f = Math.pow(10, d);
    return Math.round(n * f) / f;
  }

  // WCAG relative luminance from sRGB 0-255
  function luminance(r: number, g: number, b: number): number {
    return 0.2126 * linearize(r) + 0.7152 * linearize(g) + 0.0722 * linearize(b);
  }

  function contrast(lA: number, lB: number): number {
    const hi = Math.max(lA, lB), lo = Math.min(lA, lB);
    return (hi + 0.05) / (lo + 0.05);
  }

  // ---- DOM ----------------------------------------------------------------
  function toast(msg: string): void {
    const el = document.getElementById("toast");
    if (!el) return;
    el.textContent = msg;
    el.hidden = false;
    window.clearTimeout((el as any)._t);
    (el as any)._t = window.setTimeout(() => { el.hidden = true; }, 1600);
  }

  function copy(text: string): void {
    navigator.clipboard?.writeText(text).then(
      () => toast("Copied " + text),
      () => toast("Copy failed"),
    );
  }

  let current = "#3a5b8c";

  function render(input: string): void {
    const formats = document.getElementById("c-formats");
    const swatch = document.getElementById("c-swatch");
    const sample = document.getElementById("c-sample-text");
    const contrastSec = document.getElementById("c-contrast");
    const grid = document.getElementById("c-contrast-grid");
    const picker = document.getElementById("color-picker") as HTMLInputElement | null;
    if (!formats || !swatch || !sample || !contrastSec || !grid) return;

    const parsed = parseCss(input);
    if (!parsed) {
      swatch.classList.add("invalid");
      (swatch as HTMLElement).style.background = "";
      sample.style.color = "var(--c-muted)";
      sample.textContent = "?";
      formats.innerHTML =
        '<li class="c-fmt c-fmt-bad"><span class="c-fmt-key">—</span>' +
        '<code>Not a color the browser recognizes</code></li>';
      contrastSec.hidden = true;
      return;
    }

    const { r, g, b, a } = parsed;
    const hex = toHex(r, g, b, a);
    const rgb = toRgb(r, g, b, a);
    const hsl = toHsl(r, g, b, a);
    const oklch = toOklch(r, g, b, a);

    // swatch
    swatch.classList.remove("invalid");
    (swatch as HTMLElement).style.background = a < 1 ? `rgba(${r},${g},${b},${a})` : hex;
    const lum = luminance(r, g, b);
    sample.style.color = lum > 0.4 ? "#000" : "#fff";
    sample.textContent = "Aa";

    // formats
    const rows: [string, string][] = [
      ["HEX", hex],
      ["RGB", rgb],
      ["HSL", hsl],
      ["OKLCH", oklch],
    ];
    formats.innerHTML = "";
    for (const [key, val] of rows) {
      const li = document.createElement("li");
      li.className = "c-fmt";
      li.innerHTML =
        `<span class="c-fmt-key">${key}</span><code>${esc(val)}</code>`;
      li.addEventListener("click", () => copy(val));
      formats.appendChild(li);
    }

    // contrast vs white and black
    const lWhite = 1, lBlack = 0;
    const cWhite = contrast(lum, lWhite);
    const cBlack = contrast(lum, lBlack);
    grid.innerHTML =
      contrastCard("On white", "#ffffff", "#000000-ignored", hex, cWhite, r, g, b) +
      contrastCard("On black", "#000000", "#ffffff-ignored", hex, cBlack, r, g, b);
    contrastSec.hidden = false;

    // sync picker (only for opaque, fully-specified colors)
    if (picker) picker.value = "#" + toHex(r, g, b, 1).slice(1, 7);

    current = hex;
  }

  function contrastCard(
    label: string,
    bg: string,
    _fg: string,
    fgColor: string,
    ratio: number,
    r: number,
    g: number,
    b: number,
  ): string {
    const text = `rgb(${Math.round(r)} ${Math.round(g)} ${Math.round(b)})`;
    const ratioStr = round(ratio, 2).toFixed(2) + ":1";
    const badge = (name: string, pass: boolean) =>
      `<span class="c-badge ${pass ? "pass" : "fail"}">${name} ${pass ? "\u2713" : "\u2717"}</span>`;
    const badges =
      badge("AA", ratio >= 4.5) +
      badge("AA Large", ratio >= 3) +
      badge("AAA", ratio >= 7) +
      badge("AAA Large", ratio >= 4.5);
    return (
      `<div class="c-cc-card">` +
      `<div class="c-cc-preview" style="background:${bg};color:${text}">The quick brown fox</div>` +
      `<div class="c-cc-body">` +
      `<div class="c-cc-ratio">${ratioStr}</div>` +
      `<div class="c-cc-on">${label}</div>` +
      `<div class="c-cc-badges">${badges}</div>` +
      `</div></div>`
    );
  }

  function esc(s: string): string {
    return s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c] as string));
  }

  function setColor(value: string, updateInput: boolean): void {
    const input = document.getElementById("color-input") as HTMLInputElement | null;
    if (updateInput && input) input.value = value;
    render(value);
    const parsed = parseCss(value);
    if (parsed) {
      const hex = toHex(parsed.r, parsed.g, parsed.b, 1).slice(0, 7);
      history.replaceState(null, "", "#" + hex.slice(1));
    }
  }

  function randomColor(): void {
    const n = Math.floor(Math.random() * 0x1000000);
    const hex = "#" + n.toString(16).padStart(6, "0");
    setColor(hex, true);
  }

  function shareLink(): void {
    const parsed = parseCss(current);
    const hash = parsed ? "#" + toHex(parsed.r, parsed.g, parsed.b, 1).slice(1, 7) : "";
    const url = "https://truffleagent.com/color/" + hash;
    if (navigator.share) {
      navigator.share({ title: "Color", url }).catch(() => {});
    } else {
      navigator.clipboard?.writeText(url).then(() => toast("Link copied"), () => toast("Copy failed"));
    }
  }

  function init(): void {
    const input = document.getElementById("color-input") as HTMLInputElement | null;
    const picker = document.getElementById("color-picker") as HTMLInputElement | null;
    input?.addEventListener("input", () => setColor(input.value, false));
    picker?.addEventListener("input", () => setColor(picker.value, true));
    document.getElementById("random-btn")?.addEventListener("click", randomColor);
    document.getElementById("share-btn")?.addEventListener("click", shareLink);

    const fromHash = (): string | null => {
      const h = location.hash.replace(/^#/, "").trim();
      return /^[0-9a-fA-F]{3}$|^[0-9a-fA-F]{6}$|^[0-9a-fA-F]{8}$/.test(h) ? "#" + h : null;
    };

    // back/forward through shared links should repaint (replaceState does not fire this)
    window.addEventListener("hashchange", () => {
      const c = fromHash();
      if (c) setColor(c, true);
    });

    // initial color: URL hash if it is a valid hex, else the default
    setColor(fromHash() ?? "#3a5b8c", true);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>
