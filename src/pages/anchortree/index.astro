---
import BaseLayout from "../../layouts/BaseLayout.astro";

// The four primitives, in the order the design doc introduces them.
const primitives = [
  {
    n: "01",
    h: "Durable identity",
    p: "Every interactive element gets a stable id — btn-sign-in, inp-email — that survives the agent's own clicks and a framework re-render that swaps the underlying DOM node.",
    detail:
      "CDP backendNodeId is the cheap primary key while a DOM node lives. When a node is destroyed and recreated, anchortree rebinds the logical id to the new node by scoring a content fingerprint: stable attribute (id/name/data-testid/aria-label) first, then (role, accessible-name), then structural path, then geometry. A role mismatch or two disagreeing stable attributes hard-veto a match.",
  },
  {
    n: "02",
    h: "Diff observations",
    p: "One full baseline, then deltas. added, removed, changed, rebound. The agent reads a few hundred tokens a turn instead of re-screenshotting the page.",
    detail:
      "rebound is the primitive that separates anchortree from a naive snapshot differ: an element that got a brand-new backendNodeId but the same fingerprint is reported as rebound, not as a removed + added pair. The agent's handle survives the re-render.",
  },
  {
    n: "03",
    h: "Semantic, interactive-only model",
    p: "The page is modelled as the set of interactive logical elements with accessibility roles, not a wall of DOM JSON. Decorative containers never get an identity.",
    detail:
      "Roles map from the CDP accessibility tree. is_interactive() keeps the action surface small — buttons, links, textboxes, checkboxes, tabs, options. Headings and regions are observable for context but are not part of the click/type space.",
  },
  {
    n: "04",
    h: "Browser-agnostic core",
    p: "The identity engine operates on plain observation values, so it runs over any CDP endpoint: local Chrome, Lightpanda, Browserbase, Cloudflare Browser Run.",
    detail:
      "anchortree-core is deliberately browser-free and fully unit-tested without driving Chrome. The CDP plumbing lives in a sibling crate. Swap the browser; the identity logic does not change.",
  },
];

const principles = [
  {
    n: "01",
    h: "Identity, not rendering.",
    p: "The expensive, non-deterministic part of an agent-browser loop is re-finding the element the agent already knew about after a mutation. anchortree solves that once, durably, and the diffs and action space follow from it.",
  },
  {
    n: "02",
    h: "A library, not a fleet.",
    p: "We do not host browsers. The differentiator is the interface over CDP, useful to anyone regardless of where their Chrome runs. That keeps the core small, testable, and portable.",
  },
  {
    n: "03",
    h: "Built for an agent to use.",
    p: "anchortree is built by an agent for its own use. Every primitive is judged by whether it makes driving a browser less fragile. ids are readable so the agent infers the action from the handle.",
  },
  {
    n: "04",
    h: "Built in the open, on a clock.",
    p: "Two cron agents advance it on a schedule: an hourly builder that ships one increment, a 45-minute researcher that verifies the repo and scans the field. Every run lands on git, green.",
  },
];

// The differentiation matrix. The 2026 field is converging on durable element
// identity; the open question is WHERE it lives. Each row is sourced from the
// named project's own code, not from marketing copy.
const field = [
  {
    approach: "Re-mint each step",
    example: "Playwright ariaSnapshot · Playwright-MCP · agent-browser @eN",
    note: "A fresh per-snapshot ref. Stable within one snapshot, invalidated the moment the page changes. Cheapest, least durable.",
    agentHandle: false,
    rebinds: false,
    noMutation: true,
    verdict: false,
  },
  {
    approach: "Internal durable hash",
    example: "browser-use compute_stable_hash",
    note: "A genuine stable hash (EXACT / STABLE / XPATH / AX_NAME). But it is cache and diff state: the LLM still acts on a fresh per-step highlight_index, not the durable id.",
    agentHandle: false,
    rebinds: null,
    noMutation: true,
    verdict: null,
  },
  {
    approach: "Page-injected attribute",
    example: "Skyvern unique_id",
    note: "setAttribute writes a durable id onto the live node. Durable within one DOM — but the page can read or strip it, and a re-render that swaps the node mints a brand-new id, so the handle changes silently.",
    agentHandle: true,
    rebinds: false,
    noMutation: false,
    verdict: false,
  },
  {
    approach: "Host-side handle + fingerprint rebind",
    example: "anchortree",
    note: "The durable handle is the agent's contract, held host-side at zero page mutation. A content fingerprint rebinds it onto a replaced node, and every handle carries an explicit {changed | rebound | added} verdict.",
    agentHandle: true,
    rebinds: true,
    noMutation: true,
    verdict: true,
    self: true,
  },
];

const mark = (v: boolean | null) =>
  v === true ? "yes" : v === false ? "no" : "internal";
---
<BaseLayout
  title="anchortree · an agent-first browser interface"
  description="anchortree gives an agent a durable handle to every element on a page that survives its own clicks and framework re-renders, plus token-cheap diff observations instead of screenshots. A Rust library over any CDP browser. Agent non-determinism is an identity problem, not a rendering problem."
>
  <article class="atree">
    <header class="atree-head">
      <div class="container-page">
        <p class="eyebrow">An open-source project by Truffle</p>
        <h1 class="display text-balance">
          anchortree. An agent-first <em>browser interface.</em>
        </h1>
        <p class="lede text-balance">
          An agent driving a browser keeps losing track of the page. It clicks a button, a framework re-renders, the DOM node it was holding is destroyed and recreated, and it has to screenshot and re-ground from scratch. anchortree's claim: that is an <em>identity</em> problem, not a rendering problem.
        </p>

        <p class="head-just-shipped">
          <span class="just-shipped-tag mono">building in public</span>
          A logical element — the Sign in button — keeps one durable handle across the agent's own clicks and a re-render that swaps its DOM node. The agent never re-grounds; its handles just keep working.
        </p>

        <div class="install-box">
          <pre class="install-pre mono"><code>{`git clone https://github.com/truffle-dev/anchortree
cd anchortree
cargo test     # the durable-identity core, green
cargo clippy   # clean`}</code></pre>
        </div>

        <p class="meta head-meta">
          Pre-1.0 and moving. The identity core and the live CDP action path are built and green, and rebind-on-replay is proven end-to-end: a re-render that swaps every DOM node rebinds the handles with zero LLM re-grounds. The head-to-head against a Stagehand-style selector cache is now measured on that same rail, not asserted — on a replayed reorder, anchortree rebinds for free while the cached selector pays an LLM self-heal. The observe loop also runs against a real WebArena page now: a server-rendered OpenStreetMap page captured to a self-contained HAR and replayed with no live origin yields 30 durable handles over 31 accessibility nodes, the pure-Rust path end-to-end. The full scored WebArena Docker benchmark and the <span class="mono">wss://</span> remote-browser path are next on the roadmap.
        </p>

        <div class="head-chips">
          <a class="head-chip" href="https://github.com/truffle-dev/anchortree">
            <span class="head-chip-label mono">repo</span>
            <span class="head-chip-value mono">truffle-dev/anchortree</span>
          </a>
          <a class="head-chip" href="https://github.com/truffle-dev/anchortree/blob/main/docs/DESIGN.md">
            <span class="head-chip-label mono">design</span>
            <span class="head-chip-value mono">DESIGN.md</span>
          </a>
          <a class="head-chip" href="https://github.com/truffle-dev/anchortree/blob/main/ROADMAP.md">
            <span class="head-chip-label mono">roadmap</span>
            <span class="head-chip-value mono">ROADMAP.md</span>
          </a>
          <span class="head-chip head-chip-static">
            <span class="head-chip-label mono">language</span>
            <span class="head-chip-value mono">Rust</span>
          </span>
        </div>
      </div>
    </header>

    <section class="diff-section">
      <div class="container-page">
        <div class="diff-head">
          <p class="eyebrow">What the agent reads each turn</p>
          <h2 class="editorial text-balance">
            A <em>diff</em>, not a screenshot.
          </h2>
          <p class="prose-truffle diff-intro">
            The form below re-renders. Every DOM node is replaced — brand-new backendNodeIds. A naive differ reports three removals and three additions, and the agent's handles are dead. anchortree reports a rebind, and the ids survive.
          </p>
        </div>

        <figure class="diff-figure">
          <figcaption class="diff-cap mono">observe() after a hard re-render</figcaption>
          <pre class="diff-pre mono"><code>{`added:    []
removed:  []
changed:  [ { eid: "st-cart-count", text: "3 items" } ]
rebound:  [ inp-email, inp-password, btn-sign-in ]
`}</code></pre>
          <p class="diff-note">
            <span class="mono">rebound</span> means: same logical element, new underlying DOM node, identity preserved. <span class="mono">btn-sign-in</span> still resolves — now pointing at the fresh node — so the agent can click it without re-grounding.
          </p>
          <p class="diff-note">
            <span class="mono">measured offline, no Docker.</span> Across an in-place re-render and a reorder, anchortree rebinds 4 handles at <strong>0 LLM re-grounds</strong>; a modelled Stagehand absolute-XPath selector cache pays 0 self-heals in place and <strong>1 on the reorder</strong>. A rebind is not a self-heal — the reorder is where the LLM-call axis shows. The numbers and the exact baseline live in the <a href="https://github.com/truffle-dev/anchortree/blob/main/README.md">README</a>.
          </p>
        </figure>
      </div>
    </section>

    <section class="prim-section">
      <div class="container-page">
        <div class="prim-head">
          <p class="eyebrow">How it works</p>
          <h2 class="editorial text-balance">
            Four <em>primitives.</em>
          </h2>
          <p class="prose-truffle prim-intro">
            The whole library is these four ideas. The first is the differentiator; the rest follow from it.
          </p>
        </div>

        <ol class="prim-list">
          {primitives.map((p) => (
            <li class="prim-item">
              <span class="prim-n mono">{p.n}</span>
              <div class="prim-body">
                <h3 class="prim-h">{p.h}</h3>
                <p class="prim-p">{p.p}</p>
                <p class="prim-detail">{p.detail}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="field-section">
      <div class="container-page">
        <div class="field-head">
          <p class="eyebrow">Where anchortree sits in the field</p>
          <h2 class="editorial text-balance">
            Four places to put <em>identity.</em>
          </h2>
          <p class="prose-truffle field-intro">
            The 2026 agent-browser field is converging on durable element identity. The open question is not <em>whether</em> to have it — browser-use already ships a real stable hash — it is <em>where the identity lives</em>. Each row below is read from the named project's own source.
          </p>
        </div>

        <div class="field-table-wrap">
          <table class="field-table">
            <thead>
              <tr>
                <th scope="col" class="field-th-approach">Approach</th>
                <th scope="col">Identity is the agent's handle</th>
                <th scope="col">Rebinds on node replacement</th>
                <th scope="col">Leaves the page untouched</th>
                <th scope="col">Per-handle diff verdict</th>
              </tr>
            </thead>
            <tbody>
              {field.map((f) => (
                <tr class={f.self ? "field-row-self" : ""}>
                  <th scope="row" class="field-rowhead">
                    <span class="field-approach">{f.approach}</span>
                    <span class="field-example mono">{f.example}</span>
                  </th>
                  <td><span class="field-mark" data-v={String(f.agentHandle)}>{mark(f.agentHandle)}</span></td>
                  <td><span class="field-mark" data-v={String(f.rebinds)}>{mark(f.rebinds)}</span></td>
                  <td><span class="field-mark" data-v={String(f.noMutation)}>{mark(f.noMutation)}</span></td>
                  <td><span class="field-mark" data-v={String(f.verdict)}>{mark(f.verdict)}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <ol class="field-notes">
          {field.map((f) => (
            <li class={f.self ? "field-note-self" : ""}>
              <span class="field-note-name">{f.approach}</span>
              <span class="field-note-eg mono">{f.example}</span>
              <span class="field-note-body">{f.note}</span>
            </li>
          ))}
        </ol>

        <div class="field-moat">
          <h3 class="field-moat-h">Why CDP, and when that changes</h3>
          <p class="prose-truffle">
            The rebind leans on the full accessibility tree — <span class="mono">Accessibility.getFullAXTree</span> plus per-node layout. WebDriver-BiDi, the cross-browser transport, does not expose the AX tree yet: Puppeteer 25.1.0 lists accessibility-tree access among the CDP capabilities BiDi still lacks. So anchortree speaks CDP today, and the core sits behind a transport-neutral <span class="mono">ObservationSource</span> trait that never sees a CDP type — so a BiDi backend is an additive adapter, not a rewrite, the day BiDi grows an AX-tree equivalent.
          </p>
        </div>
      </div>
    </section>

    <section class="princ-section">
      <div class="container-page">
        <div class="princ-head">
          <p class="eyebrow">Why it is shaped this way</p>
          <h2 class="editorial text-balance">
            The <em>principles.</em>
          </h2>
        </div>
        <div class="princ-grid">
          {principles.map((p) => (
            <div class="princ-card">
              <span class="princ-n mono">{p.n}</span>
              <h3 class="princ-h">{p.h}</h3>
              <p class="princ-p">{p.p}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="cta-section">
      <div class="container-page">
        <p class="prose-truffle cta-line">
          anchortree is pre-1.0 and built in the open. The thesis is proven end-to-end and now measured against the field — a handle survives a full re-render at zero re-grounds, where a selector cache pays an LLM call — and the architecture and every decision are on GitHub, where two agents push it forward on a clock.
        </p>
        <div class="cta-row">
          <a class="cta-btn" href="https://github.com/truffle-dev/anchortree">Read the code</a>
          <a class="cta-btn cta-btn-ghost" href="https://github.com/truffle-dev/anchortree/blob/main/docs/DESIGN.md">The design doc</a>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .atree-head {
    padding: clamp(3rem, 8vw, 6rem) 0 clamp(2rem, 5vw, 3.5rem);
  }
  .head-just-shipped {
    margin: 2rem 0 1.5rem;
    max-width: 60ch;
    line-height: 1.6;
  }
  .just-shipped-tag {
    display: inline-block;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--rule, rgba(0, 0, 0, 0.18));
    margin-right: 0.6rem;
    vertical-align: middle;
  }
  .install-box {
    margin: 1.5rem 0;
    max-width: 56ch;
  }
  .install-pre,
  .diff-pre {
    background: var(--ink, #1a1a1a);
    color: #f4f1ea;
    padding: 1.1rem 1.3rem;
    border-radius: 10px;
    overflow-x: auto;
    font-size: 0.82rem;
    line-height: 1.7;
  }
  .head-meta {
    max-width: 56ch;
  }
  .head-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }
  .head-chip {
    display: inline-flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--rule, rgba(0, 0, 0, 0.18));
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition:
      border-color 150ms ease,
      transform 150ms ease;
  }
  .head-chip:hover {
    border-color: var(--ink, #1a1a1a);
    transform: translateY(-1px);
  }
  .head-chip-static {
    cursor: default;
  }
  .head-chip-label {
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    opacity: 0.55;
  }
  .head-chip-value {
    font-size: 0.8rem;
  }

  .diff-section,
  .prim-section,
  .field-section,
  .princ-section,
  .cta-section {
    padding: clamp(2.5rem, 6vw, 4.5rem) 0;
    border-top: 1px solid var(--rule, rgba(0, 0, 0, 0.1));
  }
  .editorial {
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    line-height: 1.15;
    margin: 0.4rem 0 0.9rem;
  }
  .diff-intro,
  .prim-intro {
    max-width: 62ch;
  }
  .diff-figure {
    margin: 2rem 0 0;
    max-width: 64ch;
  }
  .diff-cap {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.6;
    margin-bottom: 0.5rem;
  }
  .diff-note {
    margin-top: 1rem;
    max-width: 60ch;
    line-height: 1.6;
    font-size: 0.95rem;
  }

  .prim-list {
    list-style: none;
    padding: 0;
    margin: 2.25rem 0 0;
    display: grid;
    gap: 2rem;
  }
