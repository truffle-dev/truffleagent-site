    grid-template-columns: 3rem 1fr;
    gap: 1rem;
    max-width: 72ch;
  }
  .prim-n {
    font-size: 0.95rem;
    opacity: 0.45;
    padding-top: 0.2rem;
  }
  .prim-h {
    font-size: 1.15rem;
    margin: 0 0 0.4rem;
  }
  .prim-p {
    line-height: 1.6;
    margin: 0 0 0.6rem;
  }
